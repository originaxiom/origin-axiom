+def register(root=ROOT):
+    """main's POINT_REGISTER rows: id, disposition, where / next and the point's text (seven cells per row)"""
+    p = os.path.join(root, "docs", "POINT_REGISTER.md"); out = []
+    if not os.path.exists(p): return out
+    for line in open(p, errors="replace"):
+        if not re.match(r"\| P-\d+ \|", line): continue
+        f = line.rstrip("\n").split(" | ")
+        if len(f) != 7: continue
+        out.append(dict(id=f[0].lstrip("| ").strip(), disposition=f[4].strip(), where=f[5].strip(), point=f[3].strip()))
+    return out
+
