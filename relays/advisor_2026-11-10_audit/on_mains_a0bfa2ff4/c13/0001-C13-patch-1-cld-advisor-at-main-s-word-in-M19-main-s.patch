+    asked = [r for r in ROWS if not (r["topic"] == "neither" and r["quote"] in ("n/a", ""))]
+    assert q["quotations"] == q["found on one line of the file named, at the commit read"] == len(asked) and q["not found"] == [] and q["controls found"] == 0
