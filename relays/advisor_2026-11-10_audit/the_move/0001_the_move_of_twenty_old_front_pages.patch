+"""A page that was moved is where the table says (the move of the old front pages; the owner approved it to main on
+2026-11-12, register row P-825; built by the advisor seat at main's word, outside its five packages).
+
+Twenty pages that face a first reader were moved into docs/retired/, each a pure rename.  No page that is kept was
+edited but for one row of the front page.  docs/MOVED.md is the one record: where each page was, where it is, what it
+is, and what stands in its place.  A citation of an old place is left as it was written and read through that table,
+so the table is held by the gate that reads it: each page it names is where the table says; every page in the folder
+has its row; no old place is taken again by a file.
+
+Each test makes the situation in a small repository of its own and runs the path checker there."""
+import importlib.util
+import json
+import pathlib
+import subprocess
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+HEAD = "# A page you were sent to is not where it was\n\n| where it was | where it is | what it is | what stands in its place now |\n|---|---|---|---|\n"
+ROW = "| `%s` | `%s` | a plan of an earlier year | nothing: a dated record |\n"
+
+
+def _checker(root):
+    spec = importlib.util.spec_from_file_location("path_checker_for_the_moved_pages", ROOT / "scripts" / "checks" / "check_path_references.py")
+    c = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(c)
+    c.ROOT = str(root)
+    return c
+
+
+def _gates():
+    spec = importlib.util.spec_from_file_location("gates_for_the_moved_pages", ROOT / "scripts" / "gates" / "gates.py")
+    g = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(g)
+    return g
+
+
+def _git(repo, *a):
+    r = subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid", *a], capture_output=True, text=True)
+    assert r.returncode == 0, r.stderr
+    return r.stdout.strip()
+
+
+def _repo(tmp_path, files):
+    """a small repository that tracks `files`"""
+    repo = tmp_path / "repo"
+    for rel, text in files.items():
+        f = repo / rel
+        f.parent.mkdir(parents=True, exist_ok=True)
+        f.write_text(text, encoding="utf-8")
+    _git(repo, "init", "-q")
+    _git(repo, "add", "-A")
+    _git(repo, "commit", "-q", "-m", "a small repository")
+    return repo
+
+
+_MOVED = {"docs/retired/AN_OLD_PLAN.md": "# An old plan\n", "docs/MOVED.md": HEAD + ROW % ("docs/AN_OLD_PLAN.md", "docs/retired/AN_OLD_PLAN.md"),
+          "docs/A_PAGE.md": "# A page that is kept\n\nSee `docs/AN_OLD_PLAN.md` for the plan as it was.\n"}
+
+
+def _read(repo):
+    """(the citations that do not resolve, what is wrong with the table), as the checker in `repo` reads them"""
+    c = _checker(repo)
+    total, bad = c.scan()
+    table, wrong = getattr(c, "moved_pages", lambda: ({}, ["the path checker reads no table of moved pages"]))()
+    return bad, wrong
+
+
+def test_a_citation_of_an_old_place_is_read_through_the_table(tmp_path):
+    bad, wrong = _read(_repo(tmp_path / "moved", _MOVED))
+    assert bad == [] and wrong == [], "a kept page cites a moved page by its old place, the table says where it went, and the checker reads: %r %r" % (bad, wrong)
+    # the control: a place that never was is not excused by the table
+    bad, wrong = _read(_repo(tmp_path / "never", dict(_MOVED, **{"docs/B_PAGE.md": "See `docs/A_PLAN_THAT_NEVER_WAS.md`.\n"})))
+    assert [t for _r, t in bad] == ["docs/A_PLAN_THAT_NEVER_WAS.md"] and wrong == [], (bad, wrong)
+    # and with no table and no folder the checker is as it was
+    bad, wrong = _read(_repo(tmp_path / "plain", {"docs/A_PAGE.md": "See `docs/B_PAGE.md`.\n", "docs/B_PAGE.md": "# B\n"}))
+    assert bad == [] and wrong == [], (bad, wrong)
+
+
+def test_a_row_whose_page_is_not_where_it_says_fails_the_gate(tmp_path):
+    files = dict(_MOVED, **{"docs/MOVED.md": HEAD + ROW % ("docs/AN_OLD_PLAN.md", "docs/retired/AN_OLD_PLAN.md") + ROW % ("docs/A_SECOND.md", "docs/retired/A_SECOND.md")})
+    bad, wrong = _read(_repo(tmp_path, files))
+    assert any("docs/retired/A_SECOND.md" in w and "not a tracked file" in w for w in wrong), wrong
+
+
+def test_a_page_in_the_folder_with_no_row_fails_the_gate(tmp_path):
+    bad, wrong = _read(_repo(tmp_path / "a", dict(_MOVED, **{"docs/retired/NO_ROW.md": "# moved, and written nowhere\n"})))
+    assert any("docs/retired/NO_ROW.md" in w and "no row" in w for w in wrong), wrong
+    # a folder of moved pages with no page that says where each was
+    files = {k: v for k, v in _MOVED.items() if k != "docs/MOVED.md" and k != "docs/A_PAGE.md"}
+    bad, wrong = _read(_repo(tmp_path / "b", files))
+    assert wrong and "docs/MOVED.md" in wrong[0], wrong
+
+
+def test_an_old_place_taken_again_by_a_file_fails_the_gate(tmp_path):
+    bad, wrong = _read(_repo(tmp_path, dict(_MOVED, **{"docs/AN_OLD_PLAN.md": "# A new page at the old place\n"})))
+    assert any("docs/AN_OLD_PLAN.md" in w and "taken again" in w for w in wrong), wrong
+
+
+def test_a_row_that_cannot_be_read_is_not_passed_over(tmp_path):
+    rows = {"a row with no backticks": "| docs/AN_OLD_PLAN.md | docs/retired/AN_OLD_PLAN.md | a plan | nothing |\n",
+            "a place twice on the left": ROW % ("docs/AN_OLD_PLAN.md", "docs/retired/AN_OLD_PLAN.md") * 2,
+            "two pages at one place": ROW % ("docs/AN_OLD_PLAN.md", "docs/retired/AN_OLD_PLAN.md") + ROW % ("docs/ANOTHER.md", "docs/retired/AN_OLD_PLAN.md"),
+            "a page moved on from where a row says another is": ROW % ("docs/AN_OLD_PLAN.md", "docs/retired/AN_OLD_PLAN.md") + ROW % ("docs/FIRST.md", "docs/AN_OLD_PLAN.md"),
+            "two tables": ROW % ("docs/AN_OLD_PLAN.md", "docs/retired/AN_OLD_PLAN.md") + "\n" + HEAD.split("\n\n", 1)[1]}
+    for n, (what, body) in enumerate(rows.items()):
+        bad, wrong = _read(_repo(tmp_path / str(n), dict(_MOVED, **{"docs/MOVED.md": HEAD + body})))
+        assert wrong and "reads no table" not in wrong[0], "%s, and the checker finds nothing wrong with the table: %r" % (what, wrong)
+
+
+def test_the_gate_fails_on_a_table_that_is_wrong(monkeypatch):
+    g = _gates()
+    assert g.GATES["path-refs"]()[0] is True
+    import check_path_references as cpr
+    table = cpr.moved_pages()[0] if hasattr(cpr, "moved_pages") else {}
+    monkeypatch.setattr(cpr, "moved_pages", lambda: (table, ["docs/retired/X.md stands in docs/retired/ and has no row in docs/MOVED.md"]), raising=False)
+    ok, detail = g.GATES["path-refs"]()
+    assert ok is False and "has no row" in detail, "the table of moved pages is wrong, and the gate on path citations reads: " + str(detail)
+    # and with the table taken away, every citation of an old place is unresolved again: the table is what they rest on
+    monkeypatch.setattr(cpr, "moved_pages", lambda: ({}, []), raising=False)
+    ok, detail = g.GATES["path-refs"]()
+    assert ok is False and "unresolved path citation" in detail, detail
+
+
+def test_a_moved_pages_ceiling_follows_it(tmp_path):
+    """the attribution baseline holds a ceiling for each file by its path.  A page at a new place is a new entry to the rule
+    that no ceiling rises without a recorded act; the table is the record, and the ceiling is read where the page is"""
+    g = _gates()
+    frozen = lambda counts: json.dumps({"_note": "a ratchet", "frozen": counts}) + "\n"
+    repo = _repo(tmp_path, {"docs/ATTRIBUTION_BASELINE.json": frozen({"docs/a.md": 2})})
+    anchor = _git(repo, "rev-parse", "HEAD")
+    load_small = lambda: json.loads((repo / "docs" / "ATTRIBUTION_BASELINE.json").read_text())["frozen"]
+    real = g._load_attr_baseline
+    g._load_attr_baseline = load_small
+    try:
+        (repo / "docs" / "ATTRIBUTION_BASELINE.json").write_text(frozen({"docs/retired/a.md": 2}))
+        moved = {"docs/a.md": "docs/retired/a.md"}
+        rise = lambda **kw: g.attribution_baseline_rise(anchor, repo, **kw)
+        assert "docs/retired/a.md 0 -> 2" in rise()[0]                                   # with no table, a rise from nothing
+        try:
+            followed = rise(moved=moved)
+        except TypeError:
+            followed = ("the rule of the ceiling does not read the table of moved pages", "")
+        assert followed == (None, ""), "a page was moved with its ceiling, and the rule reads: %r" % (followed,)
+        (repo / "docs" / "ATTRIBUTION_BASELINE.json").write_text(frozen({"docs/retired/a.md": 3}))
+        assert "docs/retired/a.md 2 -> 3" in rise(moved=moved)[0]                        # moved, and raised: still a rise
+    finally:
+        g._load_attr_baseline = real
+
+
+def test_on_this_repository_the_twenty_pages_are_where_the_table_says_and_no_byte_of_them_changed():
+    c = _checker(ROOT)
+    table, wrong = c.moved_pages()
+    assert wrong == [] and len(table) == 20, (len(table), wrong)
+    assert all(new == "docs/retired/" + old.rsplit("/", 1)[-1] for old, new in table.items())
+    # the commit that made the move: each page is, byte for byte, what stood at its old place in the commit before
+    move = _git(ROOT, "log", "--diff-filter=A", "--format=%H", "--", "docs/MOVED.md").split()[-1]
+    for old, new in table.items():
+        assert _git(ROOT, "rev-parse", "%s^:%s" % (move, old)) == _git(ROOT, "rev-parse", "%s:%s" % (move, new)), old
+    # one row of the front page leads to the record, and the gate says how many pages it reads through it
+    assert "(docs/MOVED.md)" in (ROOT / "README.md").read_text(encoding="utf-8")
+    g = _gates()
+    ok, detail = g.GATES["path-refs"]()
+    assert ok is True and "20 pages were moved and are read through docs/MOVED.md" in detail, detail
+    assert g.attribution_baseline_rise() == (None, "")
