+def moved_pages():
+    """where each moved page was -> where it is, from docs/MOVED.md (the path checker reads it); empty where it cannot be read.
+    A TABLE THAT IS KEYED BY A FILE FOLLOWS THE PAGE: a rule that holds a page by its path reads the old path as the new."""
+    sys.path.insert(0, os.path.join(ROOT, "scripts", "checks"))
+    try:
+        import check_path_references as cpr
+        return dict(cpr.moved_pages()[0])
+    except Exception:
+        return {}
+    finally:
+        sys.path.pop(0)
 
 
