index 3bf3bbb11..c7904e4a7 100644
--- a/scripts/checks/check_path_references.py
+++ b/scripts/checks/check_path_references.py
@@ -27,6 +27,12 @@ The other eleven were legitimate and are handled by rule, not by whitelist, wher
     correct; creating it here would be a forgery.
   - Paths containing '...' are prose elisions, not paths.
 
+  A PAGE THAT WAS MOVED IS WHERE IT WENT (2026-11-12; the owner approved the move of the old front pages, register row
+  P-825).  docs/MOVED.md is the one record of the move: a table of where each page was and where it is.  A citation of
+  an old place is left as it was written, in every page, and is read through that table.  The table is held here too,
+  since every such citation rests on it: each page it names is a tracked file where the table says; every page in
+  docs/retired/ has its row; no old place is taken again by a file; no place stands in it twice.
+
 Run:  python3 scripts/checks/check_path_references.py        (exit 1 if any unexplained)
 
 Lives under scripts/checks/, NOT scripts/audit/: .gitignore line 11 is a bare `audit/`,
@@ -77,10 +83,63 @@ EXEMPT_TARGETS = frozenset({
 })
 
 
+MOVED_PAGE = "docs/MOVED.md"
+MOVED_FOLDER = "docs/retired/"
+_MOVED_HEAD = re.compile(r"^\|\s*where it was\s*\|", re.I)
+_MOVED_ROW = re.compile(r"^\|\s*`([^`|]+)`\s*\|\s*`([^`|]+)`\s*\|")
+
+
+def moved_pages():
+    """(where each moved page was -> where it is, what is wrong with the table), read from the one page that records the
+    moves.  With no such page and no page in the folder, an empty table and nothing wrong."""
+    listed = subprocess.run(["git", "-C", ROOT, "ls-files"], capture_output=True, text=True, timeout=60)
+    tracked = set(listed.stdout.split("\n")) if listed.returncode == 0 else set()
+    in_folder = sorted(f for f in tracked if f.startswith(MOVED_FOLDER))
+    try:
+        lines = open(os.path.join(ROOT, MOVED_PAGE), encoding="utf-8").read().split("\n") if MOVED_PAGE in tracked else None
+    except OSError:
+        lines = None
+    if lines is None:
+        return {}, (["%d page(s) stand in %s, and %s, the page that says where each was, is not a tracked file that can be read"
+                     % (len(in_folder), MOVED_FOLDER, MOVED_PAGE)] if in_folder else [])
+    heads = [i for i, l in enumerate(lines) if _MOVED_HEAD.match(l)]
+    if len(heads) != 1:
+        return {}, ["%s holds %d tables that begin with the column 'where it was': it holds one" % (MOVED_PAGE, len(heads))]
+    table, problems = {}, []
+    for n, line in enumerate(lines[heads[0] + 1:], heads[0] + 2):
+        if not line.startswith("|"):
+            break                                                  # the table has ended
+        if re.match(r"^\|[\s:|-]+\|\s*$", line):
+            continue                                               # the rule under the header
+        m = _MOVED_ROW.match(line)
+        if not m:
+            problems.append("line %d of %s is a row of the table whose first two cells are not two paths in backticks" % (n, MOVED_PAGE))
+            continue
+        old, new = m.group(1).strip(), m.group(2).strip()
+        if old in table:
+            problems.append("%s stands twice in the table of %s as an old place" % (old, MOVED_PAGE))
+        table[old] = new
+    places = list(table.values())
+    for old, new in table.items():
+        if new not in tracked:
+            problems.append("%s says that %s is at %s, which is not a tracked file" % (MOVED_PAGE, old, new))
+        if old in tracked:
+            problems.append("%s, the old place of a page that was moved, is taken again by a file: a citation of it would name two pages" % old)
+        if new in table:
+            problems.append("%s says that %s is at %s, and that %s was moved on from there: a row says where the page is now" % (MOVED_PAGE, old, new, new))
+        if places.count(new) > 1:
+            problems.append("%s says that two pages are at %s" % (MOVED_PAGE, new))
+    for f in in_folder:
+        if f not in places:
+            problems.append("%s stands in %s and has no row in %s" % (f, MOVED_FOLDER, MOVED_PAGE))
+    return table, sorted(set(problems))
+
+
 def scan():
     out = subprocess.run(["git", "-C", ROOT, "ls-files", "*.md"],
                          capture_output=True, text=True, timeout=60).stdout
     unexplained, total = [], 0
+    moved = moved_pages()[0]
     for rel in out.split():
         if rel.startswith(EXEMPT_CITERS):
             continue
@@ -98,13 +157,22 @@ def scan():
             if os.path.exists(os.path.join(ROOT, target)) or \
                os.path.exists(os.path.join(citing_dir, target)):
                 continue
+            # a page that was moved is where it went: the citation is left as it was written, and read through the table
+            if target in moved and os.path.exists(os.path.join(ROOT, moved[target])):
+                continue
             unexplained.append((rel, target))
     return total, unexplained
 
 
 def main():
     total, bad = scan()
+    table, wrong = moved_pages()
     print(f"backticked repo-path citations checked: {total}")
+    print(f"pages that were moved, by {MOVED_PAGE}: {len(table)}")
+    for w in wrong:
+        print(f"  THE TABLE OF MOVED PAGES: {w}")
+    if wrong and not bad:
+        return 1
     if not bad:
         print("all resolve (repo-root or citing-file-relative)")
         return 0
