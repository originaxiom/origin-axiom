From 6d980042cacd41900e8cec47770368513a65c13c Mon Sep 17 00:00:00 2001
From: originaxiom <originaxiom@users.noreply.github.com>
Date: Thu, 12 Nov 2026 17:35:35 +0000
Subject: [PATCH 4/6] R80b, part 4, patch 4 (cld-advisor, at main's word in
 M14; Review 80, the second part of a reader's F12, checked by main on the
 pattern): A MESSAGE ENDS AT A HEADING OF ITS OWN LEVEL THAT IS NOT A MESSAGE.

WHAT STOOD. The listener's docstring says that a message runs to the next heading of its level or above. The pattern stopped at the two levels above only. A heading of three marks that is not a message was taken into the message before it.

WHAT IS CHANGED. The pattern stops at three marks as well. A heading inside a fenced block is still not a heading, and a heading below a message's level stays in the message.

THE TEST plants such a heading between two messages. With the listener of the commit before it fails. Run on main's own pages for the seats: no message of any page holds such a heading, so none is cut shorter. 0 of 19.
---
 scripts/seats/listen.py     |  5 ++++-
 tests/test_seat_listener.py | 22 ++++++++++++++++++++++
 2 files changed, 26 insertions(+), 1 deletion(-)

diff --git a/scripts/seats/listen.py b/scripts/seats/listen.py
index 1ac7bf649..cfef9844d 100644
--- a/scripts/seats/listen.py
+++ b/scripts/seats/listen.py
@@ -108,7 +108,10 @@ def messages(page):
     heads = [m for m in MESSAGE.finditer(page) if outside(m.start())]
     for k, m in enumerate(heads):
         end = heads[k + 1].start() if k + 1 < len(heads) else len(page)
-        nxt = next((x for x in re.finditer(r"^#{1,2} ", page[m.end():end], re.M) if outside(m.end() + x.start())), None)
+        # CORRECTED 2026-11-12 (Review 80; found by a reading of this function, checked by main on the pattern).  The pattern
+        # was r"^#{1,2} ": a message ended at a heading above its own level and ran on through a heading of its own level
+        # that is not a message, where the docstring says "of its level or above".  A message's heading has three marks.
+        nxt = next((x for x in re.finditer(r"^#{1,3} ", page[m.end():end], re.M) if outside(m.end() + x.start())), None)
         body = page[m.start():(m.end() + nxt.start()) if nxt else end]
         found[int(m.group(1))] = body.rstrip() + "\n"
     return found
diff --git a/tests/test_seat_listener.py b/tests/test_seat_listener.py
index d0311de30..5267f0c27 100644
--- a/tests/test_seat_listener.py
+++ b/tests/test_seat_listener.py
@@ -258,6 +258,28 @@ def test_the_listeners_docstring_says_what_mains_first_look_does(tmp_path):
     assert "On its FIRST LOOK" in doc and "exits with status 0 as well" in doc and "(for main's side, also on its first look)" in doc
 
 
+def test_a_message_ends_at_a_heading_of_its_own_level_that_is_not_a_message():
+    """Review 80, from a reading of the listener, checked by main on the pattern.  A message runs to the next heading of its
+    level or above.  The pattern stopped at the two levels above only, so a heading of three marks that is not a message was
+    taken into the message before it."""
+    import importlib.util
+    spec = importlib.util.spec_from_file_location("listen_for_test7", LISTEN); L = importlib.util.module_from_spec(spec); spec.loader.exec_module(L)
+    page = ("## Messages from main (newest first)\n\n### M2 — a day — two\n\ntext two\n\n### What stands between the messages\n\nnot a message\n\n"
+            "### M1 — a day — one\n\ntext one\n\n#### a heading below a message's level\n\nstill text one\n\n## What main is waiting for\n\n- nothing\n")
+    ms = L.messages(page)
+    assert sorted(ms) == [1, 2]
+    assert "text two" in ms[2] and "not a message" not in ms[2] and "What stands between" not in ms[2]
+    assert "still text one" in ms[1] and "a heading below a message's level" in ms[1] and "What main is waiting" not in ms[1]
+    # a heading of three marks inside a fenced block is not a heading, as before
+    fenced = "## Messages\n\n### M1 — a day — code\n\n```\n### not a heading\n```\n\nafter the block\n\n## The end\n"
+    assert "after the block" in L.messages(fenced)[1]
+    # and on main's own pages for the seats no message holds such a heading: none is cut by the stricter stop
+    for p in sorted((ROOT / "docs" / "seats").glob("*.md")):
+        text = p.read_text(encoding="utf-8")
+        for n, body in L.messages(text).items():
+            assert not [l for l in body.split("\n")[1:] if l.startswith("### ")] or "```" in body or "~~~" in body, (p.name, n)
+
+
 def test_fences_are_read_by_the_rule_an_old_memory_is_said_and_a_failed_listing_is_not_an_empty_one(tmp_path, monkeypatch):
