+_UNITS = ("", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen",
+          "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen")
+_TENS = ("", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety")
+
+
+def _in_words(n):
+    """a whole number from 1 to 999 as the paper writes one: 97 -> ninety-seven, 104 -> one hundred and four"""
+    assert 1 <= n <= 999
+    if n >= 100:
+        rest = n % 100
+        return _UNITS[n // 100] + " hundred" + (" and " + _in_words(rest) if rest else "")
+    if n < 20:
+        return _UNITS[n]
+    return _TENS[n // 10] + ("-" + _UNITS[n % 10] if n % 10 else "")
+
