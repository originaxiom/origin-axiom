+# ---- series 5: a gate reads the commit's files, and one it cannot read it does not pass over (Review 79, the second reader's row 24) ----
+# Three places.  The gate on the lists of hashed files passed over a tracked list it could not read, and read a tracked
+# file it could not read as a file that is not there.  The gate on sentences of arrival walked the disk where git would
+# not list the tracked files, and passed over a page it could not read.  And the runner printed a gate that had read in
+# part as a gate that had read nothing.
+_SEAL_ARC = "frontier/B9002_a_sealed_run"
+_SEAL_CODE = "THRESHOLD = 5\nprint('the count is at most', THRESHOLD)\n"
+
+
+def _sha(data):
+    return hashlib.sha256(data if isinstance(data, bytes) else data.encode("utf-8")).hexdigest()
+
+
+def _a_seal(tmp_path, more=None):
+    """a small repository: a root commit, then a script and the list that records its hash, and `more`; (repository, root)"""
+    repo = tmp_path / "sealed"
+    repo.mkdir(parents=True)
+    _git(repo, "init", "-q")
+    root = _commit(repo, "the root", {"README.md": "a repository\n"})
+    files = {_SEAL_ARC + "/verification/census.py": _SEAL_CODE,
+             _SEAL_ARC + "/ARTIFACT_HASHES.txt": "%s  verification/census.py\n" % _sha(_SEAL_CODE)}
+    files.update(more or {})
+    _commit(repo, "the seal", files)
+    return repo, root
+
+
+def _the_hash_gate(repo, root, frozen=frozenset()):
+    return _gates().gate_artifact_hashes(_repo=str(repo), _frozen=frozen, _root=root, _waived={}, _amended={})
+
+
+def test_a_list_of_hashed_files_that_cannot_be_read_fails_the_gate(tmp_path):
+    repo, root = _a_seal(tmp_path)
+    assert _the_hash_gate(repo, root)[0] is True
+    lst = repo / _SEAL_ARC / "ARTIFACT_HASHES.txt"
+    lst.unlink()
+    lst.mkdir()                                              # still tracked; on the disk, nothing that can be read
+    ok, detail = _the_hash_gate(repo, root)
+    assert ok is False, "a tracked list of hashed files could not be read, and the gate passed over it: " + detail
+    assert "ARTIFACT_HASHES.txt" in detail and "cannot be read" in detail, detail
+
+
+def test_a_tracked_file_that_cannot_be_read_is_not_a_file_that_is_not_there(tmp_path):
+    """an entry frozen as naming no tracked file: when the file it names is tracked and cannot be read, that is another state"""
+    more = {_SEAL_ARC + "/ARTIFACT_HASHES_MORE.txt": "%s  verification/later.py\n" % _sha("x = 1\n")}
+    repo, root = _a_seal(tmp_path, more)
+    key = next(e[0] for e in _gates().hash_list_state(str(repo)) if e[2] == "verification/later.py")
+    assert _the_hash_gate(repo, root, frozen={key: "N"})[0] is True
+    _commit(repo, "the file the list names, added", {_SEAL_ARC + "/verification/later.py": "x = 2\n"})
+    later = repo / _SEAL_ARC / "verification" / "later.py"
+    later.unlink()
+    later.mkdir()                                            # tracked, and not readable
+    ok, detail = _the_hash_gate(repo, root, frozen={key: "N"})
+    assert ok is False, "a tracked file that a list names could not be read, and the gate read it as not there: " + detail
+    assert "later.py" in detail, detail
+
+
+def _pages(tmp_path, pages):
+    repo = tmp_path / "pages"
+    repo.mkdir(parents=True)
+    _git(repo, "init", "-q")
+    _commit(repo, "the pages", pages)
+    return repo
+
+
+def test_the_arrival_gate_does_not_walk_the_disk_where_git_will_not_list_the_tracked_files(tmp_path):
+    g = _gates()
+    repo = _pages(tmp_path, {"docs/A_PAGE.md": "# A page\n\nNothing is claimed here.\n"})
+    assert g.gate_arrival_phrases(_root=str(repo), _baseline=0)[0] is True
+    (repo / "docs" / "A_DRAFT.md").write_text("# A draft, not tracked\n\nThe Standard Model is derived.\n", encoding="utf-8")
+    assert g.gate_arrival_phrases(_root=str(repo), _baseline=0)[0] is True          # an untracked draft is not a page of the commit
+    (repo / ".git" / "index").write_bytes(b"this is not an index")                    # git can no longer list the tracked files
+    ok, detail = g.gate_arrival_phrases(_root=str(repo), _baseline=0)
+    assert ok is False and "cannot verify" in detail, "git could not list the tracked files, and the arrival gate answered from the disk: " + detail
+    assert "A_DRAFT" not in detail, "the arrival gate read an untracked file: " + detail
+
+
+def test_a_page_the_arrival_gate_cannot_read_fails_it(tmp_path):
+    g = _gates()
+    repo = _pages(tmp_path, {"docs/A_PAGE.md": "# A page\n\nNothing is claimed here.\n", "docs/ANOTHER.md": "# Another\n\nNor here.\n"})
+    page = repo / "docs" / "ANOTHER.md"
+    page.unlink()
+    page.mkdir()                                             # tracked; on the disk, nothing that can be read
+    ok, detail = g.gate_arrival_phrases(_root=str(repo), _baseline=0)
+    assert ok is False, "a tracked page could not be read, and the arrival gate passed over it: " + detail
+    assert "docs/ANOTHER.md" in detail and "could not be read" in detail, detail
+
+
+def test_a_gate_that_read_in_part_is_printed_as_a_pass_with_its_whole_sentence():
+    g = _gates()
+    part = "every generated page compared with its builder; skipped in part: the programme's quotes of other seats, not its page"
+    line = g.result_line("closure-generated", True, part)
+    assert line.strip().startswith("PASS"), "a gate whose check ran, and that says what it left, is printed as a skip: " + line
+    assert part in line, "the runner hides what the gate did not read: " + line
+    # a gate that read nothing is still printed as a skip, with its own words
+    for nothing in ("git unavailable -- skipped", "no review anchor yet"):
+        assert g.result_line("some-gate", True, nothing).strip().startswith("SKIP"), nothing
