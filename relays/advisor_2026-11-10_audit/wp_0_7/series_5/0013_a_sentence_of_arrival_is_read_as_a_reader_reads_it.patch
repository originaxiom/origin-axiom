+            "(Not yet: the Standard Model is derived only in the sense of its grammar.)",               # the denial is before a colon
+            "Our aim, stated once more: the Standard Model is derived from one object."):               # the aim is before a colon, and no "that"
+        assert _arrival_on(g, tmp_path, honest_and_refused), honest_and_refused
+    for not_honest_and_passed in (
+            "Without a single free parameter the Standard Model is derived.",                           # the first of the nine, with no comma
+            "It is not a guess and the Standard Model is derived.",                                     # a denial about something else, in the same clause
+            "The Standard Model is derived, whether one likes it or not.",                              # a word of condition that states none
+            "All nineteen parameters now follow from the object with no free input."):                  # other words than the listed phrases
+        assert _arrival_on(g, tmp_path, not_honest_and_passed) == [], not_honest_and_passed
