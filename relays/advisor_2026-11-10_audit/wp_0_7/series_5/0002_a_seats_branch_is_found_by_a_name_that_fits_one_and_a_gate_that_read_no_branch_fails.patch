diff --git a/tests/test_gates_are_a_function_of_the_commit.py b/tests/test_gates_are_a_function_of_the_commit.py
index eaf6fa0e4..cfd52771e 100644
--- a/tests/test_gates_are_a_function_of_the_commit.py
+++ b/tests/test_gates_are_a_function_of_the_commit.py
@@ -653,3 +653,67 @@ def test_a_debt_gate_gives_one_answer_on_one_commit():
     g = _gates()
     twice = sorted(name for name in DATED if tuple(map(str, g.GATES[name]())) != tuple(map(str, g.GATES[name]())))
     assert not twice, "these gates give two answers on one commit, with nothing changed between the two: %s" % ", ".join(twice)
+
+
+# ---- series 5: a seat's branch is found by its full name, and a gate that could read no branch says so and fails ----------
+# The second reader's row 22, and what was found on the way to the failure of M10.  Main's word (M10): a gate that could
+# read no seat's branch is a failure, refused with its reason, as a shallow clone is.
+def _the_harvest_gates_answer(status, out):
+    """what the harvest gate answers for a run of its checker (before series 5 the gate held this in its own body)"""
+    g = _gates()
+    as_it_was = lambda rc, text: (False, text.replace("\n", " | ")[:500]) if rc != 0 else (True, g.harvest_sentence(text))
+    return getattr(g, "harvest_answer", as_it_was)(status, out)
+
+
+def test_a_branch_name_that_fits_two_branches_is_refused_by_name(tmp_path):
+    """the checker found a seat's branch by the last part of its name and, of two that fit, took the shorter"""
+    repo = _a_clone_with_the_web_seats_branch(tmp_path, branches=("chat1/web-seat", "zz/web-seat"))
+    status, out = _the_harvest_checker(repo)
+    assert status == 1, "the name web-seat fits two branches of the remote, one was taken without a word, and the checker ended with status %d" % status
+    assert "INTEGRITY" in out and "origin/chat1/web-seat" in out and "origin/zz/web-seat" in out, out
+    ok, detail = _the_harvest_gates_answer(status, out)
+    assert ok is False and "origin/zz/web-seat" in detail, "the gate's answer does not carry the reason: " + detail
+
+
+def test_a_pin_that_does_not_resolve_is_said_and_the_report_does_not_break(tmp_path):
+    """found on 2026-11-12 in a clone that had not fetched four pinned commits: the seat's entry was left with neither a
+    head nor a reason, and the report raised an error of a missing key in place of the checker's own line"""
+    repo = _a_clone_with_the_web_seats_branch(tmp_path / "a", pin="deadbeef1")
+    status, out = _the_harvest_checker(repo)
+    assert status == 1 and "Traceback" not in out and "KeyError" not in out, out[-600:]
+    assert "INTEGRITY: chat1: pin deadbeef1 does not resolve" in out and re.search(r"chat1\s+NOT READ: pin deadbeef1 does not resolve", out), out
+    ok, detail = _the_harvest_gates_answer(status, out)
+    assert ok is False and "pin deadbeef1 does not resolve" in detail, "the gate's answer does not carry the reason: " + detail
+    # a seat with no pin at all in the ledger's table: the same
+    repo = _a_clone_with_the_web_seats_branch(tmp_path / "b")
+    ledger = repo / "docs" / "HARVEST_LEDGER.md"
+    ledger.write_text("".join(l for l in ledger.read_text(encoding="utf-8").splitlines(keepends=True) if not l.startswith("| chat1 ")), encoding="utf-8")
+    status, out = _the_harvest_checker(repo)
+    assert status == 1 and "Traceback" not in out and re.search(r"chat1\s+NOT READ: no pin", out), out[-600:]
+
+
+def test_a_harvest_gate_that_could_read_no_seats_branch_fails_and_says_so(tmp_path):
+    """a clone that holds main alone: every seat's branch is absent, the checker reads none and ends with status 0, and the
+    gate said that no seat's branch is past its pin"""
+    repo = _a_clone_with_the_web_seats_branch(tmp_path, branches=())
+    status, out = _the_harvest_checker(repo)
+    assert status == 0 and "head " not in out.split("\n", 1)[1], out            # the checker itself has nothing to refuse: it read no branch
+    ok, detail = _the_harvest_gates_answer(status, out)
+    assert ok is False, "the harvest gate could read no seat's branch in this clone, and it answers: " + detail
+    assert "refused" in detail and "no seat's branch" in detail, detail
+
+
+def test_a_harvest_gate_that_read_some_branches_says_which_it_did_not_read(tmp_path):
+    """the other side: one seat's branch is in the clone and is read; the gate passes, and its sentence counts the rest"""
+    repo = _a_clone_with_the_web_seats_branch(tmp_path)
+    status, out = _the_harvest_checker(repo)
+    assert status == 0, out
+    ok, detail = _the_harvest_gates_answer(status, out)
+    assert ok is True, detail
+    live = sum(1 for s in _harvest().SEATS if not s.get("retired"))
+    assert "%d seat(s) not read in this clone" % (live - 1) in detail and "hostile (remote golden_gate not configured here)" in detail, detail
+    g = _gates()
+    assert g.result_line("harvest-debt", ok, detail).strip().startswith("PASS"), "the runner prints the sentence as a skip: " + detail
+    # where every branch is read the sentence is the one it was (main's own test holds it word for word)
+    read = "  harvest-debt (2026-11-11): 1 seat-index ids across 1 seats\n    sm       head 47228ae8 pin 47228ae8 (+0 commits) index 1 rows 1\n"
+    assert _the_harvest_gates_answer(0, read) == (True, "ok (no seat's branch is past its pin in this clone)")
