--- a/scripts/gates/gates.py
+++ b/scripts/gates/gates.py
@@ -2684,9 +2684,34 @@ def gate_retraction_debt():
 def gate_harvest_debt():
     """B1307 -- every seat branch is READ within 21 days of a push; the harvest ledger is reconciled against each seat's own index
     (MASTERPLAN v3.1 section 1a rule 3). Plain mode = instrument integrity + ageing; `review-due` runs it --strict."""
-    rc, out = _debt_checker("harvest_debt.py", "--quiet")
+    return harvest_answer(*_debt_checker("harvest_debt.py", "--quiet"))
+
+
+REFUSED_NO_SEAT = ("refused: no seat's branch is in this clone (%d not read: %s). This gate reads each seat's branch against the "
+                   "harvest ledger, and it could read none. Fetch the seats' branches")
+
+
+def _seats_not_read(tool_output):
+    """(seat, why) for every seat the tool did not read and that is not retired: its branch not fetched, its remote not
+    configured, its pin not readable"""
+    lines = re.findall(r"^\s+(\S+)\s+(?:SKIPPED|NOT READ): (.*)$", tool_output, re.M)
+    return [(seat, why.strip()) for seat, why in lines if not why.startswith("retired")]
+
+
+def harvest_answer(rc, out):
+    """the harvest gate's answer for a run of its checker: (ok, detail).
+
+    WP-0.7, series 5 (Review 79, the second reader's row 22; main's M10).  A checker that fails gives its reason first: the
+    reason stands after one line for each seat, and the answer was cut before it.  A checker that read no seat's branch
+    passes, having found nothing wrong among none: the gate is then refused, as it is on a shallow clone."""
     if rc != 0:
-        return False, out.replace("\n", " | ")[:500]
+        lines = [l.strip() for l in out.split("\n") if l.strip()]
+        why = [l for l in lines if l.startswith(("INTEGRITY", "harvest-debt:", "harvest-debt --strict", "refused"))
+               or re.match(r"\w+(?:Error|Exception)\b", l)]
+        return False, " | ".join(why + [l for l in lines if l not in why])[:500]
+    not_read = _seats_not_read(out)
+    if not re.search(r"^\s+\S+\s+head \S+ pin \S+", out, re.M):
+        return False, REFUSED_NO_SEAT % (len(not_read), "; ".join("%s, %s" % u for u in not_read[:3]) + (" ..." if len(not_read) > 3 else ""))
     # A seat whose branch has moved past its pin is not a failure for 21 days, and the gate said a bare "ok" meanwhile: on
     # 2026-11-11 the advisor seat's third re-audit sat fetched and unread for eight hours while main landed twice (B1880).  The
     # sentence now names every seat past its pin, and the runner prints it at every push.
@@ -2694,12 +2719,17 @@ def gate_harvest_debt():
 
 
 def harvest_sentence(tool_output):
-    """the harvest gate's sentence from the tool's own lines: which seats have commits past their pin, and how many"""
+    """the harvest gate's sentence from the tool's own lines: which seats have commits past their pin, and how many; and,
+    from series 5, how many seats the tool could not read in this clone (a gate says what it did not read)"""
     past = re.findall(r"^\s+(\S+)\s+head \S+ pin \S+ \(\+(\d+) commits?\)", tool_output, re.M)
     past = [(seat, int(n)) for seat, n in past if int(n) > 0]
+    not_read = _seats_not_read(tool_output)
+    blind = ("; %d seat(s) not read in this clone: " % len(not_read) + ", ".join("%s (%s)" % u for u in not_read[:3])
+             + (" and %d more" % (len(not_read) - 3) if len(not_read) > 3 else "")) if not_read else ""
     if not past:
-        return "ok (no seat's branch is past its pin in this clone)"
-    return "ok within the 21 days -- UNREAD: " + ", ".join("%s +%d commit(s) past its pin" % p for p in past) + " (read them at this landing)"
+        return "ok (no seat's branch is past its pin in this clone%s)" % blind
+    return ("ok within the 21 days -- UNREAD: " + ", ".join("%s +%d commit(s) past its pin" % p for p in past)
+            + " (read them at this landing)" + blind)
 
 
