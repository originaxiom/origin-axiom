+# ---- series 5: what Review 79 found in the debt checkers (its second reader's rows 20 and 22), and main's M10 -------------
+# The harvest checker timed its own run and printed the time at the end of its first line.  When the checker fails, its
+# gate gives that line back, so a failing harvest gate gave a different answer at every run; a test of this lock compares
+# three answers of the gate, and failed once on main's machine for it.  The checker also turned a commit's time into a
+# day in the zone of the machine it runs on.
+def _harvest():
+    spec = importlib.util.spec_from_file_location("harvest_for_the_commit_rule", ROOT / "scripts" / "checks" / "harvest_debt.py")
+    hd = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(hd)
+    return hd
+
+
+def _commit_at(repo, when, files):
+    """a commit whose author's and committer's time is `when`, in UTC"""
+    for rel, text in files.items():
+        f = repo / rel
+        f.parent.mkdir(parents=True, exist_ok=True)
+        f.write_text(text, encoding="utf-8")
+    env = dict(os.environ, GIT_AUTHOR_DATE=when, GIT_COMMITTER_DATE=when)
+    for a in (("add", "-A"), ("-c", "user.name=t", "-c", "user.email=t@example.invalid", "commit", "-q", "-m", "a commit at " + when)):
+        r = subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True, env=env)
+        assert r.returncode == 0, r.stderr
+    return _git(repo, "rev-parse", "HEAD")
+
+
+def _a_clone_with_the_web_seats_branch(tmp_path, branches=("chat1/web-seat",), pin=None, tags=True, later=None):
+    """A small repository that holds this repository's checkers and a harvest ledger with one pin, the web seat's.  Its
+    remote `origin` holds the seat's branch under each name of `branches`: one note, and a second one made at the time
+    `later` if that is given.  The pin is the commit of the first note unless `pin` is given.  Returns the repository."""
+    seat = tmp_path / "seat"
+    seat.mkdir(parents=True)
+    _git(seat, "init", "-q")
+    first = _commit_at(seat, "2026-10-01T12:00:00+00:00", {"relays/CHAT1_TO_CC_2026-10-01_A_NOTE.md": "a note\n"})
+    if later:
+        _commit_at(seat, later, {"relays/CHAT1_TO_CC_2026-10-20_A_SECOND_NOTE.md": "a second note\n"})
+    origin = tmp_path / "origin.git"
+    _git(tmp_path, "init", "-q", "--bare", str(origin))
+    for b in branches:
+        _git(seat, "push", "-q", str(origin), "HEAD:refs/heads/" + b)
+    repo = tmp_path / "repo"
+    shutil.copytree(ROOT / "scripts" / "checks", repo / "scripts" / "checks", ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
+    (repo / "docs").mkdir()
+    (repo / "docs" / "HARVEST_LEDGER.md").write_text(
+        "# The harvest ledger\n\n## Pins\n\n| seat | branch | pin | pinned at | by arc |\n|---|---|---|---|---|\n"
+        "| chat1 | `origin/chat1/web-seat` | `%s` | 2026-10-01 | B1 |\n\n## Rows\n\n"
+        "| # | seat | item | headline | path @ pin | disposition | main arc | date |\n|---|---|---|---|---|---|---|---|\n" % (pin or first[:8]),
+        encoding="utf-8")
+    _git(repo, "init", "-q")
+    _commit_at(repo, "2026-11-11T12:00:00+00:00", {})
+    if tags:                                          # the seats the checker holds as retired are known by a tag each
+        for s in _harvest().SEATS:
+            if s.get("retired"):
+                _git(repo, "tag", s["retired"])
+    _git(repo, "remote", "add", "origin", str(origin))
+    _git(repo, "fetch", "-q", "origin")
+    return repo
+
+
+def _the_harvest_checker(repo, day="2026-11-11", zone=None):
+    env = dict(os.environ, TZ=zone) if zone else None
+    r = subprocess.run([sys.executable, "-B", os.path.join("scripts", "checks", "harvest_debt.py"), "--quiet", "--today", day],
+                       cwd=str(repo), capture_output=True, text=True, env=env)
+    return r.returncode, r.stdout + r.stderr
+
+
+_A_DURATION = re.compile(r"\[\s*\??\d*(?:\.\d+)?\s*s\]")
+
+
+def test_the_harvest_checker_does_not_say_how_long_it_ran(tmp_path):
+    """the twin first: a clone that holds the seat's branch at its pin is read, and passes"""
+    repo = _a_clone_with_the_web_seats_branch(tmp_path / "read")
+    status, out = _the_harvest_checker(repo)
+    assert status == 0 and re.search(r"chat1\s+head \w+ pin \w+ \(\+0 commits\)", out), out
+    assert not _A_DURATION.search(out), "the harvest checker's line ends with how long it ran: " + out.splitlines()[0]
+    # a checker that fails: a seat held as retired, whose tag is not there.  Its gate gives these lines back as its answer
+    repo = _a_clone_with_the_web_seats_branch(tmp_path / "fails", tags=False)
+    status, out = _the_harvest_checker(repo)
+    assert status == 1 and "INTEGRITY" in out and "is missing" in out, out
+    assert not _A_DURATION.search(out), "a failing harvest checker's line ends with how long it ran, and its gate gives the line back: " + out.splitlines()[0]
+    assert _the_harvest_checker(repo) == (status, out), "the harvest checker gives two answers on one commit"
+
+
+def test_the_age_of_a_seats_item_is_the_same_in_every_zone_of_the_host(tmp_path):
+    """the second reader's row 20, third part.  A note made at half past eleven at night, UTC, 22 days before the commit's
+    day: in a zone twelve hours behind it is 22 days old and aged; in a zone fourteen hours ahead it was made a day later,
+    is 21 days old, and is not"""
+    repo = _a_clone_with_the_web_seats_branch(tmp_path, later="2026-10-20T23:30:00+00:00")
+    behind = _the_harvest_checker(repo, zone="Etc/GMT+12")
+    ahead = _the_harvest_checker(repo, zone="Pacific/Kiritimati")
+    assert behind == ahead, "the harvest checker ages a seat's item by the zone of the machine: %r where the zone is behind, %r where it is ahead" % (
+        behind[1].splitlines()[0][-60:], ahead[1].splitlines()[0][-60:])
+    assert behind[0] == 2 and "aged past 21d 1" in behind[1], behind                     # by its time in UTC it is 22 days old
+
+
+def test_a_debt_gate_gives_one_answer_on_one_commit():
+    """What the test of the day could not tell apart (found 2026-11-12, when it failed once on main's machine and said the
+    day had moved a gate).  Each debt gate is asked twice with nothing changed in between."""
+    g = _gates()
+    twice = sorted(name for name in DATED if tuple(map(str, g.GATES[name]())) != tuple(map(str, g.GATES[name]())))
+    assert not twice, "these gates give two answers on one commit, with nothing changed between the two: %s" % ", ".join(twice)
