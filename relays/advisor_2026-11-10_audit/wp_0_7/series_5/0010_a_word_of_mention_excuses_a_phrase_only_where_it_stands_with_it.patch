+++ b/scripts/checks/retraction_sweep.py
@@ -250,6 +250,40 @@ STANDS_AS_FOUND = {        # (file, phrase) -> what the instance is
 }
 
 
+# WHERE A WORD OF MENTION MUST STAND (WP-0.7, series 5; main's M13, from the first file of Review 80).
+#
+# The comment over MENTION_CUES says a line is a mention if it carries such a word "near the phrase".  What was read was the
+# line: one such word anywhere on it excused every phrase on it.  A row of a table is one line, and so is a paragraph of a
+# running log, some of them four thousand characters long.  Main's case: a live sentence in one cell and an unrelated
+# "corrected" in the next was not reported.  The word must now stand WITH the phrase: in the phrase's own cell, between the
+# bars on either side of it; and, on a line that is not a row of a table, within MENTION_WITHIN characters of the phrase,
+# before or after.  Measured on main's 5c7abd72a: of 63 phrases that stood on a line with such a word, 22 are in a row of
+# a table, each with the word in its own cell; of the other 41, 39 have it within 150 characters, and two have it 776
+# characters away.  Those two are one sentence in two pages, and it states the withdrawn reading live.  The sweep reports
+# them from this patch on, and they are main's to mend.
+MENTION_WITHIN = 200
+
+
+def _cues_on(line, flat):
+    """where the words of mention stand on a flattened line, as (start, end).  A strike-through is taken off with the markup,
+    so it is looked for on the line as written and placed by the length of what stands before it, flattened."""
+    spans = [(m.start(), m.end()) for m in MENTION_CUES.finditer(flat)]
+    if "~~" in line:
+        spans += [(k, k) for k in (len(_flatten(line[:m.start()])) for m in re.finditer("~~", line))]
+    return spans
+
+
+def _with_a_mention(flat, start, end, cues, row):
+    """whether the phrase at flat[start:end] stands with a word of mention.  The word must stand in the phrase's own cell:
+    between the bar before the phrase and the bar after it, or on the whole line where it has none.  In a row of a table
+    (a line that begins with a bar) that is all; on any other line the word must also be within MENTION_WITHIN characters
+    of the phrase, so that a row written without its first bar is read as a row and as a line."""
+    a, b = flat.rfind("|", 0, start) + 1, flat.find("|", end)
+    b = len(flat) if b < 0 else b
+    cues = [(cs, ce) for cs, ce in cues if a <= cs and ce <= b]
+    return bool(cues) if row else any(max(0, cs - end, start - ce) <= MENTION_WITHIN for cs, ce in cues)
+
+
 def sweep_all():
     """(the live uses of a registered phrase that nothing allows, the standing instances that were met)"""
     phrases = [(p, re.compile(re.escape(p), re.I)) for p in _phrases()]
@@ -274,17 +308,21 @@ def sweep_all():
         live = [(phrase, rx) for phrase, rx in phrases if phrase.lower() in flat_body]
         if not live:
             continue
+        found = []                                                    # (line, phrase), in the order they stand
         for n, line in enumerate(body.split("\n"), 1):
             flat = _flatten(line)
-            mention = MENTION_CUES.search(line) or MENTION_CUES.search(flat)
-            if mention:
+            hits = [(phrase, m) for phrase, rx in live for m in rx.finditer(flat)]
+            if not hits:
                 continue
-            for phrase, rx in live:
-                if rx.search(flat):
-                    if (rel, phrase) in STANDS_AS_FOUND:
-                        met.add((rel, phrase))
-                    else:
-                        violations.append((rel, n, phrase))
+            cues, row = _cues_on(line, flat), line.lstrip().startswith("|")
+            for phrase, m in hits:
+                if not _with_a_mention(flat, m.start(), m.end(), cues, row) and (n, phrase) not in found:
+                    found.append((n, phrase))
+        for n, phrase in found:
+            if (rel, phrase) in STANDS_AS_FOUND:
+                met.add((rel, phrase))
+            else:
+                violations.append((rel, n, phrase))
     return violations, met
 
 
