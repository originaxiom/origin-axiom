+# ---- series 5: a word of mention excuses a phrase only where it stands with it (main's M13) ----------------------------
+# The sweep's own comment says a line is a mention if it carries such a word "near the phrase".  What it read was the whole
+# line: one such word anywhere on it excused every phrase on it.  A row of a table is one line, and so is a paragraph of a
+# running log, some of them four thousand characters long (from the first file of Review 80).
+_FAR = "This paragraph was corrected in the spring, and what follows is a second matter. " + "And the work went on as it had. " * 9
+
+
+def test_a_word_of_mention_in_another_cell_of_the_row_does_not_excuse_the_phrase(tmp_path):
+    """the shape main planted: a live sentence in one cell, and an unrelated "corrected" in the next"""
+    row = "| what | note |\n|---|---|\n| We find that the lamp is always green in every run. | a second matter, corrected on Tuesday |\n"
+    repo = _sweep_repo(tmp_path, "cell", _REG_HEAD, {"docs/PAGE.md": "# A page\n\n" + row})
+    ok, detail = _gate(repo, "retraction-sweep")
+    assert ok is False, "a withdrawn phrase stands live in one cell and a word of mention in another, and the sweep passed: " + detail
+    assert "docs/PAGE.md" in detail
+    # the same row written without its first bar, which is a row all the same
+    bare = "what | note\n---|---\nWe find that the lamp is always green in every run. | a second matter, corrected on Tuesday\n"
+    repo = _sweep_repo(tmp_path, "no_first_bar", _REG_HEAD, {"docs/PAGE.md": "# A page\n\n" + bare})
+    ok, detail = _gate(repo, "retraction-sweep")
+    assert ok is False, "the same row without its first bar passed the sweep: " + detail
+    # the twin: the word stands in the phrase's own cell
+    own = "| what | note |\n|---|---|\n| the lamp is always green (withdrawn, see the registry) | a second matter |\n"
+    repo = _sweep_repo(tmp_path, "own_cell", _REG_HEAD, {"docs/PAGE.md": "# A page\n\n" + own})
+    ok, detail = _gate(repo, "retraction-sweep")
+    assert ok is True, detail
+
+
+def test_a_word_of_mention_far_from_the_phrase_does_not_excuse_it(tmp_path):
+    assert len(_FAR) > 300
+    repo = _sweep_repo(tmp_path, "far", _REG_HEAD, {"docs/LOG.md": "# A log\n\n" + _FAR + "We find that the lamp is always green in every run.\n"})
+    ok, detail = _gate(repo, "retraction-sweep")
+    assert ok is False, "a withdrawn phrase stands live more than 300 characters from the only word of mention on its line, and the sweep passed: " + detail
+    assert "docs/LOG.md" in detail
+    # the twins: the word before the phrase, after it, and a phrase struck through
+    for name, text in (("before", _FAR + "It was formerly said that the lamp is always green in every run.\n"),
+                       ("after", "We said that the lamp is always green in every run *(withdrawn 2026-11-12: it is not)*.\n"),
+                       ("struck", "- what the lamp does: ~~the lamp is always green~~; it is green on Tuesdays\n")):
+        repo = _sweep_repo(tmp_path, name, _REG_HEAD, {"docs/LOG.md": "# A log\n\n" + text})
+        ok, detail = _gate(repo, "retraction-sweep")
+        assert ok is True, (name, detail)
+
+
 # ---- PV16: the controls gate checked that a control's name is defined, and nothing of the control ----------------------
 _CONTROL_OK = ("def test_the_gate_fails_on_a_planted_case():\n    answers = sorted([False, True])\n    assert answers[0] is False\n")
 
