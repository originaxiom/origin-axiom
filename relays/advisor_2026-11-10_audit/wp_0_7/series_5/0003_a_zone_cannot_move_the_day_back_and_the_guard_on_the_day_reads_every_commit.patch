+def test_a_commit_dated_before_any_of_its_parents_is_refused_wherever_it_stands(tmp_path):
+    g = _gates()
+    repo = _small_repo(tmp_path)
+    t0 = int(_git(repo, "log", "-1", "--format=%ct", "HEAD"))
+    root = _git(repo, "rev-parse", "HEAD")
+    trunk = _git(repo, "rev-parse", "--abbrev-ref", "HEAD")
+
+    def merge(branch, when):
+        r = subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid", "merge", "-q", "--no-ff", "-m", "merge " + branch, branch],
+                           capture_output=True, text=True, env={**os.environ, "GIT_COMMITTER_DATE": "%d +0000" % when, "GIT_AUTHOR_DATE": "%d +0000" % when})
+        assert r.returncode == 0, r.stderr
+        return _git(repo, "rev-parse", "HEAD")
+
+    def side(name, times):
+        _git(repo, "checkout", "-q", "-b", name, root)
+        made = []
+        for n, when in enumerate(times):
+            (repo / "sub" / (name + ".md")).write_text("%s %d\n" % (name, n), encoding="utf-8")
+            _git(repo, "add", "-A")
+            r = subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid", "commit", "-q", "-m", "%s %d" % (name, n)],
+                               capture_output=True, text=True, env={**os.environ, "GIT_COMMITTER_DATE": "%d +0000" % when, "GIT_AUTHOR_DATE": "%d +0000" % when})
+            assert r.returncode == 0, r.stderr
+            made.append(_git(repo, "rev-parse", "HEAD"))
+        _git(repo, "checkout", "-q", trunk)
+        return made
+
+    # the twin first: a branch whose commits and whose merge are each dated after their parents
+    side("clean", [t0 + 100, t0 + 200])
+    _commit_dated(repo, t0 + 150, "on main's own line\n")
+    merge("clean", t0 + 300)
+    assert g.commit_day_problems(repo, root) == []
+    # a commit dated before its parent, on a branch that is then merged
+    back = side("back", [t0 + 400, t0 + 400 - 30 * 86400])[1]
+    merge("back", t0 + 500)
+    bad = g.commit_day_problems(repo, root, limit=9)
+    assert any(back[:9] in b and "before its parent" in b for b in bad), "a commit dated a month before its parent was merged from a branch, and the guard reads: %r" % (bad,)
+    # a merge dated before the branch it merges: after its first parent, before its second
+    late = side("late", [t0 + 900])[0]
+    merged = merge("late", t0 + 600)
+    bad = g.commit_day_problems(repo, root, limit=9)
+    assert any(merged[:9] in b and late[:9] in b for b in bad), "a merge was dated before the branch it merges, and the guard reads: %r" % (bad,)
