+# ---- series 5: a zone cannot move the day back (Review 79, the second reader's row 10, its first and second parts) --------
+# The day a gate took was the day the commit states, in the commit's own zone; the guard on the day read the commit's
+# time.  A commit made one second after its parent, and stated in a zone far behind its parent's, passed the guard and
+# moved the day back.  And the guard read main's own line only: a merge dated before the branch it merges, or a
+# commit dated before its parent on that branch, was not read.
+def _commit_day():
+    spec = importlib.util.spec_from_file_location("commit_day_for_the_one_day", ROOT / "scripts" / "checks" / "commit_day.py")
+    cd = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(cd)
+    return cd
+
+
+def _day_of(repo, ref="HEAD"):
+    """the day a commit is judged on, worked out here apart from the gates: the later of its day in UTC and the day it states"""
+    seconds, stated = _git(repo, "log", "-1", "--format=%ct %cs", ref).split()
+    return max(datetime.datetime.fromtimestamp(int(seconds), datetime.timezone.utc).date(), datetime.date.fromisoformat(stated))
+
+
+def test_a_zone_cannot_move_the_day_of_a_commit_back(tmp_path):
+    g, cd = _gates(), _commit_day()
+    repo = _small_repo(tmp_path)
+    noon = int(datetime.datetime(2026, 11, 10, 11, 0, tzinfo=datetime.timezone.utc).timestamp())
+    root = _commit_dated(repo, noon - 3600, "an hour before\n")
+    _commit_dated(repo, noon, "stated in UTC: the commit says the 10th\n")
+    parent_day = cd.of_head(repo)
+    _commit_dated(repo, noon + 1, "one second later, stated twelve hours behind: the commit says the 9th\n", zone="-1200")
+    assert _git(repo, "log", "-2", "--format=%cs") == "2026-11-09\n2026-11-10"          # as the two commits state their day
+    assert g.commit_day_problems(repo, root) == []                                  # time did not run backwards
+    day = cd.of_head(repo)
+    assert day >= parent_day, "a commit made one second after its parent has an earlier day (%s, after %s): the day went backwards and the guard passed" % (day, parent_day)
+    assert day == parent_day == datetime.date(2026, 11, 10) == _day_of(repo)
+    # the case as the reader wrote it: the parent stated fourteen hours ahead, the child twelve behind, a second apart.  The
+    # child's day is the day of its time, not the 9th that it states
+    _commit_dated(repo, noon + 2, "stated fourteen hours ahead: the commit says the 11th\n", zone="+1400")
+    _commit_dated(repo, noon + 3, "and one second later twelve hours behind: the commit says the 9th\n", zone="-1200")
+    assert _git(repo, "log", "-2", "--format=%cs") == "2026-11-09\n2026-11-11" and g.commit_day_problems(repo, root) == []
+    assert cd.of_head(repo) == datetime.date(2026, 11, 10)
+    # and on this repository the gates pass the same day to their checkers
+    assert g._today_args() == ["--today", cd.of_head(ROOT).isoformat()] == ["--today", _day_of(ROOT).isoformat()]
+
+
+def test_a_commit_made_in_the_first_hour_of_a_day_in_a_zone_ahead_is_judged_on_the_day_it_states(tmp_path):
+    """found before the series was sent, by main's own test of the waiver file.  As first built the day was the day in UTC
+    alone.  Review 79 was entered at 00:22 on the 12th in main's zone, which is the 11th in UTC: its day moved back, and the
+    owner's waiver typed on the 11th, which had expired when the review was entered, covered again."""
+    g, cd = _gates(), _commit_day()
+    late = int(datetime.datetime(2026, 11, 11, 23, 22, tzinfo=datetime.timezone.utc).timestamp())      # 00:22 on the 12th, an hour ahead of UTC
+    repo = _small_repo(tmp_path)
+    _commit_dated(repo, late, "a review is entered\n", zone="+0100")
+    assert _git(repo, "log", "-1", "--format=%cs") == "2026-11-12" and g._utc_day(late) == "2026-11-11"
+    assert cd.of_head(repo) == datetime.date(2026, 11, 12) == cd.day_of(late, "2026-11-12")
+    assert g._day_of_commit("%d 2026-11-12" % late) == "2026-11-12"
+    waiver = "- waived 2026-11-11 by the owner through 50 merges: planted\n"
+    assert g.review_waiver_covers(45, waiver, since=g._day_of_commit("%d 2026-11-12" % late)) is False     # expired, as the page means it
+    assert g.review_waiver_covers(45, waiver, since=g._utc_day(late)) is True                               # what the day in UTC alone gave
+    # the day an age is counted from stays the day in UTC: a zone cannot make a debt younger either
+    assert cd.utc_day(late) == datetime.date(2026, 11, 11)
+    assert g._day_of_commit("no stamp") == "" and g._day_of_commit("") == ""
+
