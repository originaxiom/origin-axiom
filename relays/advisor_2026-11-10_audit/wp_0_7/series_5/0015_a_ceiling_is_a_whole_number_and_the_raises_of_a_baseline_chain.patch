+# ---- series 5: a ceiling is a whole number, and the raises of a baseline chain (Review 80: agy-002's rows 48 and 49) -------
+# Main made the principal case of each again on these functions (its second probe of the builder's rows) and lists a sub-case
+# of each that its probes did not make.  Both rows are about what this series changes, so the series is held to them.
+
+def test_a_ceiling_that_is_not_a_whole_number_is_refused():
+    g = _gates()
+    rises = lambda now, then, named=None: g.ceiling_rises("the/baseline.json", now, then, "abc123", named or {})
+    assert not (5 > 5.5)                                                # how the table is used: with a ceiling of 5.5 a file may hold 5
+    assert "rose" in rises({"a.md": 5}, {})[0]                          # the control of main's probe: a new ceiling of five is a step up
+    for odd in (5.5, "9", True, -1, None, [5], 5.0):
+        problem, _ = rises({"a.md": odd}, {})
+        assert problem and "not a whole number" in problem and "a.md" in problem, "a ceiling of %r, with none at the anchor, is read as no step up" % (odd,)
+    assert rises({"a.md": 5.5, "b.md": 2}, {"a.md": 5.5, "b.md": 3}) == (None, "")          # what stood so at the anchor is not re-judged
+    assert "not a whole number" in rises({"a.md": 6.5}, {"a.md": 5.5})[0]                # and one that changed since is
+
+
+def test_a_ceiling_named_as_raised_once_does_not_rise_again_on_that_record():
+    """the sub-case of row 48: once an entry was named as raised, nothing bounded a further rise of it"""
+    g = _gates()
+    record = {"a.md": "2026-11-12 -- one rise, for one reason"}
+    assert g.ceiling_rises("x", {"a.md": 50}, {"a.md": 1}, "abc123", record)[0] is None     # read at its two ends, as before series 5: one rise, one record
+    along = [("the anchor", {"a.md": 1}), ("c1", {"a.md": 2}), ("c2", {"a.md": 50})]
+    problem, _ = g.ceiling_steps("x", along, "abc123", record)
+    assert problem and "a.md 1 -> 2 in c1, then 2 -> 50 in c2" in problem and "2 steps up, 1 recorded" in problem, problem
+    two = {"a.md": ["2026-11-12 -- the first", "2026-11-13 -- the second, to fifty, and why"]}
+    assert g.ceiling_steps("x", along, "abc123", two)[0] is None
+    # what is not bounded, said here: one step may be of any height.  Its record is written in the commit that takes it.
+    assert g.ceiling_steps("x", [("the anchor", {"a.md": 1}), ("c1", {"a.md": 500})], "abc123", record)[0] is None
+
+
+def test_the_raises_of_the_baseline_are_counts_and_chain():
+    g = _gates()
+    then = {"unearned": 5, "_baseline_raises": []}
+    grow = lambda b, raises: {"unearned": b, "_baseline_raises": list(raises)}
+    r = lambda a, b: {"date": "2026-11-12", "from": a, "to": b, "reason": "why"}
+    # the principal case of row 49: a raise "from false to true" paid for a rise of one
+    assert True - False == 1
+    assert "does not go up" in g.baseline_rise(grow(6, [r(False, True)]), then)[0]
+    # the sub-case: intervals that do not chain.  Each of these adds up to the rise, which is all that was asked
+    assert "do not chain" in g.baseline_rise(grow(8, [r(5, 6), r(9, 11)]), then)[0]
+    assert "do not chain" in g.baseline_rise(grow(6, [r(40, 41)]), then)[0]
+    assert "took it to 3" in g.baseline_rise(grow(7, [r(1, 3)]), then)[0]
+    assert "took it to 4" in g.baseline_rise(grow(8, [r(5, 6), r(2, 4)]), then)[0]
+    # the twins: a chain, and a chain with a fall between two raises
+    assert g.baseline_rise(grow(8, [r(5, 6), r(6, 8)]), then)[0] is None
+    assert g.baseline_rise(grow(5, [r(5, 6), r(4, 5)]), then)[0] is None
+    assert g.baseline_rise(grow(3, [r(5, 6)]), then)[0] is None                           # raised, and then it fell
+    assert "holds no count now" in g.baseline_rise(grow("six", []), then)[0]
+
+
+def test_each_step_up_of_the_baseline_is_the_raises_recorded_for_it():
+    g = _gates()
+    r = lambda a, b: {"date": "2026-11-12", "from": a, "to": b, "reason": "why"}
+    at = lambda b, raises: {"unearned": b, "_baseline_raises": list(raises)}
+    def along(*states):
+        return g.baseline_rise_along([("the anchor", at(5, []))] + [("c%d" % (n + 1), s) for n, s in enumerate(states)], "abc123")[0]
+    # two steps, 5 -> 6 and 6 -> 8, and raises that add up to three and chain, and are not the steps that were taken
+    wrong = [r(5, 7), r(7, 8)]
+    assert g.baseline_rise(at(8, wrong), at(5, [])) [0] is None                           # read at its two ends, they pass
+    problem = along(at(6, wrong[:1]), at(8, wrong))
+    assert problem and "stepped up 5 -> 6 in c1" in problem and "5 -> 7" in problem, problem
+    assert along(at(6, [r(5, 6)]), at(8, [r(5, 6), r(6, 8)])) is None                      # the twin: each step is its raise
+    assert along(at(8, [r(5, 6), r(6, 8)])) is None                                        # the twin: one step, recorded as two raises that chain
+    assert along(at(6, [r(5, 6)]), at(4, [r(5, 6)]), at(5, [r(5, 6), r(4, 5)])) is None    # the twin: a fall, and a raise from where it fell to
+    # a raise that no step took
+    problem = along(at(5, [r(5, 6)]))
+    assert problem and "match no step up" in problem, problem
+    # the sub-case of row 49: an entry deleted after the anchor.  The raise is recorded, the step is taken, the record is removed
+    problem = along(at(6, [r(5, 6)]), at(6, []))
+    assert problem and "account for 0" in problem, problem
+
+
+def test_on_this_repository_the_two_ratchets_read_as_they_did():
+    g = _gates()
+    assert g.attribution_baseline_rise() == (None, "")
+    ok, detail = g.GATES["identification-register"]()
+    assert ok is True, detail
+    table = g._load_attr_baseline()
+    assert table and all(isinstance(v, int) and not isinstance(v, bool) and v >= 0 for v in table.values()), "a ceiling on main is not a whole number"
