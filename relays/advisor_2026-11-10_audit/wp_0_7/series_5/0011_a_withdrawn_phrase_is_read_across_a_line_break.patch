@@ -470,6 +470,31 @@ def test_a_word_of_mention_far_from_the_phrase_does_not_excuse_it(tmp_path):
         assert ok is True, (name, detail)
 
 
+# ---- series 5: a withdrawn phrase is read across a line break (main's unseen case U17.b for series 3) -----------------
+# The sweep chose its phrases from the file flattened whole and then looked for them line by line: a phrase broken over
+# two lines was found on neither.
+def test_a_withdrawn_phrase_broken_over_lines_is_found(tmp_path):
+    """U17.b: the phrase with a line break in its middle"""
+    for name, text in (("two", "We find that the lamp is\nalways green, as before.\n"),
+                       ("three", "We find that the lamp\nis always\ngreen, as before.\n"),
+                       ("indented", "- we find that the lamp is\n  always green, as before\n"),
+                       ("quoted", "> We find that the lamp is\n> always green, as before.\n")):
+        repo = _sweep_repo(tmp_path, name, _REG_HEAD, {"docs/PAGE.md": "# A page\n\n" + text})
+        ok, detail = _gate(repo, "retraction-sweep")
+        assert ok is False, "a withdrawn phrase broken over lines (%s) passed the sweep: %s" % (name, detail)
+        assert "docs/PAGE.md:3" in detail, detail                                   # reported at the line on which it begins
+    repo = _sweep_repo(tmp_path, "code", _REG_HEAD, {"tools/a_script.py": "X = 1\n# we find that the lamp is always\n# green, as before\n"})
+    ok, detail = _gate(repo, "retraction-sweep")
+    assert ok is False and "tools/a_script.py:2" in detail, "the phrase broken over two lines of a comment passed the sweep: " + detail
+    # the twins: a mention broken over lines; and two paragraphs that only read as the phrase when the page is flattened whole
+    for name, text in (("mention", "It was formerly said that the lamp is\nalways green, and it is not.\n"),
+                       ("paragraphs", "We lit the lamp is\n\nalways green was the paint.\n"),
+                       ("rows", "| a | b |\n|---|---|\n| the lamp is |\n| always green |\n")):
+        repo = _sweep_repo(tmp_path, name, _REG_HEAD, {"docs/PAGE.md": "# A page\n\n" + text})
+        ok, detail = _gate(repo, "retraction-sweep")
+        assert ok is True, (name, detail)
+
+
 # ---- PV16: the controls gate checked that a control's name is defined, and nothing of the control ----------------------
 _CONTROL_OK = ("def test_the_gate_fails_on_a_planted_case():\n    answers = sorted([False, True])\n    assert answers[0] is False\n")
 
