+# THE GUARDS OF WHAT IS SEALED READ EVERY COMMIT (WP-0.7, series 5; Review 79, the second reader's row 23).  The three guards
+# below each read main's own line.  A branch that adds a sealed file or a list of hashed files, changes it, and is then merged
+# shows the file on main's line as added: the change was read by nothing.  They now read every commit that the head reaches
+# and their root does not.  A commit with one parent is read beside it.  A MERGE IS READ FOR WHAT IT CHANGES ITSELF: a path is
+# the merge's own change only where its state in the merge is the state in none of its parents.  What a merge brings from a
+# branch was changed on that branch, and is read there; what a branch from before a seal lacks is no deletion.
+def changes_after(git, root, specs=()):
+    """((commit, parent, status, path) for every change to a path that is not the adding of it, by a commit after `root`;
+    the number of commits read).  `status` is git's letter; for a move the path is the old one.  `git` runs a git command
+    and gives the finished process.  The commits with one parent are read in one call; a merge is read beside each parent."""
+    out, n = [], 0
+    one = git("log", "--reverse", "--full-history", "--no-merges", "-M", "--name-status", "--format=%x01%H %P", f"{root}..HEAD", "--", *specs)
+    for rec in one.stdout.split("\x01"):
+        rows = [l for l in rec.split("\n") if l.strip()]
+        if not rows:
+            continue
+        n += 1
+        head = rows[0].split()
+        c, par = head[0], (head[1] if len(head) > 1 else None)
+        for line in rows[1:]:
+            parts = line.split("\t")
+            if len(parts) >= 2 and not parts[0].startswith("A") and par:
+                out.append((c, par, parts[0][0], parts[1]))
+    merges = [l.split() for l in git("log", "--reverse", "--full-history", "--merges", "--format=%H %P", f"{root}..HEAD", "--", *specs).stdout.splitlines() if l.strip()]
+    for row in merges:
+        n += 1
+        c, per_parent = row[0], []
+        for par in row[1:]:
+            changed = {}
+            for line in git("diff-tree", "--no-commit-id", "--name-status", "-r", "-M", par, c, "--", *specs).stdout.splitlines():
+                parts = line.split("\t")
+                if len(parts) >= 2:
+                    changed[parts[1]] = parts[0][0]
+                    if parts[0][0] in "RC" and len(parts) >= 3:
+                        changed.setdefault(parts[2], "A")              # the new name of what was moved: added there
+            per_parent.append((par, changed))
+        own = set.intersection(*(set(ch) for _par, ch in per_parent)) if per_parent else set()     # as none of the parents has it
+        for path in sorted(own):
+            against = [(par, ch[path]) for par, ch in per_parent if ch[path] != "A"]
+            if against:                                               # at least one parent held it, and the merge changed it
+                out.append((c, against[0][0], against[0][1], path))
+    return out, n
+
+
+_VERBS = {"M": "edits", "D": "deletes", "R": "moves", "T": "changes the type of", "C": "copies over"}
+
