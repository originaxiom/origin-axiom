+# ---- series 5: the guards of what is sealed read every commit (Review 79, the second reader's row 23) ---------------------
+# Three guards hold that a sealed file, and a list of hashed files under either kind of name, does not change after it is
+# added.  Each read main's own line only.  A branch that adds such a file, changes it, and is then merged shows the file
+# on main's line as added, and the change was read by nothing.
+_SEALED = "frontier/B9_an_arc/PREREGISTRATION.md"
+_LISTED = "frontier/B9_an_arc/ARTIFACT_HASHES.txt"
+_SUMMED = "frontier/B9_an_arc/verification/sums.sha256"
+_A_HASH = "0123456789abcdef" * 4
+
+
+def _guards(g, repo, root):
+    """the three guards' problems on `repo` after `root`, as one list"""
+    return (g.seal_immutable_problems(repo, root)[0] + g.hash_lists_immutable_problems(repo, root)[0]
+            + g.hash_lists_by_content_problems(repo, root)[0])
+
+
+def _a_repository_with_a_trunk(tmp_path):
+    repo = _small_repo(tmp_path)
+    return repo, _git(repo, "rev-parse", "HEAD"), _git(repo, "rev-parse", "--abbrev-ref", "HEAD")
+
+
+def _write(repo, files):
+    for rel, text in files.items():
+        f = repo / rel
+        f.parent.mkdir(parents=True, exist_ok=True)
+        f.write_bytes(text) if isinstance(text, bytes) else f.write_text(text, encoding="utf-8")
+    _git(repo, "add", "-A")
+
+
+def _commit_files(repo, message, files):
+    _write(repo, files)
+    _git(repo, "commit", "-q", "-m", message)
+    return _git(repo, "rev-parse", "HEAD")
+
+
+_THREE = {_SEALED: "what is declared before the run\n", _LISTED: "%s  run.py\n" % _A_HASH, _SUMMED: "%s  out.json\n" % _A_HASH}
+
+
+def test_what_is_sealed_on_a_branch_and_changed_there_before_the_merge_is_read(tmp_path):
+    g = _gates()
+    # the twin first: a branch adds the three and leaves them as they are; main's line moves on; the branch is merged
+    repo, root, trunk = _a_repository_with_a_trunk(tmp_path / "clean")
+    _git(repo, "checkout", "-q", "-b", "side")
+    _commit_files(repo, "three seals", _THREE)
+    _git(repo, "checkout", "-q", trunk)
+    _commit_files(repo, "on main's own line", {"sub/page.md": "a page, changed\n"})
+    _git(repo, "merge", "-q", "--no-ff", "-m", "merge side", "side")
+    assert _guards(g, repo, root) == []
+    # the case: the same branch, with a second commit that changes each of the three
+    repo, root, trunk = _a_repository_with_a_trunk(tmp_path / "changed")
+    _git(repo, "checkout", "-q", "-b", "side")
+    _commit_files(repo, "three seals", _THREE)
+    edit = _commit_files(repo, "each of the three changed", {k: v + "and one line more\n" for k, v in _THREE.items()})
+    _git(repo, "checkout", "-q", trunk)
+    _git(repo, "merge", "-q", "--no-ff", "-m", "merge side", "side")
+    bad = _guards(g, repo, root)
+    for path, what in ((_SEALED, "the sealed file"), (_LISTED, "the list of hashed files"), (_SUMMED, "the list of hashed files")):
+        assert any(edit[:9] in b and "edits " + what + " " + path in b for b in bad), (
+            "%s was added on a branch, changed there, and merged; the guards read: %r" % (path, bad))
+
+
+def test_a_merge_is_read_for_what_it_changes_itself_and_not_for_what_it_brings(tmp_path):
+    g = _gates()
+    repo, root, trunk = _a_repository_with_a_trunk(tmp_path)
+    _commit_files(repo, "three seals, on main's own line", _THREE)
+    sealed = _git(repo, "rev-parse", "HEAD")
+    # a branch from before the seals, merged after them: against the branch the three are new, and that is no change
+    _git(repo, "checkout", "-q", "-b", "side", root)
+    _commit_files(repo, "a page on the branch", {"sub/other.md": "another page\n"})
+    _git(repo, "checkout", "-q", trunk)
+    _git(repo, "merge", "-q", "--no-ff", "-m", "merge side", "side")
+    assert _guards(g, repo, sealed) == [], "a merge that brings in a branch from before the seals is read as changing them"
+    # a merge that changes a list in its own commit: the list is as neither of its parents has it
+    _git(repo, "checkout", "-q", "-b", "side2")
+    _commit_files(repo, "a second page on a branch", {"sub/third.md": "a third page\n"})
+    _git(repo, "checkout", "-q", trunk)
+    _git(repo, "merge", "-q", "--no-ff", "--no-commit", "side2")
+    _write(repo, {_LISTED: "%s  run.py\n" % ("f" * 64)})
+    _git(repo, "commit", "-q", "-m", "merge side2, and the list rewritten in the merge")
+    merge = _git(repo, "rev-parse", "HEAD")
+    bad = _guards(g, repo, sealed)
+    assert any(merge[:9] in b and _LISTED in b for b in bad), "a merge rewrote a list of hashed files in its own commit, and the guards read: %r" % (bad,)
+
+
+def test_a_list_whose_bytes_are_not_text_does_not_break_the_guard(tmp_path):
+    """the same row, its last part: the file as it stood before a change was read as text, and bytes that are not UTF-8
+    raised an error in place of an answer"""
+    g = _gates()
+    repo, root, trunk = _a_repository_with_a_trunk(tmp_path)
+    _commit_files(repo, "a list with a name in another encoding", {_SUMMED: ("%s  caf\xe9.json\n" % _A_HASH).encode("latin-1")})
+    edit = _commit_files(repo, "and changed", {_SUMMED: ("%s  caf\xe9.json\n" % ("e" * 64)).encode("latin-1")})
+    bad, read = g.hash_lists_by_content_problems(repo, root)
+    assert any(edit[:9] in b and _SUMMED in b for b in bad), bad
