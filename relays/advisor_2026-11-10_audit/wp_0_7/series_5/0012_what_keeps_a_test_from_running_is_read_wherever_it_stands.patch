--- a/scripts/checks/check_test_vacuity.py
+++ b/scripts/checks/check_test_vacuity.py
@@ -251,6 +251,119 @@ def cannot_fail(fn):
 
 
 _SWITCH = re.compile(r"\b(skip|skipif|xfail|importorskip)\b")
+_SKIPS_WHEN_CALLED = re.compile(r"(?:^|\.)(?:skip|importorskip|SkipTest)$")          # pytest.skip, pytest.importorskip, unittest.SkipTest
+_A_MARK = re.compile(r"\bmark\b")
+
+
+# WHAT KEEPS A TEST FROM RUNNING IS READ WHEREVER IT STANDS (WP-0.7, series 5; main's M13, its third item).  The readers below
+# read the first level of statements of a file: a mark on the module, or a call that skips, each written as a statement of
+# its own.  The same call under a condition, in an except clause or in a with, or given to a name, was not read; nor a mark
+# bound to a name and put on a test by that name; nor a mark that a class sets in its own body; nor a fixture of the module
+# that skips the test that asks for it.  The whole first level of the module is now read: every statement that runs as
+# the module is loaded, which is all of it but what stands inside a function, a lambda or a class.  And a test is read
+# with the marks it wears by a name of the module, and with the module's fixtures that it asks for.
+def _first_level(tree):
+    """every node of a module that runs as the module is loaded: all of it but what stands inside a function, a lambda or a
+    class.  (A function's marks are read with the function, a class's with the class.)"""
+    out, stack = [], list(tree.body)
+    while stack:
+        n = stack.pop()
+        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef, ast.Lambda)):
+            continue
+        out.append(n)
+        stack.extend(ast.iter_child_nodes(n))
+    return out
+
+
+def _binds(n, name):
+    """whether the statement binds `name` to something: plainly, with an annotation, or in place"""
+    targets = n.targets if isinstance(n, ast.Assign) else ([n.target] if isinstance(n, (ast.AnnAssign, ast.AugAssign)) else [])
+    return getattr(n, "value", None) is not None and any(isinstance(t, ast.Name) and t.id == name for t in targets)
+
+
+def _names(node, marks):
+    """whether the expression names one of `marks`"""
+    return any(isinstance(x, ast.Name) and x.id in marks for x in ast.walk(node))
+
+
+def named_marks(tree):
+    """the names a module binds, on its first level, to a mark that skips or expects a failure (not_today = pytest.mark.skip(...)),
+    or to something that holds one, or to another such name; and its own functions that make such a mark"""
+    binds = [(n, n.targets if isinstance(n, ast.Assign) else [n.target]) for n in _first_level(tree)
+             if isinstance(n, (ast.Assign, ast.AnnAssign)) and n.value is not None]
+    marks = {n.name for n in tree.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and not n.name.startswith("test")
+             and any(isinstance(x, ast.Attribute) and _A_MARK.search(ast.unparse(x)) and _SWITCH.search(ast.unparse(x)) for x in ast.walk(n))}
+    grew = True
+    while grew:
+        grew = False
+        for n, targets in binds:
+            text = ast.unparse(n.value)
+            if (_A_MARK.search(text) and _SWITCH.search(text)) or _names(n.value, marks):
+                new = {t.id for t in targets if isinstance(t, ast.Name)} - marks - {"pytestmark"}
+                marks, grew = marks | new, grew or bool(new)
+    return marks
+
+
+def fixtures_that_skip(tree):
+    """the module's own fixtures that can skip the test that asks for them: {name: whether every test gets it unasked}.  A
+    fixture skips where its body calls a skip, or where it asks for a fixture of the module that does."""
+    fixtures = {n.name: n for n in tree.body if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))
+                and any("fixture" in ast.unparse(d) for d in n.decorator_list)}
+    skips = {name for name, n in fixtures.items() if any(isinstance(x, ast.Call) and _SWITCH.search(ast.unparse(x.func)) for x in ast.walk(n))}
+    grew = True
+    while grew:
+        more = {name for name, n in fixtures.items() if name not in skips and any(a.arg in skips for a in n.args.args + n.args.kwonlyargs)}
+        skips, grew = skips | more, bool(more)
+    return {name: any("autouse=True" in ast.unparse(d) for d in fixtures[name].decorator_list) for name in skips}
+
+
+def asks_for(fn, fixtures):
+    """the fixtures of `fixtures` that a test function asks for: by a parameter's name, or by a usefixtures mark that it wears"""
+    asked = [a.arg for a in fn.args.args + fn.args.kwonlyargs if a.arg in fixtures]
+    return asked + _used(fn.decorator_list, fixtures)
+
+
+def _used(expressions, fixtures):
+    """the fixtures of `fixtures` named in a usefixtures mark among `expressions`"""
+    return [x.value for e in expressions if "usefixtures" in ast.unparse(e)
+            for x in ast.walk(e) if isinstance(x, ast.Constant) and isinstance(x.value, str) and x.value in fixtures]
+
+
+def wears_a_switch(decorator, marks):
+    """whether a decorator is a mark that skips or expects a failure, written out or by one of the module's names for one"""
+    return bool(_SWITCH.search(ast.unparse(decorator))) or _names(decorator, marks)
+
+
+def _marks_itself(n, marks):
+    """whether the statement binds pytestmark to a mark that skips"""
+    return _binds(n, "pytestmark") and bool(_SWITCH.search(ast.unparse(n.value)) or _names(n.value, marks))
+
+
+def module_switches(tree, marks=None):
+    """what can keep every test of a module from running, as [(line, kind, text)], read on the whole first level of the module.
+    The kinds: "mark", a pytestmark that skips; "call", a call that skips or a skip that is raised; "off", __test__ = False;
+    "fixture", a fixture of the module that can skip and that every test gets, unasked or by the module's own mark."""
+    marks = named_marks(tree) if marks is None else marks
+    fixtures = fixtures_that_skip(tree)
+    out = [(fn.lineno, "fixture", fn.name) for fn in tree.body
+           if isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)) and fixtures.get(fn.name)]
+    for n in _first_level(tree):
+        if isinstance(n, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
+            if _marks_itself(n, marks):
+                out.append((n.lineno, "mark", ast.unparse(n.value)))
+            elif _binds(n, "pytestmark"):
+                out += [(n.lineno, "fixture", name) for name in _used([n.value], fixtures)]
+            if _binds(n, "__test__") and ast.unparse(n.value) == "False":
+                out.append((n.lineno, "off", "__test__ = False"))
+        elif isinstance(n, ast.Call):
+            func = ast.unparse(n.func)
+            if _SKIPS_WHEN_CALLED.search(func) and not _A_MARK.search(func):
+                out.append((n.lineno, "call", ast.unparse(n)))
+    for n in tree.body:                                   # as this reader always read: a statement that is a call naming a skip in any form
+        if (isinstance(n, ast.Expr) and isinstance(n.value, ast.Call) and _SWITCH.search(ast.unparse(n.value.func))
+                and not any(line == n.lineno and kind == "call" for line, kind, _text in out)):
+            out.append((n.lineno, "call", ast.unparse(n.value)))
+    return sorted(out)
 
 
