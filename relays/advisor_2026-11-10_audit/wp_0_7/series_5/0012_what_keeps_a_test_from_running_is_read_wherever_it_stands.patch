+def test_a_test_switched_off_where_the_reader_did_not_look_turns_the_vacuity_gate_red(tmp_path):
+    for name, switch_off in _OFF_ELSEWHERE.items():
+        repo, anchor = _scratch(tmp_path / name.replace(" ", "_").replace(",", ""), _LOCKS)
+        assert _gate(repo, "test-vacuity", anchor)[0] is True
+        _commit(repo, "a test is switched off: " + name, {"tests/test_one.py": switch_off(_LOCKS["tests/test_one.py"])})
+        ok, detail = _gate(repo, "test-vacuity", anchor)
+        assert ok is False, f"a test of a lock was switched off ({name}), and the vacuity gate passed: {detail}"
+        assert "may now skip" in detail and "tests/test_one.py" in detail, (name, detail)
+    # the twins: a mark bound to a name that no test wears; a call that skips inside a helper that is not a test
+    for name, text in (("a mark nobody wears", "import pytest\n\nnot_today = pytest.mark.skip(reason='for another day')\n\n\n" + _LOCKS["tests/test_one.py"]),
+                       ("a helper", "import pytest\n\n\ndef needs_the_package():\n    pytest.importorskip('a_package_nobody_has')\n\n\n" + _LOCKS["tests/test_one.py"])):
+        repo, anchor = _scratch(tmp_path / name.replace(" ", "_"), _LOCKS)
+        _commit(repo, name, {"tests/test_one.py": text})
+        ok, detail = _gate(repo, "test-vacuity", anchor)
+        assert ok is True, (name, detail)
+
+
+def _vacuity_checker():
+    spec = importlib.util.spec_from_file_location("vacuity_checker_for_the_ledger_rule", ROOT / "scripts" / "checks" / "check_test_vacuity.py")
+    ctv = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(ctv)
+    return ctv
+
+
+def test_a_class_of_tests_marked_in_its_own_body_is_read():
+    ctv = _vacuity_checker()
+    src = "import pytest\n\n\nclass TestIt:\n    pytestmark = pytest.mark.skip(reason='planted')\n\n    def test_a(self):\n        assert sorted([2, 1])[0] == 1\n"
+    assert ctv.switches(src) == {"": 0, "TestIt.test_a": 1}, "a class's own mark, set in its body, is not counted on its tests"
+    assert ctv.switches(src.replace("    pytestmark = pytest.mark.skip(reason='planted')\n\n", "")) == {"": 0, "TestIt.test_a": 0}
+
