+    "a mark on the module under a condition": lambda t: "import pytest\n\nif True:\n    pytestmark = pytest.mark.skip(reason='planted')\n\n\n" + t,
+    "a mark bound to a name": lambda t: "import pytest\n\nnot_today = pytest.mark.skip(reason='planted')\n\n\n" + t.replace("def test_one(", "@not_today\ndef test_one("),
+    "the module told it holds no test, under a condition": lambda t: "if True:\n    __test__ = False\n\n\n" + t,
+    "a mark made by a function of the module": lambda t: ("import pytest\n\n\ndef needs(package):\n    return pytest.mark.skipif(True, reason='planted: ' + package)\n\n\n"
+                                                          + t.replace("def test_one(", "@needs('a_package')\ndef test_one(")),
+    "a fixture that skips, which the test asks for": lambda t: ("import pytest\n\n\n@pytest.fixture\ndef the_package():\n    return pytest.importorskip('a_package_nobody_has')\n\n\n"
+                                                               + t.replace("def test_one():", "def test_one(the_package):")),
+    "a fixture that skips, which every test gets": lambda t: "import pytest\n\n\n@pytest.fixture(autouse=True)\ndef _the_package():\n    pytest.skip('planted')\n\n\n" + t,
+}
