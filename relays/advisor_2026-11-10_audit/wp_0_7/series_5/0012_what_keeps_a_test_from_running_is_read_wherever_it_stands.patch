+# ---- series 5: what keeps a module's tests from running is read wherever it stands (main's M13, its third item) --------
+# The reader of a control read the first level of statements of the control's file: a mark on the module, or a call that
+# skips, each written as a statement of its own.  The same call under a condition, in an except clause or in a with, or
+# given to a name, was not read; nor was a mark bound to a name and put on the control by that name; nor a fixture of the
+# module that skips the control that asks for it; nor a module that tells the collector it holds no test.
+_ELSEWHERE = {
+    "a skip under a condition": ("import os\nimport pytest\n\nif not os.environ.get('A_VARIABLE_NOBODY_SETS'):\n    pytest.skip('planted', allow_module_level=True)\n\n\n" + _CONTROL_OK, "skip itself at import"),
+    "a skip in an except clause": ("import pytest\n\ntry:\n    import a_package_nobody_has\nexcept ImportError:\n    pytest.skip('planted', allow_module_level=True)\n\n\n" + _CONTROL_OK, "skip itself at import"),
+    "a skip in a with": ("import contextlib\nimport pytest\n\nwith contextlib.suppress(KeyError):\n    pytest.skip('planted', allow_module_level=True)\n\n\n" + _CONTROL_OK, "skip itself at import"),
+    "an importorskip given to a name": ("import pytest\n\nthe_package = pytest.importorskip('a_package_nobody_has')\n\n\n" + _CONTROL_OK, "skip itself at import"),
+    "a skip raised at import": ("import unittest\n\nraise unittest.SkipTest('planted')\n\n\n" + _CONTROL_OK, "skip itself at import"),
+    "a mark on the module under a condition": ("import pytest\n\nif True:\n    pytestmark = pytest.mark.skip(reason='planted')\n\n\n" + _CONTROL_OK, "module marked"),
+    "a mark bound to a name": ("import pytest\n\nnot_today = pytest.mark.skip(reason='planted')\n\n\n@not_today\n" + _CONTROL_OK, "is skipped"),
+    "a mark on the module by a name": ("import pytest\n\nnot_today = pytest.mark.skip(reason='planted')\npytestmark = not_today\n\n\n" + _CONTROL_OK, "module marked"),
+    "a module told it holds no test": ("__test__ = False\n\n\n" + _CONTROL_OK, "holds no test"),
+    "a mark made by a function of the module": ("import pytest\n\n\ndef needs(package):\n    return pytest.mark.skipif(True, reason='planted: ' + package)\n\n\n@needs('a_package')\n" + _CONTROL_OK, "is skipped"),
+    "a fixture that skips, which the control asks for": ("import pytest\n\n\n@pytest.fixture\ndef the_package():\n    return pytest.importorskip('a_package_nobody_has')\n\n\n"
+                                                        + _CONTROL_OK.replace("planted_case():", "planted_case(the_package):"), "a fixture it asks for"),
+    "a fixture that skips, asked for by a mark": ("import pytest\n\n\n@pytest.fixture\ndef the_package():\n    pytest.skip('planted')\n\n\n@pytest.mark.usefixtures('the_package')\n" + _CONTROL_OK, "a fixture it asks for"),
+    "a fixture that skips, which every test gets": ("import pytest\n\n\n@pytest.fixture(autouse=True)\ndef _the_package():\n    pytest.skip('planted')\n\n\n" + _CONTROL_OK, "every test may be skipped by a fixture"),
+}
+_NOT_A_SWITCH = {
+    "a mark bound to a name and not put on the control": "import pytest\n\nnot_today = pytest.mark.skip(reason='for another test')\n\n\n" + _CONTROL_OK,
+    "a call that skips inside a helper that the control does not call": "import pytest\n\n\ndef needs_the_package():\n    pytest.importorskip('a_package_nobody_has')\n\n\n" + _CONTROL_OK,
+    "a mark that is not a skip": "import pytest\n\nslow = pytest.mark.slow\n\n\n@slow\n" + _CONTROL_OK,
+    "a fixture that skips and that the control does not ask for": "import pytest\n\n\n@pytest.fixture\ndef the_package():\n    pytest.skip('for another test')\n\n\n" + _CONTROL_OK,
+    "a fixture that does not skip": "import pytest\n\n\n@pytest.fixture\ndef two():\n    return 2\n\n\n" + _CONTROL_OK.replace("planted_case():", "planted_case(two):"),
+}
+
+
+def test_a_control_kept_from_running_is_refused_wherever_the_switch_stands(tmp_path):
+    for name, (body, words) in _ELSEWHERE.items():
+        repo, reg = _controls_repo(tmp_path, name.replace(" ", "_"), body)
+        ok, detail = _gate(repo, "gate-controls")
+        assert ok is False, f"a control that is kept from running ({name}) passed the controls gate: {detail}"
+        assert words in detail, (name, detail)
+    for name, body in _NOT_A_SWITCH.items():                                                # the twins
+        repo, reg = _controls_repo(tmp_path, name.replace(" ", "_"), body)
+        ok, detail = _gate(repo, "gate-controls")
+        assert ok is True, (name, detail)
+
