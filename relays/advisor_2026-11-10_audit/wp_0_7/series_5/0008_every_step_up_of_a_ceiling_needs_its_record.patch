+# EVERY STEP UP OF A CEILING NEEDS ITS RECORD (WP-0.7, series 5; main's register row P-816, found by main reading series 2).
+# The rule above compares two states: the table at the anchor and the table now.  A ceiling taken down and then put back up
+# to where it stood is no higher now than at the anchor, and the step up was read by nothing.  A ceiling is now read along
+# main's own line from the anchor: every state the file has stood in, in order, and the file as it is on the disk last.
+# Each step up of an entry, from one state to the next, needs a record of its own: one text under the entry's name pays for
+# one step, and a list of texts for as many.  WHAT THAT COSTS: a step that stands in a commit is not taken back by lowering
+# the ceiling in a later commit.  It is in the history, and it is recorded (the record can say that it was a mistake and
+# where it was undone).  A step that is in no commit yet can still be lowered again, and the gate's sentence says which.
+def states_since(path, anchor=None, repo=None):
+    """the file at `path` as it stood at the anchor and after each later commit of main's own line that left it changed,
+    oldest first: ([(the commit's first nine characters, the text)], None), the text None where the file was not there; or
+    (None, why the history cannot be read).  Three calls of git, whatever the length of the history."""
+    anchor = anchor or NOTHING_LEAVES_FROM
+    git, why = _since_the_anchor(anchor, repo)
+    if why:
+        return None, why
+    cannot = f"cannot verify: the history of {path} since {anchor[:9]} could not be read in this clone"
+    line = git("rev-list", "--first-parent", "--reverse", f"{anchor}..HEAD")
+    if line.returncode != 0:
+        return None, cannot
+    commits = [anchor] + line.stdout.split()
+    ask = lambda mode, names: subprocess.run(["git", "-C", str(repo or ROOT), "cat-file", mode], input="".join(n + "\n" for n in names).encode(),
+                                             capture_output=True, timeout=180)
+    asked = ask("--batch-check", [f"{c}:{path}" for c in commits])
+    answers = asked.stdout.decode("utf-8", "replace").splitlines()
+    if asked.returncode != 0 or len(answers) != len(commits):
+        return None, cannot
+    states, last = [], None                                               # [(commit, blob)], one for each change of the file
+    for c, answer in zip(commits, answers):
+        m = re.fullmatch(r"([0-9a-f]{40,64}) blob \d+", answer)
+        blob = m.group(1) if m else ""                                    # "" where no file stood at that path in that commit
+        if not states or blob != last:
+            states.append((c[:9], blob))
+        last = blob
+    blobs = sorted({b for _c, b in states if b})
+    texts, got = {}, ask("--batch", blobs).stdout if blobs else b""
+    for b in blobs:                                                       # "<id> blob <size>" on a line, the bytes, a line break
+        head, _, got = got.partition(b"\n")
+        m = re.fullmatch(rb"([0-9a-f]{40,64}) blob (\d+)", head)
+        if not m or m.group(1).decode() != b or len(got) < int(m.group(2)):
+            return None, cannot
+        texts[b], got = got[:int(m.group(2))].decode("utf-8", "replace"), got[int(m.group(2)) + 1:]
+    return [(c, texts[b] if b else None) for c, b in states], None
+
+
+def _records(named, entry):
+    """the records `named` holds for `entry`: a text is one record, a list holds as many as its texts that say something"""
+    got = named.get(entry)
+    got = [got] if isinstance(got, str) else (list(got) if isinstance(got, (list, tuple)) else [])
+    return [str(r).strip() for r in got if str(r).strip()]
+
+
+THE_DISK = "the files as they are, in no commit yet"
+
+
