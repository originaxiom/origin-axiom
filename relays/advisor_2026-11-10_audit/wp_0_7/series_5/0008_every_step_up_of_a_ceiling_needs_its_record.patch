+            + "; ".join(f"{k} ({'; '.join(_records(named, k))})" for k in by_name[:4])) if by_name else ""
     if loose:
+        short = [k for k in loose if _records(named, k)]
         return (f"{len(loose)} ceiling(s) in {path} rose since {since} with no record: "
-                + "; ".join(f"{k} {count(then.get(k))} -> {count(now[k])}" for k in loose[:4])
-                + ". A ceiling does not rise without a recorded act: lower it again, or name it in RAISED_BY_NAME with its date and why"), note
+                + "; ".join(f"{k} {said(steps[k])}" + (f" ({len(steps[k])} steps up, {len(_records(named, k))} recorded)" if k in short else "")
+                            for k in loose[:4])
+                + ". A ceiling does not rise without a recorded act: name it in RAISED_BY_NAME with its date and why, one record for "
+                  "each step up (a list of them where an entry rose more than once). A step that is in no commit yet can be lowered "
+                  "again; one that stands in a commit is not taken back by lowering the ceiling after it"), note
     return None, note
 
 
