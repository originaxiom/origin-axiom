+def baseline_rise_along(states, since="the anchor"):
+    """the same rule, read along the history (series 5; main's register row P-816).  `states`: [(where, the ratchet's file)]
+    in each state it has stood in since the anchor, oldest first, the file as it is now last; the file None where it could
+    not be read.  The rule of two ends is asked first, as before.  Then every step up from one state to the next is added
+    up, and the raises recorded since the anchor must account for the whole: a baseline taken down and put back up has
+    risen, and each time it is put back up is a raise.  Returns (problem, note)."""
+    then, now = states[0][1], states[-1][1]
+    problem, note = baseline_rise(now, then, since)
+    if problem or not isinstance(then, dict):
+        return problem, note
+    count = lambda t: t.get("unearned") if isinstance(t, dict) else None
+    read = [(w, count(t)) for w, t in states if isinstance(count(t), int) and not isinstance(count(t), bool)]
+    ups = [(a, b, w) for (_w, a), (w, b) in zip(read, read[1:]) if b > a]
+    new = (now.get("_baseline_raises") or [])[len(then.get("_baseline_raises") or []):]
+    recorded, rose = sum(e["to"] - e["from"] for e in new), sum(b - a for a, b, _w in ups)
+    if rose > recorded:
+        return (f"the baseline rose since {since}, step by step, by {rose} in all ("
+                + ", then ".join(f"{a} -> {b} in {w}" for a, b, w in ups[:6]) + f"), and the raises recorded since then account for {recorded}. "
+                "A ceiling does not rise without a recorded act, and one taken down and put back up has risen: add each raise to "
+                "_baseline_raises with its date and its reason. A step that stands in a commit is not taken back by lowering the "
+                "baseline after it"), ""
+    return None, note
+
