+def names_in_table(src, table, kind="name"):
+    """the names the table held in a source as it stood in some commit.  The one statement that binds it at the top level is
+    found by its first line and parsed alone, so that reading every state of a long file costs little.  None where the
+    source does not bind the table once, or binds it to anything but a plain table: such a state is passed over."""
+    if src is None:
+        return None
+    at = [m.start() for m in re.finditer(r"(?m)^%s[ \t]*(?::[^=\n]*)?=(?!=)" % re.escape(table), src)]
+    if len(at) != 1:
+        return None
+    lines = src[at[0]:].split("\n")
+    end = 1
+    while end < len(lines) and (not lines[end].strip() or lines[end][0] in " \t)]}#"):
+        end += 1
+    try:
+        body = ast.parse("\n".join(lines[:end])).body
+    except (SyntaxError, ValueError):
+        return None
+    if len(body) != 1 or not isinstance(body[0], (ast.Assign, ast.AnnAssign)) or body[0].value is None:
+        return None
+    return _names_of_node(body[0].value, kind)
+
