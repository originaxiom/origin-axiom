+def _the_statement(src, table):
+    binds = [n for n in ast.parse(src).body if isinstance(n, ast.Assign) and [getattr(t, "id", None) for t in n.targets] == [table]]
+    assert len(binds) == 1, "%s is bound %d time(s) at the top level" % (table, len(binds))
+    return binds[0]
+
+
+def _one_more_in(repo, path, table, name):
+    """the statement that binds `table` in the small repository's `path`, written again with `name` added to what it holds"""
+    p = repo / path
+    src = p.read_text(encoding="utf-8")
+    node = _the_statement(src, table)
+    v, call = node.value, None
+    if isinstance(v, ast.Call):
+        call, v = v.func.id, (v.args[0] if v.args else ast.Tuple(elts=[], ctx=ast.Load()))
+    held = ast.literal_eval(v)
+    more = dict(held, **{name: "planted"}) if isinstance(held, dict) else type(held)(list(held) + [name])
+    lines = src.splitlines(keepends=True)
+    lines[node.lineno - 1:node.end_lineno] = ["%s = %s\n" % (table, "%s(%r)" % (call, more) if call else repr(more))]
+    p.write_text("".join(lines), encoding="utf-8")
+
+
+def _record_that_it_entered(repo, table, name, record):
+    """a record added to whatever the small repository's gates already hold in ENTERED_BY_NAME"""
+    p = repo / "scripts" / "gates" / "gates.py"
+    src = p.read_text(encoding="utf-8")
+    lines = src.splitlines(keepends=True)
+    lines.insert(_the_statement(src, "ENTERED_BY_NAME").end_lineno,
+                 "ENTERED_BY_NAME = {**ENTERED_BY_NAME, %r: {**ENTERED_BY_NAME.get(%r, {}), %r: %r}}\n" % (table, table, name, record))
+    p.write_text("".join(lines), encoding="utf-8")
+
+
+_GATES_FILE = "scripts/gates/gates.py"
+_TABLES_OF_THE_GATES = ("CANNOT_FAIL_AS_FOUND", "PRINTED_FLOAT_AS_FOUND", "MEMBER_SCOPE_AS_FOUND", "CITES_NO_LOCK_AS_FOUND", "FRAMING_EXEMPT")
+
+
+def _a_table_of_the_gates():
+    """the first of the gates' own tables of names that is still bound there (a table may be mended to nothing and taken out)"""
+    src = (ROOT / _GATES_FILE).read_text(encoding="utf-8")
+    bound = [t for t in _TABLES_OF_THE_GATES if any(isinstance(n, ast.Assign) and [getattr(x, "id", None) for x in n.targets] == [t] for n in ast.parse(src).body)]
+    assert bound, "none of the gates' tables of names is bound any more: this lock needs one to plant in"
+    return bound[0]
+
