+def _module_at(path):
+    spec = importlib.util.spec_from_file_location("held_tables_of_" + path.stem, path)
+    m = importlib.util.module_from_spec(spec)
+    sys.path.insert(0, str(path.parent))
+    try:
+        spec.loader.exec_module(m)
+    finally:
+        sys.path.pop(0)
+    return m
