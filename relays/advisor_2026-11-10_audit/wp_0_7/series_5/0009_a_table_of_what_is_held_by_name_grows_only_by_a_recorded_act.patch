+def test_a_name_added_as_the_gates_are_loaded_fails_the_controls_gate(tmp_path):
+    """the table is written as it was, and one line at the end of the file changes it in memory through the module's own
+    dictionary: no statement binds the name twice, so only what the gate holds in memory can show it"""
+    table = _a_table_of_the_gates()
+    repo, _reg = _controls_repo(tmp_path, "memory", _CONTROL_OK)
+    assert _gate(repo, "gate-controls")[0] is True
+    p = repo / _GATES_FILE
+    src = p.read_text(encoding="utf-8")
+    at = src.index('\nif __name__ == "__main__":')
+    plant = '\nglobals()[%r] = type(globals()[%r])(list(globals()[%r]) + ["planted/in_memory"])\n' % (table, table, table)
+    p.write_text(src[:at] + plant + src[at:], encoding="utf-8")
+    _commit(repo, "a name added in memory")
+    ok, detail = _gate(repo, "gate-controls")
