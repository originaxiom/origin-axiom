+# ---- series 5: a table of what is held by name grows only by a recorded act (main's request of 2026-11-12) ---------------
+# When a rule comes, what already breaks it is held by name in a table beside the rule, "as found".  Each such table "may
+# only shrink": a comment said so, and here and there a count in a lock.  A name added to one excuses what its rule was
+# made to refuse, and nothing read the table's history.  The controls gate now reads each of them along main's own line: a
+# name that enters after the table first stood needs its record, and the table is read as it is written, in one statement.
+_HELD = "held.py"
+_TWO = 'T_AS_FOUND = frozenset((          # two, as found\n    "a::one",\n    "b::two",\n))\n'
+
+
+def _a_held_table(tmp_path, first=_TWO):
+    """a small repository with one file that binds a table of names, and its first commit"""
+    repo = tmp_path / "small"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    return repo, _commit(repo, "the table as it first stood", {_HELD: first})
+
+
+def _growth(g, repo, anchor, named=None, tables=None):
+    return g.held_tables_growth(anchor, repo, named or {}, tables or {"T_AS_FOUND": (_HELD, "name")})
+
+
+def test_a_name_that_enters_a_held_table_needs_its_record(tmp_path):
+    g = _gates()
+    repo, anchor = _a_held_table(tmp_path)
+    assert _growth(g, repo, anchor) == ([], "")
+    _commit(repo, "one mended and taken out", {_HELD: 'T_AS_FOUND = frozenset(("b::two",))\n'})
+    assert _growth(g, repo, anchor) == ([], "")                                            # the twin: a table shortens freely
+    added = _commit(repo, "a name added, no record", {_HELD: 'T_AS_FOUND = frozenset(("b::two", "c::three"))\n'})
+    problems, _ = _growth(g, repo, anchor)
+    assert problems, "a name was added to a table held by name with no record, and the rule reads nothing"
+    assert len(problems) == 1 and "1 name(s) entered T_AS_FOUND" in problems[0] and "c::three in " + added[:9] in problems[0], problems
+    # taken out again after the commit: the step stands in the history, and is recorded
+    (repo / _HELD).write_text('T_AS_FOUND = frozenset(("b::two",))\n', encoding="utf-8")
+    assert "c::three in " + added[:9] in _growth(g, repo, anchor)[0][0]
+    one = {"T_AS_FOUND": {"c::three": "2026-11-12 -- a new shape of the class, found by a wider reader"}}
+    problems, note = _growth(g, repo, anchor, one)
