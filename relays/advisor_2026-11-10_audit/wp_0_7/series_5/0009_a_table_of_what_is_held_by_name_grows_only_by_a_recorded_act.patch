+def table_as_written(src, table, kind="name", parsed=None):
+    """the names the table holds in the file as it is now, read strictly: (names, None), or (None, why it cannot be read).
+    The whole file is parsed (`parsed`: the tree and what it binds, where the caller reads several tables of one file).  One
+    plain statement at the top level binds the table; nothing else in the file binds its name (a second statement, a
+    statement that widens it, a parameter or a local name that would stand in its place where it is read) and nothing
+    changes it in place."""
+    if parsed is None:
+        try:
+            tree = ast.parse(src)
+        except (SyntaxError, ValueError) as exc:
+            return None, f"its file cannot be parsed ({type(exc).__name__}, line {getattr(exc, 'lineno', '?')})"
+        parsed = (tree, _bound_in(tree))
+    tree, bound = parsed
+    binds = [n for n in tree.body
+             if (isinstance(n, ast.Assign) and len(n.targets) == 1 and getattr(n.targets[0], "id", None) == table)
+             or (isinstance(n, ast.AnnAssign) and getattr(n.target, "id", None) == table and n.value is not None)]
+    if len(binds) != 1:
+        return None, f"{len(binds)} plain statement(s) at the top level of the file bind it, where one must"
