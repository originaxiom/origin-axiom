+    again = sorted({getattr(n, "lineno", 0) for n in bound.get(table, []) if n is not own})
+    if again:
+        return None, f"its name is bound again, or the table is changed in place, at line(s) {', '.join(map(str, again[:6]))} of the file"
+    names = _names_of_node(binds[0].value, kind)
+    if names is None:
+        return None, "it is bound to something other than a plain table written out"
+    return names, None
