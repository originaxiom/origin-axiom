+    (repo / _HELD).write_text('T_AS_FOUND = frozenset(("a::one", "b::two", "c::three"))\n', encoding="utf-8")
+    assert _growth(g, repo, anchor, both)[0] == []
+    assert "cannot verify" in _growth(g, repo, "0" * 40, both)[0][0]
