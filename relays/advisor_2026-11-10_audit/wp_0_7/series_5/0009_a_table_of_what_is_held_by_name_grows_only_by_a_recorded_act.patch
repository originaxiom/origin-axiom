+def test_a_name_added_by_a_second_statement_is_refused(tmp_path):
+    g = _gates()
+    repo, anchor = _a_held_table(tmp_path, 'T_AS_FOUND = frozenset(("a::one",))\nD_AS_FOUND = {"a": "what it is"}\nMORE = ("z::planted",)\n')
+    tables = {"T_AS_FOUND": (_HELD, "name"), "D_AS_FOUND": (_HELD, "name")}
+    first = (repo / _HELD).read_text(encoding="utf-8")
+    assert _growth(g, repo, anchor, tables=tables) == ([], "")
+    # the twin: the table read by other statements, and a line that only looks like one that changes it
+    (repo / _HELD).write_text(first + 'def reads(found):\n    return found in T_AS_FOUND and len(D_AS_FOUND) > 0 and D_AS_FOUND.get(found)\n', encoding="utf-8")
+    assert _growth(g, repo, anchor, tables=tables) == ([], "")
+    for more in ('T_AS_FOUND = T_AS_FOUND | {"z::planted"}\n',                             # bound a second time
+                 'T_AS_FOUND |= {"z::planted"}\n',                                         # widened in place
+                 'if True:\n    T_AS_FOUND = frozenset(MORE)\n',                           # bound again under a condition
+                 'def widen():\n    global T_AS_FOUND\n    T_AS_FOUND = T_AS_FOUND | set(MORE)\n',
+                 'def reads(found, T_AS_FOUND=frozenset(("a::one", "z::planted"))):\n    return found in T_AS_FOUND\n',   # another table under its name
+                 'def reads(found):\n    T_AS_FOUND = frozenset(MORE)\n    return found in T_AS_FOUND\n',
+                 'for T_AS_FOUND in (frozenset(MORE),):\n    pass\n',
+                 'D_AS_FOUND["z::planted"] = "planted"\n',
+                 'D_AS_FOUND.update({"z::planted": "planted"})\n',
+                 'D_AS_FOUND.setdefault("z::planted", "planted")\n'):
+        (repo / _HELD).write_text(first + more, encoding="utf-8")
+        problems, _ = _growth(g, repo, anchor, tables=tables)
+        assert len(problems) == 1 and "cannot be read in held.py" in problems[0], (more, problems)
+    # a table that is not written out: its names cannot be read, so nothing could say whether one entered
+    for bound in ('T_AS_FOUND = frozenset(("a::one",)) | frozenset(MORE)\n', 'T_AS_FOUND = frozenset(("a::one",) + MORE)\n',
+                  'T_AS_FOUND = frozenset(n for n in ("a::one", "z::planted"))\n', 'T_AS_FOUND = frozenset(("a::one",), *MORE)\n'):
+        (repo / _HELD).write_text(first.replace('T_AS_FOUND = frozenset(("a::one",))\n', bound), encoding="utf-8")
+        problems, _ = _growth(g, repo, anchor, tables=tables)
+        assert len(problems) == 1 and "T_AS_FOUND cannot be read in held.py" in problems[0], (bound, problems)
