+    both = {"T_AS_FOUND": dict(two["T_AS_FOUND"], **{"c::three": ["2026-11-12 -- a new shape of the class", "2026-11-13 -- and once more"]})}
+    assert _growth(g, repo, anchor, both)[0] == []
+    # a name that is in no commit yet is the last state, and can be taken out again
