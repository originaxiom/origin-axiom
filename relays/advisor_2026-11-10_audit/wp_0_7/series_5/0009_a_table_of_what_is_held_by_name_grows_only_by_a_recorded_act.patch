+def _bound_in(tree):
+    """name -> the nodes of the tree that bind it, or that change in place what it names: one walk for every name"""
+    out = collections.defaultdict(list)
+    for n in ast.walk(tree):
+        kind_of = type(n).__name__
+        if isinstance(n, ast.Name):
+            if isinstance(n.ctx, (ast.Store, ast.Del)):
+                out[n.id].append(n)                                       # bound, widened in place, a loop's or a with's name, deleted
+        elif isinstance(n, (ast.Global, ast.Nonlocal)):
+            for name in n.names:
+                out[name].append(n)
+        elif isinstance(n, ast.arg):
+            out[n.arg].append(n)                                          # a parameter of that name stands in the table's place
+        elif isinstance(n, ast.alias):
+            out[n.asname or n.name].append(n)
+        elif kind_of in ("ExceptHandler", "FunctionDef", "AsyncFunctionDef", "ClassDef", "MatchAs", "MatchStar"):
+            if isinstance(getattr(n, "name", None), str):
+                out[n.name].append(n)
+        elif kind_of == "MatchMapping":
+            if getattr(n, "rest", None):
+                out[n.rest].append(n)
+        elif isinstance(n, ast.Subscript):
+            if isinstance(n.ctx, (ast.Store, ast.Del)) and isinstance(n.value, ast.Name):
+                out[n.value.id].append(n)                                 # an entry set or deleted
+        elif isinstance(n, ast.Call):
+            if isinstance(n.func, ast.Attribute) and isinstance(n.func.value, ast.Name) and n.func.attr in _CHANGES_IN_PLACE:
+                out[n.func.value.id].append(n)
+    return out
+
