+def _names_of(value, kind="name"):
+    """the names a table holds, as texts: its members, or a dictionary's keys (kind "pair": each key with what it is held for).
+    A member that is a tuple of texts is written "one :: two".  None where the value is no table."""
+    text = lambda e: e if isinstance(e, str) else (" :: ".join(text(x) for x in e) if isinstance(e, tuple) else repr(e))
+    if isinstance(value, dict):
+        return {f"{text(k)} -> {text(v)}" if kind == "pair" else text(k) for k, v in value.items()}
+    return {text(e) for e in value} if isinstance(value, (set, frozenset, tuple, list)) else None
