+    two = {"T_AS_FOUND": dict(one["T_AS_FOUND"], **{"a::one": "2026-11-12 -- the test was restored as it stood"})}
+    assert _growth(g, repo, anchor, two)[0] == []
+    # out and in a second time: one record does not pay for two entries, two records do
