+def _names_of_node(v, kind):
+    """the same, of the expression a statement binds a table to: a set, a tuple, a list or a dictionary written out, or one of
+    those given to frozenset, set, tuple or list.  Anything else is None: it cannot be read without running it."""
+    if isinstance(v, ast.Call) and isinstance(v.func, ast.Name) and v.func.id in ("frozenset", "set", "tuple", "list") and not v.keywords and len(v.args) <= 1:
