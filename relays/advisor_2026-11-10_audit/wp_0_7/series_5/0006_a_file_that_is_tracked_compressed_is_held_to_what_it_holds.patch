+# ---- series 5: a file that is tracked compressed is held to what it holds (main's M9; Review 79's second round) ------------
+# The census of one arc is tracked compressed, and its list records the hash of what the compressed file holds, under the
+# name the content has when it is unpacked.  No tracked file has that name, so the entry stood as one that names no tracked
+# file, frozen in that state, and the compressed file could be replaced unseen.
+def _packed(data, how):
+    import bz2, gzip, lzma
+    return {".gz": gzip.compress, ".bz2": bz2.compress, ".xz": lzma.compress}[how](data)
+
+
+_CENSUS = b'{"n": 5, "count": 12}\n{"n": 7, "count": 30}\n'
+
+
+def _a_seal_with_a_packed_census(tmp_path, how=".gz", content=_CENSUS):
+    more = {_SEAL_ARC + "/verification/census.jsonl" + how: _packed(content, how),
+            _SEAL_ARC + "/verification/census.jsonl.sha256": "%s  census.jsonl\n" % _sha(_CENSUS)}
+    repo, root = _a_seal(tmp_path, more)
+    key = next(e[0] for e in _gates().hash_list_state(str(repo)) if e[1].endswith("census.jsonl.sha256"))
+    return repo, root, key
+
+
+def test_a_file_tracked_compressed_is_held_to_what_it_holds(tmp_path):
+    for how in (".gz", ".bz2", ".xz"):
+        repo, root, key = _a_seal_with_a_packed_census(tmp_path / how.strip("."), how)
+        frozen = {key: "N"}                                  # as the entry stands on main: frozen as naming no tracked file
+        assert _the_hash_gate(repo, root, frozen)[0] is True
+        # the twin: the same content packed again, with other bytes
+        again = _packed(_CENSUS, how) if how != ".gz" else __import__("gzip").compress(_CENSUS, compresslevel=1, mtime=1)
+        _commit(repo, "the census packed again, the same content", {_SEAL_ARC + "/verification/census.jsonl" + how: again})
+        assert _the_hash_gate(repo, root, frozen)[0] is True, how
+        # the case, as main planted it: the content replaced
+        _commit(repo, "the census replaced", {_SEAL_ARC + "/verification/census.jsonl" + how: _packed(b'{"a census": "that is not the census"}\n', how)})
+        ok, detail = _the_hash_gate(repo, root, frozen)
+        assert ok is False, "the content of a file that is tracked compressed (%s) was replaced, and the gate on the hash lists passed: %s" % (how, detail[:200])
+        assert "census.jsonl" in detail, detail
+
+
+def test_a_compressed_file_that_cannot_be_opened_or_does_not_end_fails_the_gate(tmp_path):
+    g = _gates()
+    repo, root, key = _a_seal_with_a_packed_census(tmp_path / "broken")
+    _commit(repo, "not a compressed file under that name", {_SEAL_ARC + "/verification/census.jsonl.gz": b"these bytes are no gzip stream\n"})
+    ok, detail = _the_hash_gate(repo, root, {key: "N"})
+    assert ok is False and "census.jsonl" in detail, "a file that cannot be opened as its name says, and the gate reads: " + detail[:200]
+    # a file that unpacks to more than the gate will read is not hashed in part, and does not pass
+    repo, root, key = _a_seal_with_a_packed_census(tmp_path / "long", content=_CENSUS)
+    limit = getattr(g, "HASH_PACKED_MAX_BYTES", None)
+    assert limit, "the gates set no bound on what a compressed file may unpack to"
+    states = lambda: [(e[3], e[4]) for e in g.hash_list_state(str(repo)) if e[0] == key]
+    assert states() == [("VERIFIES", "V")]
+    g.HASH_PACKED_MAX_BYTES = len(_CENSUS) - 1
+    try:
+        assert states()[0][0] == "UNREADABLE", states()
+    finally:
+        g.HASH_PACKED_MAX_BYTES = limit
+
+
+def test_on_this_repository_the_one_file_tracked_compressed_verifies():
+    g = _gates()
+    state = g.hash_list_state()
+    packed = [e for e in state if e[2] and e[2].endswith((".gz", ".bz2", ".xz")) and e[1].endswith("census.jsonl.sha256")]
+    assert [(e[2], e[3]) for e in packed] == [("frontier/B1786_the_slope_principle_out_of_sample/verification/census.jsonl.gz", "VERIFIES")], packed
+    ok, detail = g.gate_artifact_hashes()
+    assert ok is True and "shorten the table" not in detail, detail
+    # its key is taken out of the table of what does not verify, in the patch that makes it verify: the table may only shorten
+    assert "c4a1d81e5613" not in g.hash_lists_frozen() and all(e[0] != "c4a1d81e5613" for e in state if e[3] != "VERIFIES")
