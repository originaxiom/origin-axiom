+# A FILE THAT IS TRACKED COMPRESSED IS HELD TO WHAT IT HOLDS (WP-0.7, series 5; main's M9, from the second round of Review 79).
+# One arc's census is tracked compressed, and its list records the hash of the content under the name the content has when it
+# is unpacked.  No tracked file has that name, so the entry stood as one that names no tracked file, frozen in that state, and
+# the compressed file could be replaced unseen.  Where a list names no tracked file and one file is tracked under that name
+# with a suffix below, the entry is held to what that file holds: it is unpacked as it is read, and what comes out is hashed.
+HASH_PACKED = (".gz", ".bz2", ".xz")
+HASH_PACKED_MAX_BYTES = 2 ** 30            # a file that unpacks to more than this is not hashed in part: it fails, and the gate does not hang
+
+
+def _sha256_of_what_is_packed(path):
+    """(the sha256 of what the compressed file at `path` holds, None), or (None, why it could not be read)"""
+    import bz2, gzip, lzma, zlib
+    opener = {".gz": gzip.open, ".bz2": bz2.open, ".xz": lzma.open}[os.path.splitext(path)[1].lower()]
+    h, n = hashlib.sha256(), 0
+    try:
+        with opener(path, "rb") as fh:
+            while True:
+                block = fh.read(1 << 20)
+                if not block:
+                    break
+                n += len(block)
+                if n > HASH_PACKED_MAX_BYTES:
+                    return None, "unpacks to more than %d bytes" % HASH_PACKED_MAX_BYTES
+                h.update(block)
+    except (OSError, EOFError, lzma.LZMAError, zlib.error) as exc:
+        return None, "cannot be unpacked (%s)" % type(exc).__name__
+    return h.hexdigest(), None
+
+
 def hash_list_state(repo=None, _resolved=None):
     """Every entry of every tracked list of hashed files under `repo`, whatever the list is called: a list of
     (key, list path, file or name, state, signature), or None where the tracked files cannot be listed.  state is VERIFIES,
@@ -2292,6 +2322,17 @@ def hash_list_state(repo=None, _resolved=None):
                 if c in tracked and c not in cands:
                     cands.append(c)
             if not cands:
+                packed = list(dict.fromkeys(c + sfx for c in every for sfx in HASH_PACKED if c + sfx in tracked))
+                if len(packed) == 1:                     # the named file is tracked compressed: held to what it holds
+                    now, why = _sha256_of_what_is_packed(os.path.join(repo, packed[0]))
+                    if now is None:
+                        out.append((key, lst, packed[0], "UNREADABLE", "U:%s %s" % (packed[0], why)))
+                    else:
+                        out.append((key, lst, packed[0], "VERIFIES" if now == h else "MISMATCH", "V" if now == h else "M:" + now[:16]))
+                    continue
+                if len(packed) > 1:
+                    out.append((key, lst, name, "AMBIGUOUS", "A:" + " or ".join(packed)))
+                    continue
                 on_disk = any(os.path.exists(os.path.join(repo, c)) for c in every)
                 out.append((key, lst, name, "NOT TRACKED" if on_disk else "ABSENT", "N"))
                 continue
