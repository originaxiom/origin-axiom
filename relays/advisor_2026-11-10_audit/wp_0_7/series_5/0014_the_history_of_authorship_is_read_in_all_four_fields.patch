+
+
+# ---- series 5: the history of authorship is read in all four fields (Review 79, the second reader's row 25, its second part) ----
+# The rule is main's (its M11): not a list of names.  After the commit the rule is read from, the history holds one identity, the
+# repository's own, as author and as committer.  The vendor tokens are looked for in all four fields.
+
+_ITS_OWN = ("originaxiom", "the-repository@example.invalid")
+_A_VENDOR = "".join(["an", "thro", "pic"])            # spelt in pieces: the gate bans the word from tracked files
+
+
+def _a_history(tmp_path, name="h"):
+    repo = tmp_path / name
+    repo.mkdir()
+    subprocess.run(["git", "-C", str(repo), "init", "-q", "-b", "main"], check=True, capture_output=True)
+    return repo, _a_commit_by(repo, "the commit the rule is read from")
+
+
+def _a_commit_by(repo, message, author=_ITS_OWN, committer=_ITS_OWN, merge=None):
+    env = dict(__import__("os").environ, GIT_AUTHOR_NAME=author[0], GIT_AUTHOR_EMAIL=author[1], GIT_COMMITTER_NAME=committer[0], GIT_COMMITTER_EMAIL=committer[1])
+    f = repo / "a.txt"
+    f.write_text((f.read_text(encoding="utf-8") if f.exists() else "") + message + "\n", encoding="utf-8")
+    for a in (("add", "a.txt"), ("commit", "-q", "-m", message)):
+        r = subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True, env=env)
+        assert r.returncode == 0, r.stderr
+    return _git(repo, "rev-parse", "HEAD")
+
+
+def _as_it_was_read_before(repo, root):
+    """the reading that stood before series 5: the author's name, of every commit after the root"""
+    return [n for n in _git(repo, "log", "--format=%an", root + "..HEAD").split("\n") if n != "originaxiom"]
+
+
+def test_a_commit_is_held_to_the_repositorys_identity_in_all_four_fields(tmp_path):
+    g = _gates()
+    cases = (       # (what differs, the author, the committer, what the gate says)
+        ("the committer's name", _ITS_OWN, ("a web merge", _ITS_OWN[1]), "committed by 'a web merge', not originaxiom"),
+        ("the author's address", ("originaxiom", "someone@example.invalid"), _ITS_OWN, "authored under another address than the repository's own"),
+        ("the committer's address", _ITS_OWN, ("originaxiom", "someone@example.invalid"), "committed under another address than the repository's own"),
+        ("both of the committer's", _ITS_OWN, ("somebody else", "someone@example.invalid"), "committed by 'somebody else', not originaxiom"))
+    for n, (what, author, committer, says) in enumerate(cases):
+        repo, root = _a_history(tmp_path, "h%d" % n)
+        _a_commit_by(repo, "a clean landing")
+        bad = _a_commit_by(repo, "a landing in plain words", author, committer)
+        _a_commit_by(repo, "another clean landing")
+        assert _as_it_was_read_before(repo, root) == [], what          # the author's name is the repository's: before series 5 nothing was reported
+        problems, read = g.attribution_history_problems(repo, root)
+        assert read == 3 and problems == ["%s: %s" % (bad[:9], says)], (what, problems)
+        assert "example.invalid" not in " ".join(problems), "an address is printed: " + what
+
+
+def test_a_vendor_token_in_a_name_or_an_address_is_refused(tmp_path):
+    g = _gates()
+    for n, (author, committer, where) in enumerate((
+            (("originaxiom", "noreply@%s.com" % _A_VENDOR), _ITS_OWN, "the author's address"),
+            (_ITS_OWN, ("originaxiom", "noreply@%s.com" % _A_VENDOR), "the committer's address"),
+            (_ITS_OWN, (_A_VENDOR.capitalize() + " Tool", _ITS_OWN[1]), "the committer's name"))):
+        repo, root = _a_history(tmp_path, "v%d" % n)
+        bad = _a_commit_by(repo, "a landing in plain words", author, committer)
+        assert _as_it_was_read_before(repo, root) == []
+        problems, read = g.attribution_history_problems(repo, root)
+        assert read == 1 and "%s: a vendor token in %s" % (bad[:9], where) in problems and len(problems) == 2, problems
+
+
+def test_a_foreign_committer_on_a_commit_that_arrives_by_a_merge_is_refused(tmp_path):
+    g = _gates()
+    repo, root = _a_history(tmp_path)
+    _git(repo, "checkout", "-q", "-b", "side")
+    side = _a_commit_by(repo, "side work, in plain words", _ITS_OWN, ("somebody else", _ITS_OWN[1]))
+    _git(repo, "checkout", "-q", "main")
+    env = dict(__import__("os").environ, GIT_AUTHOR_NAME=_ITS_OWN[0], GIT_AUTHOR_EMAIL=_ITS_OWN[1], GIT_COMMITTER_NAME=_ITS_OWN[0], GIT_COMMITTER_EMAIL=_ITS_OWN[1])
+    r = subprocess.run(["git", "-C", str(repo), "merge", "-q", "--no-ff", "-m", "a merge with a clean message", "side"], capture_output=True, text=True, env=env)
+    assert r.returncode == 0, r.stderr
+    problems, read = g.attribution_history_problems(repo, root)
+    assert read == 2 and problems == ["%s: committed by 'somebody else', not originaxiom" % side[:9]], problems
+
+
+def test_the_one_identity_passes_and_a_name_that_is_not_text_does_not_stop_the_gate(tmp_path):
+    g = _gates()
+    repo, root = _a_history(tmp_path)
+    for n in range(3):
+        _a_commit_by(repo, "landing %d" % n)
+    assert g.attribution_history_problems(repo, root) == ([], 3)                     # the twin: one identity in all four fields
+    env = dict(__import__("os").environ, GIT_AUTHOR_NAME=_ITS_OWN[0], GIT_AUTHOR_EMAIL=_ITS_OWN[1], GIT_COMMITTER_EMAIL=_ITS_OWN[1])
+    envb = {k.encode(): v.encode() for k, v in env.items()}
+    envb[b"GIT_COMMITTER_NAME"] = b"origin\xe9axiom"                                # a name in another encoding than UTF-8
+    (repo / "a.txt").write_text("more\n", encoding="utf-8")
+    for a in (("add", "a.txt"), ("commit", "-q", "-m", "a landing")):
+        assert subprocess.run([b"git", b"-C", str(repo).encode(), *[x.encode() for x in a]], capture_output=True, env=envb).returncode == 0
+    problems, read = g.attribution_history_problems(repo, root)
+    assert read == 4 and len(problems) == 1 and "committed by" in problems[0], problems
+
+
+def test_on_this_repository_one_identity_stands_in_all_four_fields_since_the_rules_commit():
+    g = _gates()
+    problems, read = g.attribution_history_problems(ROOT, g.ATTRIBUTION_FROM)
+    assert problems == [] and read >= 695, problems
+    an, ae, cn, ce = _git(ROOT, "log", "-1", "--format=%an%x00%ae%x00%cn%x00%ce", g.ATTRIBUTION_FROM).split("\x00")
+    assert an == cn == "originaxiom" and ae == ce and ae.endswith("@users.noreply.github.com"), "the commit the rule is read from does not carry one identity"
+    ok, why = g.gate_attribution()
+    assert ok is True and "as author and as committer, under one address" in why, why
