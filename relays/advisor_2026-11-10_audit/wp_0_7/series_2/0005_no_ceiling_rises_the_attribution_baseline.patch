From b23310d14a008d35436c2c5de7ece02ea25cb788 Mon Sep 17 00:00:00 2001
From: originaxiom <originaxiom@users.noreply.github.com>
Date: Wed, 11 Nov 2026 18:12:25 +0000
Subject: [PATCH 5/6] WP-0.7, enforcement (cld-advisor's series 2, patch 5;
 built on e6298271a with series 1 applied): NO CEILING RISES WITHOUT A
 RECORDED ACT -- THE ATTRIBUTION BASELINE (the seat's planted case PV19). A
 file fails the attribution gate when it holds more vendor tokens than
 docs/ATTRIBUTION_BASELINE.json allows it, and that baseline is a tracked
 file: the commit that added three tokens could raise the file's count by
 three, and the gate passed. The baseline's own note says the footprint can
 only shrink. That is now read: the table of counts as it is, against the
 table as it was at the anchor; an entry that stands higher, or one that was
 not there, has risen, and is a failure unless it is named in RAISED_BY_NAME
 with its date and why (a file that carries frozen tokens and is moved is the
 case this seat can see for it). A ceiling may fall freely. The rule is one
 function for any table of ceilings, beside patch 1's for ledgers. The gate
 already read the past. The lock: three tests added to
 tests/test_nothing_leaves_a_ledger.py, the first on this repository's own
 gate with the plant put in through its readers and no tracked file touched;
 on the commit before it fails with 'three vendor tokens went into the README
 with a baseline raised to fit them, and the gate passed'. 0 of 19.

---
 scripts/gates/gates.py                | 45 ++++++++++++++++++++-
 tests/test_nothing_leaves_a_ledger.py | 58 +++++++++++++++++++++++++++
 2 files changed, 101 insertions(+), 2 deletions(-)

diff --git a/scripts/gates/gates.py b/scripts/gates/gates.py
index 99f3c2ffd..5a50ca252 100644
--- a/scripts/gates/gates.py
+++ b/scripts/gates/gates.py
@@ -136,6 +136,28 @@ NOTHING_LEAVES_FROM = "e6298271afcf081413141874361688ecbb42613f"     # read in h
 LEFT_BY_NAME = {}      # the ledger's path -> {what left it: "the date -- what became of it, and why"}.  Empty on 2026-11-11.
 
 
+RAISED_BY_NAME = {}    # the ceiling's file -> {the entry that rose: "the date -- why"}.  Empty on 2026-11-11.
+
+
+def ceiling_rises(path, now, then, since="the anchor", named=None):
+    """a table of ceilings (entry -> count), as it is now and as it was at the anchor (None where it was not there then): the
+    entries that stand higher now, an entry that was not listed then having stood at 0.  A ceiling may fall freely.  One that
+    rose is a problem unless it is named in RAISED_BY_NAME with its date and why.  Returns (problem, note)."""
+    if then is None:
+        return None, ""
+    named = RAISED_BY_NAME.get(path, {}) if named is None else named
+    count = lambda v: v if isinstance(v, int) and not isinstance(v, bool) else 0
+    rose = sorted(k for k, v in now.items() if count(v) > count(then.get(k)))
+    loose = [k for k in rose if not str(named.get(k, "")).strip()]
+    by_name = [k for k in rose if k not in loose]
+    note = f"; {len(by_name)} ceiling(s) raised by name since {since}: " + "; ".join(f"{k} ({named[k]})" for k in by_name[:4]) if by_name else ""
+    if loose:
+        return (f"{len(loose)} ceiling(s) in {path} rose since {since} with no record: "
+                + "; ".join(f"{k} {count(then.get(k))} -> {count(now[k])}" for k in loose[:4])
+                + ". A ceiling does not rise without a recorded act: lower it again, or name it in RAISED_BY_NAME with its date and why"), note
+    return None, note
+
+
 def _since_the_anchor(anchor, repo=None):
     """a runner of git in `repo`, or the reason the history cannot be read back to `anchor` (the gate then fails closed)"""
     repo = str(repo or ROOT)
@@ -438,7 +460,23 @@ ATTR_EXEMPT_FILES = {          # scanner tests that hunt the same tokens this ga
     "tests/test_sl4_dehn_filling_paper.py"}
 
 
-def gate_attribution():
+def attribution_baseline_rise(anchor=None, repo=None, named=None):
+    """PV19 (WP-0.7): a file fails this gate when it holds more vendor tokens than the baseline allows it, and the baseline is
+    a tracked file that the commit adding the tokens could raise.  "The footprint can only shrink" is the baseline's own
+    rule; it is now read against the baseline as it was at the anchor.  Returns (problem, note)."""
+    anchor = anchor or NOTHING_LEAVES_FROM
+    git, why = _since_the_anchor(anchor, repo)
+    if why:
+        return why, ""
+    was = git("show", f"{anchor}:docs/ATTRIBUTION_BASELINE.json")
+    try:
+        then = json.loads(was.stdout).get("frozen", {}) if was.returncode == 0 else None
+    except Exception:
+        then = None                                                       # unreadable at the anchor: not re-judged
+    return ceiling_rises("docs/ATTRIBUTION_BASELINE.json", _load_attr_baseline(), then if isinstance(then, dict) else None, anchor[:9], named)
+
+
+def gate_attribution(_anchor=None):
     rc, out = _git("ls-files")
     if rc != 0:
         return True, "git unavailable — skipped"
@@ -463,7 +501,10 @@ def gate_attribution():
     # gate read only tracked files and the last commit's author.  It now reads every commit message after ATTRIBUTION_FROM.
     problems, n = attribution_history_problems(ROOT, ATTRIBUTION_FROM)
     hits += problems
-    return not hits, (hits[:10] if hits else f"ok ({n} commit(s) since {ATTRIBUTION_FROM[:9]} read: each by originaxiom, no vendor token and no co-author trailer in its message)")
+    rise, note = attribution_baseline_rise(_anchor)
+    if rise:
+        hits.append(rise)
+    return not hits, (hits[:10] if hits else f"ok ({n} commit(s) since {ATTRIBUTION_FROM[:9]} read: each by originaxiom, no vendor token and no co-author trailer in its message)" + note)
 
 
 # The rule is read in history AFTER this commit: the most recent one on the first-parent line whose message carries a vendor
diff --git a/tests/test_nothing_leaves_a_ledger.py b/tests/test_nothing_leaves_a_ledger.py
index 32f23cdd1..ff4a676a9 100644
--- a/tests/test_nothing_leaves_a_ledger.py
+++ b/tests/test_nothing_leaves_a_ledger.py
@@ -370,3 +370,61 @@ def test_a_lock_gone_from_the_disk_or_from_the_index_has_left_before_any_commit_
 def test_on_main_no_lock_has_left_since_the_anchor():
     g = _gates()
     assert g.locks_that_left() == (None, "")
+
+
+# ---- PV19: a ceiling the same commit could raise ------------------------------------------------------------------------
+def test_a_baseline_count_raised_with_the_tokens_it_allows_turns_the_attribution_gate_red(monkeypatch):
+    """PV19 as planted, on this repository's own gate.  The plant goes in through the gate's readers and no tracked file is
+    touched: three vendor tokens are added to the README as the gate reads it, and the README's count in the baseline is raised
+    by three, as one commit could do.  Before the mend the count met the baseline and the gate passed."""
+    g = _gates()
+    assert g.gate_attribution()[0] is True, "the gate must be green before the plant"
+    token = g._VENDOR_TOKS[0]                                               # built by the gate; no vendor's name is typed here
+    real_read, real_load = g._read, g._load_attr_baseline
+    was = len(g._VENDOR_RE.findall(real_read("README.md")))
+    raised = dict(real_load(), **{"README.md": was + 3})
+    monkeypatch.setattr(g, "_read", lambda rel: real_read(rel) + ("\n" + token) * 3 if rel == "README.md" else real_read(rel))
+    monkeypatch.setattr(g, "_load_attr_baseline", lambda: raised)
+    monkeypatch.setattr(g, "_ATTR_BASELINE", raised)
+    ok, detail = g.gate_attribution()
+    assert ok is False, "three vendor tokens went into the README with a baseline raised to fit them, and the gate passed"
+    assert "1 ceiling(s) in docs/ATTRIBUTION_BASELINE.json rose" in str(detail) and "README.md %d -> %d" % (was, was + 3) in str(detail)
+
+
+def test_a_ceiling_may_fall_freely_and_rises_only_by_name():
+    g = _gates()
+    then = {"a.md": 4, "b.md": 1}
+    rises = lambda now, named=None: g.ceiling_rises("the/baseline.json", now, then, "abc123", named or {})
+    assert rises({"a.md": 4, "b.md": 1}) == (None, "")
+    assert rises({"a.md": 2}) == (None, "")                                              # lowered, and an entry gone: both are falls
+    problem, _ = rises({"a.md": 5, "b.md": 1})
+    assert "1 ceiling(s) in the/baseline.json rose since abc123" in problem and "a.md 4 -> 5" in problem
+    problem, _ = rises({"a.md": 4, "b.md": 1, "new.md": 2})                              # a new entry stood at 0
+    assert "new.md 0 -> 2" in problem
+    problem, note = rises({"a.md": 4, "b.md": 1, "new.md": 2}, {"new.md": "2026-11-11 -- b.md was moved here"})
+    assert problem is None and "1 ceiling(s) raised by name" in note and "moved here" in note
+    assert "rose" in rises({"a.md": 4, "new.md": 2}, {"new.md": "  "})[0]                # a name with no reason is not a record
+    assert g.ceiling_rises("x", {"a.md": 99}, None) == (None, "")                        # no table at the anchor: not re-judged
+    assert g.RAISED_BY_NAME == {}, "a ceiling that rises is named here with its date and why; say so in this lock too"
+
+
+def test_the_attribution_baseline_is_read_as_it_was_at_the_anchor(tmp_path):
+    g = _gates()
+    repo = tmp_path / "small"
+    repo.mkdir()
+    _git(repo, "init", "-q")
+    frozen = lambda counts: json.dumps({"_note": "a ratchet", "frozen": counts}) + "\n"
+    anchor = _commit(repo, "the anchor", {"docs/ATTRIBUTION_BASELINE.json": frozen({"a.md": 2})})
+    _commit(repo, "raised", {"docs/ATTRIBUTION_BASELINE.json": frozen({"a.md": 5})})
+    load_small = lambda: json.loads((repo / "docs" / "ATTRIBUTION_BASELINE.json").read_text())["frozen"]
+    real = g._load_attr_baseline
+    g._load_attr_baseline = load_small
+    try:
+        problem, _ = g.attribution_baseline_rise(anchor, repo)
+        assert "a.md 2 -> 5" in problem
+        (repo / "docs" / "ATTRIBUTION_BASELINE.json").write_text(frozen({"a.md": 1}))
+        assert g.attribution_baseline_rise(anchor, repo) == (None, "")
+        assert "cannot verify" in g.attribution_baseline_rise("0" * 40, repo)[0]
+    finally:
+        g._load_attr_baseline = real
+    assert g.attribution_baseline_rise() == (None, ""), "on main the baseline stands no higher than at the anchor"
