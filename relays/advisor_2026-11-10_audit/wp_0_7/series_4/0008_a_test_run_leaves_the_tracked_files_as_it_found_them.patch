+"""A test run leaves the tracked files as it found them (the advisor seat's audit, L10; its planted case PV27; 2026-11-11).
+
+A gate reads the files on disk.  A test that rewrites a tracked file changes what every gate and every later test reads,
+and the change is in nobody's commit.  Two tests did so on the day the rule came: a census that is recomputed and written
+over the committed counts, and a result file that is recomputed and can differ in its last digit.
+
+This file is at the root so that it holds for every lock, in tests/ and in the arcs' own folders.  When a run starts and
+when it ends it asks git which tracked files differ from the commit, and takes the hash of each.  A tracked file whose
+state changed in between fails the run, by name.  The files named below are held as found; the list may only shrink.
+
+It is a check of the run and not a gate: a gate reads a commit, and what a run does is not in one.  Like a gate, it is not
+moved by the environment: git is asked about the checkout at the root, with the variables that send it elsewhere taken out.
+"""
+import hashlib
+import os
+import subprocess
+
+ROOT = os.path.dirname(os.path.abspath(__file__))
+_GIT_REDIRECTS = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_COMMON_DIR")
+
+WRITTEN_BY_A_TEST_AS_FOUND = {          # a tracked file -> the test that rewrites it, as found on 2026-11-11
+    "frontier/B1464_the_aged_items_paid_and_the_seal_gates_read_every_seal/verification/seal_census.json":
+        "tests/test_b1464_aged_items.py::test_the_seal_census_live: a census recomputed and written over the committed counts",
+    "frontier/B1690_free_cusps_rigidity_and_the_tribunal_cells/verification/main_w81_w83.json":
+        "tests/test_b1690_free_cusps_rigidity_and_the_tribunal_cells.py: a result recomputed, which can differ in a last digit",
+}
+
+
+def tracked_state(root=ROOT):
+    """the tracked files that differ from the commit, each with the hash of what is on disk ("gone" for one that is not
+    there); None where git cannot say"""
+    here = {k: v for k, v in os.environ.items() if k not in _GIT_REDIRECTS}
+    try:
+        r = subprocess.run(["git", "--no-optional-locks", "-C", root, "status", "--porcelain=v1", "-z", "--untracked-files=no"],
+                           capture_output=True, timeout=600, env=here)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    if r.returncode != 0:
+        return None
+    state, entries, i = {}, r.stdout.decode("utf-8", "surrogateescape").split("\0"), 0
+    while i < len(entries):
+        entry = entries[i]
+        i += 1
+        if len(entry) < 4:
+            continue
+        if entry[0] in "RC":
+            i += 1                                   # a rename or a copy is followed by the path it came from
+        path = entry[3:]
+        try:
+            with open(os.path.join(root, path), "rb") as f:
+                state[path] = hashlib.sha256(f.read()).hexdigest()
+        except OSError:
+            state[path] = "gone"
+    return state
+
+
+def changed_by_the_run(before, after):
+    """(the tracked files whose state a run changed and that are not held by name, those that are)"""
+    moved = sorted(p for p in set(before) | set(after) if before.get(p) != after.get(p))
+    return [p for p in moved if p not in WRITTEN_BY_A_TEST_AS_FOUND], [p for p in moved if p in WRITTEN_BY_A_TEST_AS_FOUND]
+
+
+def pytest_sessionstart(session):
+    if hasattr(session.config, "workerinput"):
+        return                                       # a worker of a parallel run: the run's own process compares, once
+    session.config._tracked_before = tracked_state()
+
+
+def pytest_sessionfinish(session, exitstatus):
+    config = session.config
+    if hasattr(config, "workerinput") or not hasattr(config, "_tracked_before"):
+        return
+    before, after = config._tracked_before, tracked_state()
+    if before is None or after is None:
+        config._tracked_report = (None, None)
+        return
+    new, held = changed_by_the_run(before, after)
+    config._tracked_report = (new, held)
+    if new and int(session.exitstatus) == 0:
+        session.exitstatus = 1                       # every test passed, and the run is not clean
+
+
+def pytest_terminal_summary(terminalreporter, exitstatus, config):
+    report = getattr(config, "_tracked_report", None)
+    if report is None:
+        return
+    new, held = report
+    say = terminalreporter.write_line
+    if new is None:
+        say("the tracked files could not be compared before and after this run: git gave no answer here")
+        return
+    if held:
+        say("%d tracked file(s) rewritten by this run, held by name as found: %s" % (len(held), ", ".join(held)))
+    if new:
+        say("THIS RUN CHANGED %d TRACKED FILE(S) AND FAILS FOR IT: %s" % (len(new), ", ".join(new)), red=True, bold=True)
+        say("a test writes under its temporary folder, or puts back what it changed. Each file is as the run left it: git diff shows the change")
