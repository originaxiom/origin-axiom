+++ b/tests/test_a_test_run_leaves_the_tracked_files_as_it_found_them.py
@@ -0,0 +1,125 @@
+"""A test run leaves the tracked files as it found them (the closure programme's WP-0.7, series 4; the seat's planted case PV27).
+
+A test that rewrites a tracked file changes what every gate reads after it, in nobody's commit.  The run compares the
+tracked files before and after, in the conftest at the repository's root, and fails by name for a file it changed.
+
+Each test makes a small repository of its own, which holds this repository's root conftest, one tracked page and one
+test, and runs that test there in a process of its own."""
+import importlib.util
+import os
+import pathlib
+import shutil
+import subprocess
+import sys
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+_WRITES = "import pathlib\nROOT = pathlib.Path(__file__).resolve().parents[1]\n\n\ndef test_it(tmp_path):\n%s"
+
+
+def _git(repo, *a):
+    r = subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid", *a], capture_output=True, text=True)
+    assert r.returncode == 0, r.stderr
+    return r.stdout.strip()
+
+
+def _repo(tmp_path, body, git=True, table=None):
+    """a small repository: the root conftest of this one (where there is one), a tracked page, and a test with `body`"""
+    repo = tmp_path / "repo"
+    (repo / "tests").mkdir(parents=True)
+    if (ROOT / "conftest.py").is_file():
+        text = (ROOT / "conftest.py").read_text(encoding="utf-8")
+        (repo / "conftest.py").write_text(text + ("\nWRITTEN_BY_A_TEST_AS_FOUND.update(%r)\n" % table if table else ""), encoding="utf-8")
+    (repo / "pyproject.toml").write_text('[tool.pytest.ini_options]\ntestpaths = ["tests"]\n', encoding="utf-8")
+    (repo / "PAGE.md").write_text("a page that the commit holds\n", encoding="utf-8")
+    (repo / "tests" / "test_one.py").write_text(_WRITES % body, encoding="utf-8")
+    if git:
+        _git(repo, "init", "-q"); _git(repo, "add", "-A"); _git(repo, "commit", "-q", "-m", "a small repository")
+    return repo
+
+
+def _run(repo, *more, **also):
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("PYTEST_", "GIT_"))}
+    env["PYTHONDONTWRITEBYTECODE"] = "1"
+    env.update(also)
+    r = subprocess.run([sys.executable, "-B", "-m", "pytest", "-q", "-p", "no:cacheprovider", *more], cwd=str(repo), env=env, capture_output=True, text=True)
+    return r.returncode, r.stdout + r.stderr
+
+
+def test_a_run_that_writes_under_its_temporary_folder_passes(tmp_path):
+    """the control: this held before the series"""
+    rc, out = _run(_repo(tmp_path, "    (tmp_path / 'PAGE.md').write_text('written by a test\\n')\n    assert (tmp_path / 'PAGE.md').read_text()\n"))
+    assert rc == 0 and "1 passed" in out, out
+
+
+def test_a_run_that_rewrites_a_tracked_file_fails_and_names_the_file(tmp_path):
+    """PV27 as planted"""
+    rc, out = _run(_repo(tmp_path, "    (ROOT / 'PAGE.md').write_text('written by a test\\n')\n    assert (ROOT / 'PAGE.md').read_text()\n"))
+    assert "1 passed" in out, out
+    assert rc != 0, "a test run rewrote a tracked file, every test passed, and the run ended with status 0"
+    assert "CHANGED 1 TRACKED FILE(S)" in out and "PAGE.md" in out, out
+
+
+def test_a_run_that_removes_a_tracked_file_fails_too(tmp_path):
+    rc, out = _run(_repo(tmp_path, "    (ROOT / 'PAGE.md').unlink()\n    assert not (ROOT / 'PAGE.md').exists()\n"))
+    assert rc != 0 and "PAGE.md" in out, "a test run removed a tracked file and ended with status %d" % rc
+
+
+def test_a_test_that_puts_back_what_it_changed_passes(tmp_path):
+    body = ("    p = ROOT / 'PAGE.md'\n    was = p.read_text()\n    try:\n        p.write_text('planted for a moment\\n')\n        assert p.read_text() != was\n"
+            "    finally:\n        p.write_text(was)\n")
+    rc, out = _run(_repo(tmp_path, body))
+    assert rc == 0 and "1 passed" in out, out
+
+
+def test_a_file_that_was_changed_before_the_run_is_not_the_runs(tmp_path):
+    repo = _repo(tmp_path, "    assert (ROOT / 'PAGE.md').read_text()\n")
+    (repo / "PAGE.md").write_text("work in hand, not committed\n", encoding="utf-8")
+    rc, out = _run(repo)
+    assert rc == 0, out
+    # and where the run changes it further, it is the run's
+    (repo / "tests" / "test_one.py").write_text(_WRITES % "    (ROOT / 'PAGE.md').write_text('changed again by a test\\n')\n    assert True is not None\n", encoding="utf-8")
+    rc, out = _run(repo)
+    assert rc != 0 and "PAGE.md" in out, "a test run changed further a file that was already changed, and ended with status %d" % rc
+
+
+def test_a_file_held_by_name_is_said_and_does_not_fail_the_run(tmp_path):
+    repo = _repo(tmp_path, "    (ROOT / 'PAGE.md').write_text('written by a test\\n')\n    assert (ROOT / 'PAGE.md').read_text()\n", table={"PAGE.md": "a test that stood on the day of the rule"})
+    rc, out = _run(repo)
+    assert rc == 0 and "1 tracked file(s) rewritten by this run, held by name as found: PAGE.md" in out, out
+
+
+def test_a_parallel_run_is_compared_once_by_the_runs_own_process(tmp_path):
+    pytest.importorskip("xdist")
+    rc, out = _run(_repo(tmp_path, "    (ROOT / 'PAGE.md').write_text('written by a test\\n')\n    assert (ROOT / 'PAGE.md').read_text()\n"), "-n", "2")
+    assert rc != 0 and out.count("CHANGED 1 TRACKED FILE(S)") == 1, out
+
+
+def test_where_git_cannot_say_the_run_says_so_and_is_not_failed_for_it(tmp_path):
+    rc, out = _run(_repo(tmp_path, "    assert (ROOT / 'PAGE.md').read_text()\n", git=False))
+    assert rc == 0, out
+    assert "could not be compared" in out, "a run in a folder that is not a checkout says nothing of what it could not compare"
+
+
+def test_gits_own_variables_do_not_switch_the_check_off(tmp_path):
+    """the rule of this series for a gate, kept by the check of the run: nothing in the environment moves it"""
+    repo = _repo(tmp_path, "    (ROOT / 'PAGE.md').write_text('written by a test\\n')\n    assert (ROOT / 'PAGE.md').read_text()\n")
+    nowhere = tmp_path / "not_a_repository"
+    nowhere.mkdir()
+    for name, value in (("GIT_DIR", str(nowhere)), ("GIT_INDEX_FILE", str(nowhere / "an_index_that_is_not_there")), ("GIT_WORK_TREE", str(nowhere))):
+        _git(repo, "checkout", "-q", "--", "PAGE.md")
+        rc, out = _run(repo, **{name: value})
+        assert rc != 0 and "PAGE.md" in out and "could not be compared" not in out, "with %s set, a run that rewrote a tracked file ended with status %d" % (name, rc)
+
+
+def test_on_this_repository_the_check_is_at_the_root_and_two_files_are_held_by_name():
+    assert (ROOT / "conftest.py").is_file(), "no conftest at the repository's root: a test run is not compared with the commit"
+    spec = importlib.util.spec_from_file_location("the_root_conftest", ROOT / "conftest.py")
+    c = importlib.util.module_from_spec(spec); spec.loader.exec_module(c)
+    assert len(c.WRITTEN_BY_A_TEST_AS_FOUND) == 2
+    tracked = set(subprocess.run(["git", "-C", str(ROOT), "ls-files"], capture_output=True, text=True).stdout.split("\n"))
+    for path, why in c.WRITTEN_BY_A_TEST_AS_FOUND.items():
+        assert path in tracked and (ROOT / why.split("::")[0].split(":")[0]).is_file(), path
+    assert c.changed_by_the_run({"a": "1"}, {"a": "2", "b": "3"}) == (["a", "b"], [])
+    assert c.changed_by_the_run({"a": "1"}, {"a": "1"}) == ([], [])
