 import importlib.util
 import json
 import pathlib
@@ -137,3 +144,78 @@ def test_on_this_repository_the_last_reviews_anchor_is_the_commit_it_landed_in()
     problems = getattr(g, "review_anchor_problems", lambda: ["the gates do not hold the anchor to its review"])()
     assert problems == [], problems
     assert g.ANCHOR_RULE_FROM == 78
+
+
+# ---- the amendment of 2026-11-12: an anchor may be the head the review read, and is not retyped ---------------------------
+def _land_a_review_of_what_was_read(repo, n, page):
+    """as main landed Review 79: the readers read a head; landings follow; then one commit carries the entry and its anchor,
+    which names the head that was read"""
+    read = _git(repo, "rev-parse", "--short=9", "HEAD")
+    for i in range(2):
+        _commit(repo, "a landing while the review is read", {"frontier/B9%d_an_arc/FINDINGS.md" % i: "an arc\n"})
+    page = page + "\n" + _entry(n) + "\n**anchor-commit: `%s`**\n" % read
+    carried = _commit(repo, "Review %d, with its anchor" % n, {PAGE: page})
+    return page, read, carried
+
+
+def test_an_anchor_that_names_the_head_the_review_read_is_taken(tmp_path):
+    repo, page, landed78 = _repo(tmp_path)
+    page, read, carried = _land_a_review_of_what_was_read(repo, 79, page)
+    ok, detail = _review_fires(repo)
+    assert ok is True, "a review's anchor names the head its readers read, an ancestor of the commit that carries the entry, and the gate reads: " + detail
+    assert detail.startswith("3 merges since the last review"), detail          # the two landings and the entry's own commit are counted for the next review
+
+
+def test_an_anchor_is_not_retyped_after_it_first_stood(tmp_path):
+    repo, page, landed78 = _repo(tmp_path)
+    page, read, carried = _land_a_review_of_what_was_read(repo, 79, page)
+    # retyped to the commit that carries the entry: not later than the entry, and two landings fewer to review
+    _commit(repo, "the anchor retyped", {PAGE: page.replace("`%s`" % read, "`%s`" % carried)})
+    ok, detail = _review_fires(repo)
+    assert ok is False, "the anchor of the last review was retyped to a later commit after it first stood, and the gate reads: " + detail
+    assert "when it first stood" in detail and read in detail
+    # retyped to an earlier commit: refused as well, an anchor moves only when a review lands
+    _commit(repo, "the anchor retyped again", {PAGE: page.replace("`%s`" % read, "`%s`" % landed78)})
+    ok, detail = _review_fires(repo)
+    assert ok is False and "when it first stood" in detail, detail
+
+
+def test_an_anchor_that_is_no_commit_of_this_history_is_refused(tmp_path):
+    repo, page, landed78 = _repo(tmp_path)
+    _commit(repo, "Review 79 with an anchor that is no commit", {PAGE: page + "\n" + _entry(79) + "\n**anchor-commit: `deadbeef1`**\n"})
+    ok, detail = _review_fires(repo)
+    assert ok is False and "deadbeef1" in detail, detail
+
+
+def test_an_anchor_that_was_first_typed_wrongly_can_be_put_right(tmp_path):
+    """the way out.  An anchor that names no commit, or a commit later than its entry, never stood: the gate was red on it.
+    Putting it right is not a retyping.  (Found by the seat before the amendment was sent: as first built, the rule refused
+    the correction as well, and nothing main could type would have made the gate pass again.)"""
+    repo, page, landed78 = _repo(tmp_path / "a")
+    read = _git(repo, "rev-parse", "--short=9", "HEAD")
+    wrong = page + "\n" + _entry(79) + "\n**anchor-commit: `deadbeef1`**\n"
+    _commit(repo, "Review 79, its anchor mistyped", {PAGE: wrong})
+    ok, detail = _review_fires(repo)
+    assert ok is False and "no commit of this history" in detail, detail
+    _commit(repo, "the anchor put right", {PAGE: wrong.replace("`deadbeef1`", "`%s`" % read)})
+    ok, detail = _review_fires(repo)
+    assert ok is True, "an anchor that named no commit was put right, and the gate reads: " + detail
+    assert detail.startswith("2 merges since the last review"), detail                 # the entry's commit, and the correction
+    # once it stands it is not retyped: here to the commit that carries the entry
+    carried = _git(repo, "rev-parse", "--short=9", "HEAD~1")
+    _commit(repo, "the anchor retyped", {PAGE: wrong.replace("`deadbeef1`", "`%s`" % carried)})
+    ok, detail = _review_fires(repo)
+    assert ok is False and "when it first stood" in detail and read in detail, detail
+
+    # the same for an anchor first typed to a commit later than its entry
+    repo, page, landed78 = _repo(tmp_path / "b")
+    entry_only = page + "\n" + _entry(79)
+    carried = _commit(repo, "Review 79, with no anchor yet", {PAGE: entry_only})
+    later = _commit(repo, "a landing", {"frontier/B7_an_arc/FINDINGS.md": "an arc\n"})
+    _commit(repo, "the anchor, typed to the landing after the entry", {PAGE: entry_only + "\n**anchor-commit: `%s`**\n" % later})
+    ok, detail = _review_fires(repo)
+    assert ok is False and "never a later one" in detail, detail
+    _commit(repo, "the anchor put right", {PAGE: entry_only + "\n**anchor-commit: `%s`**\n" % carried})
+    ok, detail = _review_fires(repo)
+    assert ok is True, "an anchor that named a commit later than its entry was put right, and the gate reads: " + detail
+    assert detail.startswith("3 merges since the last review"), detail                 # the landing, the wrong anchor, the correction
