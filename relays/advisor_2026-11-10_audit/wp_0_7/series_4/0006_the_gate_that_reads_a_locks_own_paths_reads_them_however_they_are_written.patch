+# THE PATHS A LOCK NAMES BESIDE ITSELF, READ BY THE SYNTAX TREE (the advisor seat's series 4; its planted case PV32, 2026-11-11).
+# The reader above knows two idioms, written one way: a name bound in one line to the file's folder, and then that name followed
+# by double-quoted parts.  Measured on main's 323f92327 it read 2,118 of the 5,554 such paths in the 1,614 locks.  It did not
+# read a path that goes through a second name -- `V = A / "verification"`, then `V / "run.log"`, which is how the lock of B1671
+# is written, the arc this scope was made for -- nor single quotes, nor a path given in one line, nor joinpath, with_name or
+# with_suffix, nor a name bound inside a test.  The tree is read instead: what an expression stands for, whatever it is called.
+_SAME_PATH = ("Path", "pathlib.Path", "PurePath", "pathlib.PurePath", "str", "os.fspath", "os.path.abspath", "os.path.realpath",
+              "os.path.normpath", "abspath", "realpath", "normpath")
+_NOT_A_NAME = re.compile(r"[*?\[%{]")          # a pattern or a template, not the name of one file
+
+
+def _dotted(node):
+    parts = []
+    while isinstance(node, ast.Attribute):
+        parts.append(node.attr); node = node.value
+    if not isinstance(node, ast.Name):
+        return None
+    return ".".join([node.id] + parts[::-1])
+
+
+def _is_text(node):
+    return isinstance(node, ast.Constant) and isinstance(node.value, str)
+
+
+def _joined(base, *parts):
+    p = os.path.normpath(os.path.join(base, *parts)).replace(os.sep, "/")
+    return None if (p.startswith(("/", "..")) or p == ".") else p
+
+
+def _own_path(node, bases, rel):
+    """(the repository path an expression stands for, whether a constant part was added to get it), where the expression is
+    built from the file's own place: `__file__`, its folder, a parent of it, a name that stands for one of these.  None
+    where it is not, or where a part of it is computed."""
+    if isinstance(node, ast.Name):
+        if node.id == "__file__":
+            return rel, False
+        return (bases[node.id], False) if node.id in bases else None
+    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
+        left = _own_path(node.left, bases, rel)
+        if left is None or not _is_text(node.right):
+            return None
+        p = _joined(left[0], node.right.value)
+        return (p, True) if p else None
+    if isinstance(node, ast.Attribute) and node.attr == "parent":
+        b = _own_path(node.value, bases, rel)
+        return (os.path.dirname(b[0]), b[1]) if b else None
+    if isinstance(node, ast.Subscript) and isinstance(node.value, ast.Attribute) and node.value.attr == "parents":
+        b = _own_path(node.value.value, bases, rel)
+        k = node.slice
+        if b is None or not (isinstance(k, ast.Constant) and isinstance(k.value, int) and 0 <= k.value < 12):
+            return None
+        p = b[0]
+        for _ in range(k.value + 1):
+            p = os.path.dirname(p)
+        return p, b[1]
+    if isinstance(node, ast.Call) and not node.keywords:
+        name = _dotted(node.func)
+        if name in _SAME_PATH and len(node.args) == 1:
+            return _own_path(node.args[0], bases, rel)
+        if name in ("os.path.dirname", "dirname") and len(node.args) == 1:
+            b = _own_path(node.args[0], bases, rel)
+            return (os.path.dirname(b[0]), b[1]) if b else None
+        if name in ("os.path.join", "join") and len(node.args) > 1:
+            b = _own_path(node.args[0], bases, rel)
+            if b is None or not all(_is_text(a) for a in node.args[1:]):
+                return None
+            p = _joined(b[0], *[a.value for a in node.args[1:]])
+            return (p, True) if p else None
+        if isinstance(node.func, ast.Attribute):
+            b = _own_path(node.func.value, bases, rel)
+            if b is None:
+                return None
+            how = node.func.attr
+            if how in ("resolve", "absolute", "expanduser") and not node.args:
+                return b
+            if not (node.args and all(_is_text(a) for a in node.args)):
+                return None
+            if how == "joinpath":
+                p = _joined(b[0], *[a.value for a in node.args])
+            elif how == "with_name" and len(node.args) == 1:
+                p = _joined(os.path.dirname(b[0]), node.args[0].value)
+            elif how == "with_suffix" and len(node.args) == 1:
+                p = _joined(os.path.splitext(b[0])[0] + node.args[0].value)
+            else:
+                return None
+            return (p, True) if p else None
+    return None
+
+
+_A_SCOPE = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda, ast.ClassDef)
+
+
+def _scope_nodes(scope):
+    """the nodes of one scope: all that is under `scope` and not inside a function, a lambda or a class nested in it (the
+    nested one is itself listed: it binds its name here, and is read as a scope of its own)"""
+    out, stack = [], list(ast.iter_child_nodes(scope))
+    while stack:
+        n = stack.pop()
+        out.append(n)
+        if not isinstance(n, _A_SCOPE):
+            stack.extend(ast.iter_child_nodes(n))
+    return out
+
+
+def _bound_here(scope, nodes):
+    """name -> what it is bound to in this scope: the value of each plain assignment, None for any other binding"""
+    bound = {}
+
+    def other(target):
+        for m in ast.walk(target):
+            if isinstance(m, ast.Name):
+                bound.setdefault(m.id, []).append(None)
+    if isinstance(scope, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
+        a = scope.args
+        for arg in a.posonlyargs + a.args + a.kwonlyargs + [x for x in (a.vararg, a.kwarg) if x]:
+            bound.setdefault(arg.arg, []).append(None)
+    for n in nodes:
+        if isinstance(n, ast.Assign):
+            for t in n.targets:
+                if isinstance(t, ast.Name):
+                    bound.setdefault(t.id, []).append(n.value)
+                else:
+                    other(t)
+        elif isinstance(n, (ast.AnnAssign, ast.NamedExpr)):
+            if isinstance(n.target, ast.Name) and n.value is not None:
+                bound.setdefault(n.target.id, []).append(n.value)
+            else:
+                other(n.target)
+        elif isinstance(n, (ast.AugAssign, ast.For, ast.AsyncFor, ast.comprehension)):
+            other(n.target)
+        elif isinstance(n, (ast.With, ast.AsyncWith)):
+            for item in n.items:
+                if item.optional_vars is not None:
+                    other(item.optional_vars)
+        elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+            bound.setdefault(n.name, []).append(None)
+        elif isinstance(n, (ast.Import, ast.ImportFrom)):
+            for al in n.names:
+                bound.setdefault((al.asname or al.name).split(".")[0], []).append(None)
+        elif isinstance(n, ast.ExceptHandler) and n.name:
+            bound.setdefault(n.name, []).append(None)
+        elif isinstance(n, (ast.Global, ast.Nonlocal)):
+            for name in n.names:
+                bound.setdefault(name, []).append(None)
+    return bound
+
+
+def _own_paths(rel, txt):
+    """What a file names beside itself, read from its syntax tree: (the paths, how many more have a part that is computed and
+    are not read, whether the file could be parsed).  A path is reported once, whole: `HERE / "runs" / "k1.txt"` is one path.
+    A line that only binds a name to a folder to build on (`V = A / "verification"`) names no file and is not reported.
+
+    A name stands for a place where every binding of it in its own scope gives the same place.  A name bound in a function
+    is that function's: it hides the module's name there and nowhere else.  A name that a function declares global is read
+    as no place at all."""
+    try:
+        tree = ast.parse(txt)
+    except (SyntaxError, ValueError):
+        return set(), 0, False
+    declared = {name for n in ast.walk(tree) if isinstance(n, (ast.Global, ast.Nonlocal)) for name in n.names}
+    whole, inside, folders = {}, set(), set()
+    computed = [0]
+
+    def read(scope, outer):
+        nodes = _scope_nodes(scope)
+        bound = _bound_here(scope, nodes)
+        bases = {k: v for k, v in outer.items() if k not in bound}
+        moved = True
+        while moved:
+            moved = False
+            for name, values in bound.items():
+                if name in bases or name in declared or any(v is None for v in values):
+                    continue
+                got = {(_own_path(v, bases, rel) or (None,))[0] for v in values}
+                if len(got) == 1 and None not in got:
+                    bases[name] = got.pop(); moved = True
+        for n in nodes:
+            if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name):
+                got = _own_path(n.value, bases, rel)
+                if got and got[1] and "." not in os.path.basename(got[0]):
+                    folders.add(id(n.value))
+            if not isinstance(n, (ast.BinOp, ast.Call)):
+                continue
+            got = _own_path(n, bases, rel)
+            name = None
+            if isinstance(n, ast.BinOp):
+                source = n.left if isinstance(n.op, ast.Div) else None
+            else:
+                name = _dotted(n.func)
+                source = n.args[0] if (name in ("os.path.join", "join") and n.args) else (n.func.value if isinstance(n.func, ast.Attribute) else None)
+            if got and got[1]:
+                whole[id(n)] = got[0]
+                if source is not None:
+                    inside.update(id(d) for d in ast.walk(source))
+            elif got is None and source is not None and _own_path(source, bases, rel) is not None:
+                if isinstance(n, ast.BinOp) or name in ("os.path.join", "join") or n.func.attr in ("joinpath", "with_name", "with_suffix"):
+                    computed[0] += 1
+        for n in nodes:
+            if isinstance(n, _A_SCOPE):
+                # what a class binds in its body is an attribute, and is not a name inside its methods
+                read(n, outer if isinstance(scope, ast.ClassDef) else bases)
+    read(tree, {})
+    paths = {p for i, p in whole.items() if i not in inside and i not in folders and not _NOT_A_NAME.search(p)}
+    return paths, computed[0], True
+
+
+def _file_relative_refs(rel, txt):
+    """The paths a file names relative to ITSELF: by the syntax tree, and by the pattern reader that was here before it, so
+    that nothing is read less than it was."""
+    return _own_paths(rel, txt)[0] | _file_relative_refs_by_pattern(rel, txt)
+
