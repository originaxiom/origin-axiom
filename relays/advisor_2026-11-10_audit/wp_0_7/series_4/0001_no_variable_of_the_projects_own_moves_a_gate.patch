+# ---- nothing in the environment moves a gate: the project's own variables (series 4) ----------------------------------------
+def _own_variables():
+    """every variable named OA_... that the gates' file or a checker names: read from the sources, so that a new one is met"""
+    names = set()
+    for f in [ROOT / "scripts" / "gates" / "gates.py"] + sorted((ROOT / "scripts" / "checks").glob("*.py")):
+        names.update(re.findall(r"\bOA_[A-Z0-9_]+\b", f.read_text(encoding="utf-8")))
+    return sorted(names)
+
+
+_LINES = ("import sys, json; sys.dont_write_bytecode = True; sys.path.insert(0, 'scripts/gates'); import gates as g\n"
+          "out = {}\n"
+          "for n in sys.argv[1].split(','):\n"
+          "    r = g.GATES[n](); out[n] = [bool(r[0]), r[1] if isinstance(r[1], str) else ' | '.join(map(str, r[1]))]\n"
+          "print(json.dumps(out))\n")
+
+
+def _lines_of(names, env):
+    import json, os
+    r = subprocess.run([sys.executable, "-B", "-c", _LINES, ",".join(names)], cwd=str(ROOT), capture_output=True, text=True,
+                       env=dict({k: v for k, v in os.environ.items() if not k.startswith("OA_")}, PYTHONDONTWRITEBYTECODE="1", **env))
+    assert r.returncode == 0, r.stderr[-600:]
+    return json.loads(r.stdout.strip().splitlines()[-1])
+
+
+def test_no_variable_of_the_projects_own_moves_a_gate(tmp_path):
+    """Found on main's f9e70c167: OA_REVIEW_MERGES=0 switched off the gate that blocks until the review is run; OA_POINT_REGISTER
+    and OA_RETRACTIONS_LEDGER pointed two more gates at another page.  Every such variable is set here at once, to a value that
+    would move its reader, and the gates that have such readers must print what they print without them."""
+    empty = tmp_path / "a_page_with_no_row.md"
+    empty.write_text("# a page with no row\n", encoding="utf-8")
+    names = _own_variables()
+    assert {"OA_POINT_REGISTER", "OA_RETRACTIONS_LEDGER", "OA_HARVEST_PIN_OVERRIDE"} <= set(names), names
+    hostile = {n: ("2099-01-01" if n.endswith("_TODAY") else "0" if n.endswith("_MERGES") else "x=y" if n.endswith("_OVERRIDE")
+                   else str(tmp_path) if n == "OA_ROOT" else str(empty)) for n in names}
+    hostile.setdefault("OA_REVIEW_MERGES", "0")              # the variable the review gate read; no source names it now
+    gates_with_readers = ["review-fires", "point-debt", "retraction-debt", "lead-debt", "relay-debt"]
+    plain, moved = _lines_of(gates_with_readers, {}), _lines_of(gates_with_readers, hostile)
+    changed = sorted(n for n in gates_with_readers if plain[n] != moved[n])
+    assert not changed, "with %d variables of the project's own set, these gates change their line: %s" % (
+        len(hostile), "; ".join("%s: %r" % (n, moved[n][1][:90]) for n in changed))
+
+
+def test_every_script_a_gate_starts_is_given_an_environment_without_the_seams():
+    """the same rule, held to the code: the gates' file reads the environment in one place, the helper that takes the seams
+    out, and every script it starts is handed that helper's environment.  A gate added tomorrow is met here."""
+    src = (ROOT / "scripts" / "gates" / "gates.py").read_text(encoding="utf-8")
+    tree = ast.parse(src)
+    starts, bare = 0, []
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Call) and ast.unparse(n.func) == "subprocess.run" and n.args and ast.unparse(n.args[0]).startswith("[sys.executable"):
+            starts += 1
+            env = next((k.value for k in n.keywords if k.arg == "env"), None)
+            if env is None or ast.unparse(env) != "_no_seams()":
+                bare.append("line %d" % n.lineno)
+    assert starts >= 9
+    assert not bare, "a gate starts a script with the whole environment, seams and all: " + ", ".join(bare)
+    reads = [i + 1 for i, l in enumerate(src.split("\n")) if "os.environ" in l or "getenv" in l]
+    assert len(reads) == 1, "the gates' file reads the environment in %d places: lines %s" % (len(reads), reads)
+
+
+def test_the_review_gate_takes_a_tests_count_as_an_argument():
+    import inspect
+    g = _gates()
+    gate = getattr(g.gate_review_fires, "__wrapped__", g.gate_review_fires)
+    assert "_merges" in inspect.signature(gate).parameters, "the review gate has no argument for a test's count: it is moved from the environment"
+    assert g.gate_review_fires(_merges=0)[0] is True
+    assert "0 merges" in g.gate_review_fires(_merges=0)[1] and "FIRES" in str(g.gate_review_fires(_merges=10 ** 6)[1])
+
