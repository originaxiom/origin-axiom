+# ---- a recorded act does not break this lock (series 4, patch 10; found on 2026-11-12, when main first had an act to record) ----
+# Six tests of this lock record an act in a small repository's gates.  They planted it by rewriting the text of an empty
+# table, so they held only while nothing was named: the first act main recorded would have failed each of them, for no
+# fault of a gate.  The table is now found by the statement that binds it, and the entry is added to whatever it holds.
+#
+# _SAID_ONCE.  AN ACT RECORDED IN THE GATES IS SAID IN THIS LOCK ONCE.  The two tests that compare a table whole with what
+# this lock knows of it are the place: test_the_rule_reads_main_from_its_anchor_and_nothing_is_named_yet holds LEFT_BY_NAME,
+# and test_a_ceiling_may_fall_freely_and_rises_only_by_name holds RAISED_BY_NAME.  Whoever records an act changes the table
+# written there, in the same commit.  (The first of the two keeps the name it had on the day the table was empty: a test
+# that is renamed has left its lock.)  Three more tests read this repository, one for the two pages, one for the locks and
+# one for the tests of the locks.  Until 2026-11-12 each also held the gate's note to be empty, so one recorded act would
+# have had to be said in two or three tests.  They now hold what they are about: nothing has left without a record, and
+# the gate writes a note only where the table holds a record for that ledger.
+_AS_MAIN_WOULD_WRITE_IT = {     # the table -> the statement that binds it, with one act recorded over several lines
+    "LEFT_BY_NAME": ('LEFT_BY_NAME = {\n'
+                     '    "tests": {      # a test that left its lock: the date, what became of it, and why\n'
+                     '        "frontier/B9_an_arc/verification/test_b9_an_arc.py::test_that_was_rewritten":\n'
+                     '            "2026-11-12 -- the claim it locked was corrected; it was rewritten as two tests",\n'
+                     '    },\n'
+                     '}\n'),
+    "RAISED_BY_NAME": ('RAISED_BY_NAME = {\n'
+                       '    "skips": {"frontier/B9_an_arc/verification/test_b9_an_arc.py::test_that_is_slow": "2026-11-12 -- moved to the slow lane"},\n'
+                       '}\n'),
+}
+
+
+def _gates_in_which_acts_are_recorded(tmp_path):
+    """a copy of this repository's gates and checkers in which each of the two tables already holds one act, written as
+    main would write it; returned as the root the tests of this lock copy their gates from"""
+    root = tmp_path / "gates_in_which_acts_are_recorded"
+    skip = shutil.ignore_patterns("__pycache__", "*.pyc")
+    for part in ("gates", "checks"):
+        shutil.copytree(ROOT / "scripts" / part, root / "scripts" / part, ignore=skip)
+    p = root / "scripts" / "gates" / "gates.py"
+    src = p.read_text(encoding="utf-8")
+    lines = src.splitlines(keepends=True)
+    binds = {table: _the_statement_that_binds(src, table) for table in _AS_MAIN_WOULD_WRITE_IT}
+    for table, node in sorted(binds.items(), key=lambda b: -b[1].lineno):
+        lines[node.lineno - 1:node.end_lineno] = [_AS_MAIN_WOULD_WRITE_IT[table]]
+    p.write_text("".join(lines), encoding="utf-8")
+    return root
+
+
+def test_the_tests_that_record_an_act_run_whatever_the_tables_already_hold(tmp_path, monkeypatch):
+    recorded = _gates_in_which_acts_are_recorded(tmp_path)
+    spec = importlib.util.spec_from_file_location("gates_in_which_acts_are_recorded", recorded / "scripts" / "gates" / "gates.py")
+    g = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(g)
+    assert list(g.LEFT_BY_NAME) == ["tests"] and list(g.RAISED_BY_NAME) == ["skips"]      # the copy is what it is said to be
+    monkeypatch.setitem(globals(), "ROOT", recorded)
+    broken = {}
+    for n, test in enumerate((test_a_phrase_that_leaves_the_registry_turns_the_sweep_red_unless_it_is_named,
+                              test_one_law_or_one_link_removed_turns_its_gate_red_unless_it_is_named,
+                              test_a_row_that_leaves_the_identification_ledger_turns_the_gate_red_unless_it_is_named,
+                              test_one_lock_deleted_turns_the_gate_red_unless_its_retirement_is_recorded,
+                              test_a_test_that_may_now_skip_passes_only_by_a_recorded_act,
+                              test_a_test_function_that_leaves_its_lock_has_left)):
+        room = tmp_path / ("its_room_%d" % n)
+        room.mkdir()
+        try:
+            test(room)
+        except AssertionError as why:
+            broken[test.__name__] = (str(why).splitlines() or ["an assert with no message"])[0][:200]
+    assert not broken, "with an act already recorded in the gates, %d of the 6 tests that record one fail: %s" % (len(broken), broken)
