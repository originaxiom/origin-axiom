+# ---- PV23 (series 4): the old lines that call one member's result the object's were held as a count --------------------
+# A new NEGATIVE worded about the object passed when one old line was reworded in the same commit: eight before, eight
+# after.  What stood on the day of the rule is held by name, each line by its arc's folder.
+def _the_old_arcs():
+    """the folders of the arcs whose verdict line says it on this repository today: read here, not typed"""
+    out = []
+    for arc, _phrase in _gates().member_scope_hits():
+        found = sorted((ROOT / "frontier").glob(arc + "_*/arc_verdict.json"))
+        assert len(found) == 1, arc
+        out.append(found[0].parent.name)
+    assert out, "no old line stands on this repository: the tests below have nothing to build on"
+    return out
+
+
+def _line(folder, claim, verdict="NEGATIVE"):
+    return {"frontier/%s/arc_verdict.json" % folder: json.dumps({"id": folder.split("_")[0], "verdict": verdict, "claim_one_line": claim}) + "\n"}
+
+
+def _as_on_main(tmp_path):
+    """a small repository in which each of the old arcs says it, as on main"""
+    files = {}
+    for folder in _the_old_arcs():
+        files.update(_line(folder, "On this member's thread the object cannot carry it."))
+    return _scratch(tmp_path, files), _the_old_arcs()
+
+
+def test_one_more_negative_about_the_object_fails_the_member_scope_gate(tmp_path):
+    """the control: this held before the series"""
+    repo, old = _as_on_main(tmp_path)
+    assert _gate(repo, "member-scope")[0] is True
+    _commit(repo, "a new negative", _line("B99990_a_new_negative", "On one thread the object cannot carry a third generation."))
+    ok, detail = _gate(repo, "member-scope")
+    assert ok is False and "B99990" in detail
+
+
+def test_a_new_negative_does_not_pass_because_an_old_line_was_reworded(tmp_path):
+    """the case as found: one old line names its member now, one new line says the object, and the count is what it was"""
+    repo, old = _as_on_main(tmp_path)
+    files = _line(old[0], "On this member's thread m003 cannot carry it.")
+    files.update(_line("B99990_a_new_negative", "On one thread the object cannot carry a third generation."))
+    _commit(repo, "one old line reworded, one new line", files)
+    ok, detail = _gate(repo, "member-scope")
+    assert ok is False, "a new NEGATIVE says the object for one member's result, an old line was reworded in the same commit, and the gate reads: " + detail
+    assert "B99990_a_new_negative" in detail
+
+
+def test_an_arc_that_takes_an_old_arcs_number_is_not_the_old_arc(tmp_path):
+    """the old lines are held by their arcs' folders: a new folder that gives itself an old arc's number is a new arc"""
+    repo, old = _as_on_main(tmp_path)
+    number = old[0].split("_")[0]
+    files = _line(old[0], "On this member's thread m003 cannot carry it.")
+    files.update(_line(number + "_a_second_arc_with_that_number", "On one thread the object cannot carry a third generation."))
+    _commit(repo, "one old line reworded, and a second arc with its number", files)
+    ok, detail = _gate(repo, "member-scope")
+    assert ok is False, "a second arc took an old arc's number and says the object, and the gate reads: " + detail
+
+
+def test_an_old_line_that_is_mended_passes_and_the_gate_says_the_list_can_shrink(tmp_path):
+    repo, old = _as_on_main(tmp_path)
+    _commit(repo, "one old line reworded", _line(old[0], "On this member's thread m003 cannot carry it."))
+    ok, detail = _gate(repo, "member-scope")
+    assert ok is True, detail
+    assert "%d on the record" % (len(old) - 1) in detail and "held by name" in detail and "shorten the list" in detail, detail
+
+
+def test_on_this_repository_the_old_lines_are_held_by_name():
+    g = _gates()
+    named = getattr(g, "MEMBER_SCOPE_AS_FOUND", None)
+    assert named is not None, "the gates hold the old lines as a count and not by name"
+    assert len(named) == 8 == g.MEMBER_SCOPE_BASELINE
+    for folder in named:
+        assert (ROOT / "frontier" / folder / "arc_verdict.json").is_file(), folder
+    assert set(_the_old_arcs()) <= set(named)
+    ok, detail = g.gate_member_scope()
+    assert ok is True and "held by name" in detail, detail
