+# ---- nothing in the environment moves a gate: git's own variables (series 4) ------------------------------------------------
+def test_where_the_environment_sends_git_elsewhere_no_gate_of_the_table_passes(tmp_path):
+    """GIT_DIR pointing at another repository made an export a full clone, and seven gates of the table passed on it, git
+    answering for the other repository.  GIT_INDEX_FILE pointing at an empty index left a real clone with no tracked file,
+    and the same seven passed."""
+    export = _exported(tmp_path, "a")
+    honest = tmp_path / "a_source"                              # the small repository the export was made from
+    forms = {"an export, GIT_DIR pointing at another repository": (export, {"GIT_DIR": str(honest / ".git")}),
+             "a clone, GIT_INDEX_FILE pointing at an index that is not its own": (honest, {"GIT_INDEX_FILE": str(tmp_path / "no_such_index")}),
+             "a clone, GIT_OBJECT_DIRECTORY pointing at another store": (honest, {"GIT_OBJECT_DIRECTORY": str(tmp_path / "no_such_store")})}
+    for form, (folder, env) in forms.items():
+        state, out = _the_table_there(folder, env)
+        passing = sorted(name for name, (ok, detail) in out.items() if ok)
+        assert not passing, f"{form}: read as {state!r}, and these gates of the table pass: " + ", ".join(passing)
+        assert state in ("redirected", "export"), (form, state)
+        assert all("refused" in detail for ok, detail in out.values()), (form, out)
+    state, out = _the_table_there(export, forms["an export, GIT_DIR pointing at another repository"][1])
+    assert state == "redirected" and all("sends git to read somewhere else" in detail and "GIT_DIR" in detail for ok, detail in out.values()), (state, out)
+
+
+def test_a_hooks_environment_that_names_the_folders_own_repository_is_not_a_redirection(tmp_path):
+    """the other side: git sets such variables for a hook.  Where they name what git would find by itself, nothing is refused."""
+    _exported(tmp_path, "b")
+    honest = tmp_path / "b_source"
+    state, out = _the_table_there(honest, {"GIT_DIR": str(honest / ".git"), "GIT_INDEX_FILE": str(honest / ".git" / "index")})
+    assert state == "full"
+    assert not any("sends git" in detail for ok, detail in out.values()), out
+
