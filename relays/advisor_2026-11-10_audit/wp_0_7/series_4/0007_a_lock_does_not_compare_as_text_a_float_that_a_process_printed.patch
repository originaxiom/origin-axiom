+def _a_lock_that_runs(tmp_path, name, lock, beside=None):
+    files = {"tests/test_real.py": _REAL, _ARC + "/third.py": _THIRD, _ARC + "/page.md": "one third = 0.33333333333333331\n", _LOCK: lock}
+    files.update({_ARC + "/" + k: v for k, v in (beside or {}).items()})
+    return _gate(_scratch(tmp_path / name, files), "test-vacuity")
+
+
+def test_a_lock_that_pins_a_float_a_process_printed_fails_the_vacuity_gate(tmp_path):
+    """PV26 as the suite plants it"""
+    lock, beside = _PINS["a literal that must be in what was printed"]
+    ok, detail = _a_lock_that_runs(tmp_path, "pv26", lock, beside)
+    assert ok is False, "a lock runs a script and compares, as text, a float it printed to seventeen digits, and the vacuity gate reads: " + detail
+    assert _LOCK + "::test_it" in detail and "compare it as a number" in detail
+
+
+def test_every_way_of_comparing_a_printed_float_as_text_is_refused(tmp_path):
+    passed = []
+    for n, (way, (lock, beside)) in enumerate(_PINS.items()):
+        ok, detail = _a_lock_that_runs(tmp_path, "way%d" % n, lock, beside)
+        if ok or "a float that a process printed" not in detail:
+            passed.append(way)
+    assert not passed, "a lock compares, as text, a float that a process printed, and the gate passes for: " + "; ".join(passed)
+
+
+def test_a_lock_that_compares_the_number_as_a_number_is_not_refused(tmp_path):
+    """the other side: what is not the form passes"""
+    for n, (what, lock) in enumerate(_DOES_NOT_PIN.items()):
+        ok, detail = _a_lock_that_runs(tmp_path, "not%d" % n, lock)
+        assert ok is True, (what, detail)
+
+
+def test_a_whole_transcript_that_holds_no_such_number_passes_and_is_counted(tmp_path):
+    lock = _RUNS + "def test_it():\n" + _OUT + "    assert out == (HERE / 'third_run.txt').read_text()\n"
+    ok, detail = _a_lock_that_runs(tmp_path, "whole", lock, {"third.py": "print('the orbits: 3, of sizes 1, 3 and 12')\n", "third_run.txt": "the orbits: 3, of sizes 1, 3 and 12\n"})
+    assert ok is True, detail
+    assert "1 more compare the whole of what a process printed with a committed file in which no such number stands" in detail, detail
+
+
+def test_a_transcript_the_gate_cannot_find_is_counted_and_said(tmp_path):
+    lock = _RUNS + "def test_it():\n" + _OUT + "    assert out == (HERE / ('third_%s.txt' % 'run')).read_text()\n"
+    ok, detail = _a_lock_that_runs(tmp_path, "unread", lock, {"third_run.txt": "one third = 0.33333333333333331\n"})
+    assert ok is True, detail
