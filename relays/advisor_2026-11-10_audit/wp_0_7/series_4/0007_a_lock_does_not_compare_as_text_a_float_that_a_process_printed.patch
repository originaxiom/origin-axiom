+# A LOCK THAT COMPARES, AS TEXT, A FLOAT THAT A PROCESS PRINTED (the advisor seat's audit, L6; its planted case PV26).
+# The last digits a process prints for a float depend on the machine and its libraries: such a lock passes where it was
+# written and can fail on a clean checkout elsewhere, for no fault of the result.  Whether a printed float is stable is not
+# in the commit.  The form is: a test that starts a process -- itself, through a function or a fixture of its file, or
+# through a name its file binds to what a process gave -- and asserts on text that holds a float with six or more digits
+# after the point, or with an exponent.  The text is a literal in the assert, a text constant of the module, or a committed
+# file that the assert compares for equality.  A process whose command is git is not counted: it prints no float.
+# In a committed file compared whole, a zero printed with a sign is read as a float too.  A float that is zero to the digits
+# printed keeps the sign of what it was before rounding, and that sign is the machine's (`'%+.0f' % -1e-17` is "-0").  One
+# lock on main compared a transcript written to hold "integers and eighth roots only", and failed on the machine that found
+# the class by three such signs.  In a literal the same sign is as often a count printed with its sign, and is not read.
+_STARTS = {"run", "check_output", "check_call", "call", "Popen", "getoutput", "getstatusoutput"}
+_A_PRINTED_FLOAT = re.compile(r"\d\.\d{6,}|\d\.\d+[eE][-+]?\d+")
+_A_SIGNED_ZERO = re.compile(r"(?<![\w.])[-+]0(?![\w.])")
+_A_FILE_NAME = re.compile(r"[\w.\-/]+\.\w+")
+
+
+def _process_names(tree):
+    """(the names this file gives the subprocess module, those it gives os, the bare names under which it can start a process)"""
+    sub, osn, bare = set(), set(), set()
+    for n in ast.walk(tree):
+        if isinstance(n, ast.Import):
+            for al in n.names:
+                if al.name == "subprocess":
+                    sub.add(al.asname or "subprocess")
+                elif al.name == "os":
+                    osn.add(al.asname or "os")
+        elif isinstance(n, ast.ImportFrom):
+            for al in n.names:
+                if (n.module == "subprocess" and al.name in _STARTS) or (n.module == "os" and al.name in ("system", "popen")):
+                    bare.add(al.asname or al.name)
+    return sub, osn, bare
+
+
+def _is_git(call):
+    first = call.args[0] if call.args else None
+    if isinstance(first, (ast.List, ast.Tuple)) and first.elts:
+        first = first.elts[0]
+    return isinstance(first, ast.Constant) and isinstance(first.value, str) and first.value.split()[:1] == ["git"]
+
+
+def _reaches_a_process(node, names, starters, held):
+    """does anything under `node` start a process, call a function of this file that does, or read a name bound to one?"""
+    sub, osn, bare = names
+    for n in ast.walk(node):
+        if isinstance(n, ast.Call):
+            f = n.func
+            if isinstance(f, ast.Name) and f.id in starters:
+                return True
+            started = (isinstance(f, ast.Name) and f.id in bare) or (
+                isinstance(f, ast.Attribute) and isinstance(f.value, ast.Name) and (
+                    (f.value.id in sub and f.attr in _STARTS) or (f.value.id in osn and f.attr in ("system", "popen"))))
+            if started and not _is_git(n):
+                return True
+        elif isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load) and n.id in held:
+            return True
+    return False
+
+
+def _module_level(tree):
+    """the statements a module runs when it is imported: its body, and what is nested in an if, a try or a with"""
+    out, stack = [], list(tree.body)
+    while stack:
+        n = stack.pop()
+        out.append(n)
+        if isinstance(n, (ast.If, ast.Try, ast.With)):
+            for part in ("body", "orelse", "finalbody"):
+                stack.extend(getattr(n, part, []))
+            for h in getattr(n, "handlers", []):
+                stack.extend(h.body)
+    return out
+
+
+def printed_floats(rel, tree, find=None, read=None):
+    """The tests of one lock that compare, as text, a float a process printed.  Returns (findings, unread, whole): findings
+    is a list of (test name, line, what the text is); unread counts the asserts that compare what a process gave with a file
+    this reader could not find; whole counts those that compare it with a committed file in which no such number stands.
+    `find(name)` gives the tracked path a file name stands for, `read(path)` its text."""
+    names = _process_names(tree)
+    level = _module_level(tree)
+    funcs = {n.name: n for n in level if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef))}
+    binds = [(n.targets[0].id, n.value) for n in level
+             if isinstance(n, ast.Assign) and len(n.targets) == 1 and isinstance(n.targets[0], ast.Name)]
+    texts = {name: v.value for name, v in binds if isinstance(v, ast.Constant) and isinstance(v.value, str)}
+    starters, held, moved = set(), set(), True
+    while moved:
+        moved = False
+        for name, fn in funcs.items():
+            if name not in starters and _reaches_a_process(fn, names, starters, held):
+                starters.add(name); moved = True
+        for name, value in binds:
+            if name not in held and _reaches_a_process(value, names, starters, held):
+                held.add(name); moved = True
+    findings, unread, whole = [], 0, 0
+    for fn in ast.walk(tree):
+        if not (isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)) and fn.name.startswith("test")):
+            continue
+        params = {a.arg for a in fn.args.posonlyargs + fn.args.args + fn.args.kwonlyargs}
+        # the names that, inside this test, hold what a process gave: a fixture of this file that starts one, a name the module
+        # bound to one, and whatever the test binds from either
+        given, moved = set(held) | (params & starters), True
+        gives = lambda node: _reaches_a_process(node, names, starters, given)
+        while moved:
+            moved = False
+            for n in ast.walk(fn):
+                pairs = []
+                if isinstance(n, ast.Assign):
+                    pairs = [(t, n.value) for t in n.targets]
+                elif isinstance(n, (ast.AnnAssign, ast.NamedExpr)) and n.value is not None:
+                    pairs = [(n.target, n.value)]
+                elif isinstance(n, (ast.For, ast.AsyncFor, ast.comprehension)):
+                    pairs = [(n.target, n.iter)]
+                elif isinstance(n, (ast.With, ast.AsyncWith)):
+                    pairs = [(item.optional_vars, item.context_expr) for item in n.items if item.optional_vars is not None]
+                for target, value in pairs:
+                    if gives(value):
+                        for m in ast.walk(target):
+                            if isinstance(m, ast.Name) and m.id not in given:
+                                given.add(m.id); moved = True
+        if not (given or gives(fn)):
+            continue
+        for a in ast.walk(fn):
+            if not isinstance(a, ast.Assert):
+                continue
+            for unit in _parts_of(a.test):
+                if not gives(unit):
+                    continue                             # this part of the assert compares nothing a process gave
+                said = [c.value for c in ast.walk(unit) if isinstance(c, ast.Constant) and isinstance(c.value, str)]
+                said += [texts[n.id] for n in ast.walk(unit) if isinstance(n, ast.Name) and n.id in texts]
+                if any(_A_PRINTED_FLOAT.search(t) for t in said):
+                    findings.append((fn.name, a.lineno, "a literal"))
+                    continue
+                if not (isinstance(unit, ast.Compare) and any(isinstance(op, ast.Eq) for op in unit.ops)):
+                    continue
+                for side in [unit.left] + unit.comparators:
+                    reads = any(isinstance(c, ast.Call) and (getattr(c.func, "attr", None) in ("read_text", "read") or getattr(c.func, "id", None) == "open")
+                                for c in ast.walk(side))
+                    if not reads or gives(side):
+                        continue                         # the side that is compared with what the process gave, and is a file
+                    cands = [c.value for c in ast.walk(side) if isinstance(c, ast.Constant) and isinstance(c.value, str) and _A_FILE_NAME.fullmatch(c.value)]
+                    path = next((p for p in (find(c) for c in cands) if p), None) if find else None
+                    if path is None:
+                        unread += 1
+                    elif _A_PRINTED_FLOAT.search(read(path)) or _A_SIGNED_ZERO.search(read(path)):
+                        findings.append((fn.name, a.lineno, "the committed file " + path))
+                    else:
+                        whole += 1
+    return findings, unread, whole
+
+
+def _parts_of(test):
+    """the parts of an assert that each say one thing: the operands of its `and`s and `or`s.  A part that says something is
+    NOT there (`not in`, `!=`, `not ...`) pins nothing and is left out."""
+    if isinstance(test, ast.BoolOp):
+        for v in test.values:
+            yield from _parts_of(v)
+    elif isinstance(test, ast.UnaryOp) and isinstance(test.op, ast.Not):
+        return
+    elif isinstance(test, ast.Compare) and all(isinstance(op, (ast.NotIn, ast.NotEq)) for op in test.ops):
+        return
+    else:
+        yield test
+
+
+def _finder(rel, tracked):
+    """for one lock: the tracked file a bare file name stands for -- beside the lock, or the only tracked file of that name"""
+    def find(name):
+        beside = os.path.normpath(os.path.join(os.path.dirname(rel), name)).replace(os.sep, "/")
+        if beside in tracked:
+            return beside
+        ends = [t for t in tracked if t.endswith("/" + name.lstrip("./"))]
+        return ends[0] if len(ends) == 1 else None
+    return find
+
+
+def _read_tracked(path):
+    try:
+        return open(os.path.join(ROOT, path), encoding="utf-8", errors="replace").read()
+    except OSError:
+        return ""
+
+
 def _lock_files():
