 import ast
 import operator
 import os
+import re
 import subprocess
 import sys
 
@@ -249,6 +250,44 @@ def cannot_fail(fn):
     return True
 
 
+_SWITCH = re.compile(r"\b(skip|skipif|xfail|importorskip)\b")
+
+
+def switches(src):
+    """What can keep each test of a lock from running, read from the lock's source and not by running it.
+
+    Returns a table: for each test function (a method as Class.name) the number of skip, skipif and xfail marks on it or
+    on its class, and of the calls in its body that skip; and under "" the module's own: a `pytestmark` that skips, a
+    skip at import, `__test__ = False`.  None where the source does not parse.
+
+    Added 2026-11-11 (WP-0.7, series 4).  One of main's unseen cases made a test skip, and it was caught only because
+    the file's hash was listed: no gate looked for a skip.  The gate holds this table to what it was (gates.py,
+    tests_switched_off): a test does not leave its lock, and does not gain a way not to run, without a recorded act."""
+    try:
+        tree = ast.parse(src)
+    except SyntaxError:
+        return None
+    out = {"": 0}
+    for n in tree.body:
+        if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "pytestmark" for t in n.targets) and _SWITCH.search(ast.unparse(n.value)):
+            out[""] += 1
+        if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "__test__" for t in n.targets) and ast.unparse(n.value) == "False":
+            out[""] += 1
+        if isinstance(n, ast.Expr) and isinstance(n.value, ast.Call) and _SWITCH.search(ast.unparse(n.value.func)):
+            out[""] += 1
+
+    def visit(body, prefix, inherited):
+        for n in body:
+            if isinstance(n, ast.ClassDef):
+                visit(n.body, prefix + n.name + ".", inherited + sum(1 for d in n.decorator_list if _SWITCH.search(ast.unparse(d))))
+            elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef)) and n.name.startswith("test"):
+                marks = sum(1 for d in n.decorator_list if _SWITCH.search(ast.unparse(d)))
+                calls = sum(1 for x in ast.walk(n) if isinstance(x, ast.Call) and _SWITCH.search(ast.unparse(x.func)))
+                out[prefix + n.name] = inherited + marks + calls
+    visit(tree.body, "", 0)
+    return out
+
+
