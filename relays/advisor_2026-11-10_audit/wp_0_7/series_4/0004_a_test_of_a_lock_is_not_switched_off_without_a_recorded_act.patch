diff --git a/scripts/gates/gates.py b/scripts/gates/gates.py
index cb8ff5f08..6f9fe193c 100644
--- a/scripts/gates/gates.py
+++ b/scripts/gates/gates.py
@@ -1099,6 +1099,66 @@ def locks_that_left(anchor=None, repo=None, named=None):
     return None, note
 
 
+# WP-0.7, series 4 (main's unseen case for series 2 that was caught by accident, M5): a test made to skip was caught only because
+# its file's hash is listed; no gate looked for a skip, and a test outside the lists could be switched off unseen.  The rule of
+# series 2, taken down to the test: since NOTHING_LEAVES_FROM, a test function does not leave its lock, and does not gain a way
+# not to run (a skip, skipif or xfail mark on it, on its class or on its module; a call in its body that skips), without a
+# recorded act.  A new test may come with a skip: main's slow lanes do.  A lock that was added after the anchor is held to
+# what it was when it was added.  Read, not run: a skip that a helper or a fixture decides is not seen.
+def tests_switched_off(anchor=None, repo=None, left=None, raised=None):
+    """(problem, note), as left_the_ledger returns them.  The named ones are under "tests" in LEFT_BY_NAME (a test that
+    left, as 'path::name') and under "skips" in RAISED_BY_NAME (a test that may now skip)."""
+    anchor = anchor or NOTHING_LEAVES_FROM
+    repo = str(repo or ROOT)
+    git, why = _since_the_anchor(anchor, repo)
+    if why:
+        return why, ""
+    sys.path.insert(0, os.path.join(ROOT, "scripts", "checks"))
+    try:
+        import check_test_vacuity as ctv
+    except Exception as exc:
+        return f"cannot verify: the vacuity checker is missing or unimportable ({exc})", ""
+    finally:
+        sys.path.pop(0)
+    left = LEFT_BY_NAME.get("tests", {}) if left is None else left
+    raised = RAISED_BY_NAME.get("skips", {}) if raised is None else raised
+    gone, can_skip, by_name = [], [], []
+    for line in git("diff", "--name-status", "-M", anchor, "--", ":(glob)**/test_*.py").stdout.splitlines():
+        parts = line.split("\t")
+        status, old, new = parts[0][:1], parts[1], parts[-1]
+        if status == "A":                                   # added after the anchor: held to what it was when it was added
+            first = git("log", "--first-parent", "--diff-filter=A", "--format=%H", f"{anchor}..HEAD", "--", new).stdout.split()
+            if not first:
+                continue                                    # not committed yet: nothing to hold it to
+            was = git("show", f"{first[-1]}:{new}")
+        elif status in "MR":
+            was = git("show", f"{anchor}:{old}")
+        else:
+            continue                                        # deleted: the file's own leaving is locks_that_left's
+        full = os.path.join(repo, new)
+        if was.returncode != 0 or not os.path.isfile(full):
+            continue
+        before, now = ctv.switches(was.stdout), ctv.switches(open(full, encoding="utf-8", errors="replace").read())
+        if before is None:
+            continue
+        if now is None:
+            gone.append(f"{new} (it no longer parses)")
+            continue
+        for name, n in sorted(before.items()):
+            key = f"{new}::{name}" if name else f"{new} (the whole file)"
+            if name and name not in now:
+                (by_name if str(left.get(key, "")).strip() else gone).append(key)
+            elif now.get(name, 0) > n:
+                (by_name if str(raised.get(key, "")).strip() else can_skip).append(key)
+    note = f"; {len(by_name)} test(s) left a lock or may now skip, by name since {anchor[:9]}" if by_name else ""
+    if gone or can_skip:
+        return ((f"{len(gone)} test(s) left a lock" + (": " + "; ".join(gone[:4]) if gone else "") + f", and {len(can_skip)} may now skip"
+                 + (": " + "; ".join(can_skip[:4]) if can_skip else "") + f", since {anchor[:9]} with no record. A test does not leave its lock, "
+                 "and is not given a way not to run, without a recorded act: put it back, or name it under 'tests' in LEFT_BY_NAME or "
+                 "under 'skips' in RAISED_BY_NAME, with its date and why"), note)
+    return None, note
+
+
