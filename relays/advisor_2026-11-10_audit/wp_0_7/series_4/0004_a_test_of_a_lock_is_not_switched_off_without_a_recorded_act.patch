+
+# ---- a test of a lock is not switched off (series 4; main's unseen case for series 2 that was caught by accident) ------
+_OFF = {
+    "a skip mark": lambda t: t.replace("def test_one(", "import pytest\n\n\n@pytest.mark.skip(reason='not now')\ndef test_one("),
+    "a skipif mark": lambda t: t.replace("def test_one(", "import pytest\n\n\n@pytest.mark.skipif(True, reason='x')\ndef test_one("),
+    "an xfail mark": lambda t: t.replace("def test_one(", "import pytest\n\n\n@pytest.mark.xfail\ndef test_one("),
+    "a call that skips, in its body": lambda t: "import pytest\n\n\n" + t.replace("    assert", "    pytest.skip('not now')\n    assert"),
+    "an importorskip in its body": lambda t: "import pytest\n\n\n" + t.replace("    assert", "    pytest.importorskip('a_package_nobody_has')\n    assert"),
+    "a mark on the whole module": lambda t: "import pytest\n\npytestmark = pytest.mark.skip(reason='the whole file')\n\n\n" + t,
+    "a skip at the module's import": lambda t: "import pytest\n\npytest.importorskip('a_package_nobody_has')\n\n\n" + t,
+    "the module told it holds no test": lambda t: "__test__ = False\n\n\n" + t,
+}
+
+
+def test_a_test_made_to_skip_turns_the_vacuity_gate_red_in_every_form(tmp_path):
+    """the case as main ran it: a test of a lock that no list of hashes names is made to skip.  No gate looked for a skip."""
+    for name, switch_off in _OFF.items():
+        repo, anchor = _scratch(tmp_path / name.replace(" ", "_").replace(",", "").replace("'", ""), _LOCKS)
+        assert _gate(repo, "test-vacuity", anchor)[0] is True
+        _commit(repo, "a test is switched off: " + name, {"tests/test_one.py": switch_off(_LOCKS["tests/test_one.py"])})
+        ok, detail = _gate(repo, "test-vacuity", anchor)
+        assert ok is False, f"a test of a lock was switched off ({name}), and the vacuity gate passed: {detail}"
+        assert "may now skip" in detail and "tests/test_one.py" in detail, (name, detail)
+
+
+def test_a_test_that_may_now_skip_passes_only_by_a_recorded_act(tmp_path):
+    repo, anchor = _scratch(tmp_path, _LOCKS)
+    _commit(repo, "a test is made to skip", {"tests/test_one.py": _OFF["a skipif mark"](_LOCKS["tests/test_one.py"])})
+    ok, detail = _gate(repo, "test-vacuity", anchor)
+    assert ok is False, "a test of a lock was given a skipif mark with no record, and the vacuity gate passed: " + detail
+    assert "tests/test_one.py::test_one" in detail
+    p = repo / "scripts" / "gates" / "gates.py"
+    src = p.read_text(encoding="utf-8")
+    assert src.count("RAISED_BY_NAME = {}") == 1
+    p.write_text(src.replace("RAISED_BY_NAME = {}", "RAISED_BY_NAME = {'skips': {'tests/test_one.py::test_one': '2026-11-12 -- it needs a package the review machine lacks'}}"), encoding="utf-8")
+    _commit(repo, "the act recorded")
+    ok, detail = _gate(repo, "test-vacuity", anchor)
+    assert ok is True and "1 test(s) left a lock or may now skip, by name" in detail, detail
+
+
+def test_a_test_function_that_leaves_its_lock_has_left(tmp_path):
+    """renamed so that it is no longer collected, or deleted, with the file kept: the lock stands and tests less"""
+    two = _LOCKS["tests/test_one.py"] + "\n\ndef test_one_more():\n    assert sum([2, 2]) == 4\n"
+    repo, anchor = _scratch(tmp_path, dict(_LOCKS, **{"tests/test_one.py": two}))
+    _commit(repo, "a test renamed out of collection", {"tests/test_one.py": two.replace("def test_one_more(", "def _test_one_more(")})
+    ok, detail = _gate(repo, "test-vacuity", anchor)
+    assert ok is False, "a test function was renamed so that it is not collected, and the vacuity gate passed: " + detail
+    assert "1 test(s) left a lock: tests/test_one.py::test_one_more" in detail
+    _name_in_the_gate(repo, "tests", "tests/test_one.py::test_one_more", "2026-11-12 -- the claim it locked was corrected (B12); its lock was rewritten")
+    _commit(repo, "the act recorded")
+    ok, detail = _gate(repo, "test-vacuity", anchor)
+    assert ok is True and "by name" in detail, detail
+
+
+def test_a_new_test_may_come_with_a_skip_and_a_skip_may_be_taken_off(tmp_path):
+    """the other side.  Main's slow lanes are tests that come with a skipif; a new lock may hold one; and a skip that is
+    removed is no rise.  None of these needs a record."""
+    marked = "import pytest\n\n\n@pytest.mark.skipif(True, reason='slow')\ndef test_slow():\n    assert sum([1, 2]) == 3\n"
+    repo, anchor = _scratch(tmp_path, dict(_LOCKS, **{"tests/test_marked.py": marked}))
+    _commit(repo, "a new test with a skip, in a lock that was there", {"tests/test_one.py": _LOCKS["tests/test_one.py"] + "\n\nimport pytest\n\n\n@pytest.mark.skipif(True, reason='slow')\ndef test_one_slow():\n    assert sum([1, 2]) == 3\n"})
+    _commit(repo, "a new lock that holds a skip", {"tests/test_new.py": marked.replace("test_slow", "test_new_slow")})
+    _commit(repo, "a skip taken off", {"tests/test_marked.py": marked.replace("@pytest.mark.skipif(True, reason='slow')\n", "")})
+    ok, detail = _gate(repo, "test-vacuity", anchor)
+    assert ok is True and "by name" not in detail, detail
+
+
+def test_a_lock_added_after_the_anchor_is_held_to_what_it_was_when_it_was_added(tmp_path):
+    repo, anchor = _scratch(tmp_path, _LOCKS)
+    late = "def test_late():\n    assert sum([1, 2]) == 3\n"
+    _commit(repo, "a lock added after the anchor", {"frontier/B11_an_arc/verification/test_b11_late.py": late})
+    assert _gate(repo, "test-vacuity", anchor)[0] is True
+    _commit(repo, "and switched off", {"frontier/B11_an_arc/verification/test_b11_late.py": "import pytest\n\n\n@pytest.mark.skip(reason='x')\n" + late})
+    ok, detail = _gate(repo, "test-vacuity", anchor)
+    assert ok is False, "a lock added after the anchor was switched off, and the vacuity gate passed: " + detail
+    assert "test_b11_late.py::test_late" in detail
+
+
+def test_on_this_repository_no_test_has_been_switched_off_since_the_anchor():
+    g = _gates()
+    problem, note = getattr(g, "tests_switched_off", lambda: ("the gates do not look for a test that is switched off", ""))()
+    assert problem is None and note == "", (problem, note)
+
