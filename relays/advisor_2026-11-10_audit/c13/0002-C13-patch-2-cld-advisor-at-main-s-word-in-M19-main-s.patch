+        o.append("- **First met:** %s%s." % (w["first"], "" if w["first_date"] in (None, "", "not stated") else " (%s)" % w["first_date"]))
+        o.append("- **Settled without a pick (%d):** %s." % (len(w["settled_without_a_pick"]), lst(w["settled_without_a_pick"])))
+        o.append("- **The question was found to be wrong (%d):** %s." % (len(w["question_was_wrong"]), lst(w["question_was_wrong"])))
+        o.append("- **Later corrected or retracted (%d):** %s." % (len(w["later_corrected"]), lst(w["later_corrected"])))
+        o += ["", "| tried by | arcs | settled | partly | not | the question was wrong | later corrected |", "|---|---|---|---|---|---|---|"]
+        for k, c in w["kinds"].items():
+            o.append("| %s | %d | %s |" % (L["names"][k], sum(c), " | ".join(str(x) for x in c)))
+    return "\n".join(o) + "\n"
+
