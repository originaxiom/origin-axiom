+WALLS_HEADER = ("<!-- GENERATED by scripts/views/generate.py -- DO NOT EDIT BY HAND.\n"
+                "     Source of truth: " + WALLS_ARC + "/verification/rows.json.txt.\n"
+                "     Hand-editing a generated view reintroduces exactly the drift it prevents. -->\n\n")
+
+
+def _walls_source():
+    """B1905's script, read and compiled without an import, so that no compiled file is left beside it"""
+    import types
+    p = os.path.join(ROOT, WALLS_ARC, "verification", "sweep_tables.py")
+    m = types.ModuleType("b1905_sweep_tables")
+    m.__file__ = p
+    exec(compile(open(p, encoding="utf-8").read(), p, "exec"), m.__dict__)
+    return m
+
+
+def walls_ledger(rows=None, st=None):
+    """the ledger as data: one entry a wall, in the order of B1905's classes.  `rows` default to B1905's file."""
+    st = st or _walls_source()
+    rows = st.load() if rows is None else rows
+    live = [r for r in rows if r["topic"] != "neither"]
+    num = lambda a: int(re.sub(r"\D", "", a) or 0)
+    wall = lambda r: r["wall"].split(" ")[0] if r["wall"][:1] == "W" else "?"
+    kinds = lambda r: sorted({p.split(" ")[0] for p in r["principle"] if p.split(" ")[0] in st.NAMES})
+    no_pick = lambda r: bool(st.NEG.search(r["outcome"])) and not st.POS.search(r["outcome"])
+    ids = lambda rs: [r["arc"] for r in rs]
+    out = []
+    for code, name in st.WALLS.items():
+        rs = sorted((r for r in live if wall(r) == code), key=lambda r: num(r["arc"]))
+        if not rs:
+            out.append(dict(code=code, name=name, arcs=0, first=None, first_date=None, by_outcome=[0] * len(st.S), settled_without_a_pick=[],
+                            question_was_wrong=[], later_corrected=[], kinds={}))
+            continue
+        out.append(dict(
+            code=code, name=name, arcs=len(rs), first=rs[0]["arc"], first_date=rs[0]["date"],
+            by_outcome=[sum(r["settled"] == s for r in rs) for s in st.S],
+            settled_without_a_pick=ids(r for r in rs if r["settled"] == "yes" and no_pick(r)),
+            question_was_wrong=ids(r for r in rs if r["settled"] == "question was wrong"),
+            later_corrected=ids(r for r in rs if r["settled"] == "later corrected or retracted"),
+            kinds={k: [sum(1 for r in rs if k in kinds(r) and r["settled"] == s) for s in st.S]
+                   for k in st.NAMES if any(k in kinds(r) for r in rs)}))
+    return dict(rows=len(rows), about=len(live), neither=len(rows) - len(live), walls=out, names=dict(st.NAMES))
+
+
+def view_walls(ledger=None):
+    L = walls_ledger() if ledger is None else ledger
+    lst = lambda xs: ", ".join(xs) if xs else "none"
+    o = [WALLS_HEADER + "# The ledger of walls", "",
+         "*Read a wall's row before a selection or a hand is claimed (`WORKING_RULES.md`, the rule of 2026-11-12). "
+         "The sweep prints it: `python3 scripts/checks/topic_sweep.py \"<expression>\"`.*", "",
+         "- **What it is made of:** the rows of B1905 (`%s/verification/rows.json.txt`), %d rows, one an arc; %d are about selection or "
+         "chirality on reading and are sorted here, %d are not." % (WALLS_ARC, L["rows"], L["about"], L["neither"]),
+         "- **Whose the classes are:** the readers', one reader an arc. They are not independently checked.",
+         "- **\"First met\"** is the arc of the wall with the lowest number: arcs are numbered in the order they were opened, and many rows give no date.",
+         "- **\"Settled without a pick\"** is a reading by a list of words: the row says the arc settled the question it asked, and its outcome has "
+         "a word of denial and no word of a pick (the two lists of B1905's script). Most such arcs prove that a route does not do what was hoped of it. It is not a judgement of the arc.",
+         "- **An arc that combines kinds of principle is counted under each.**", "",
