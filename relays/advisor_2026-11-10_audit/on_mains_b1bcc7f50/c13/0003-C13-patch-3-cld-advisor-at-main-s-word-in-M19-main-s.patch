+        if m.group(1) in out and m.group(2).strip() != "its name alone":
+            out[m.group(1)]["words"] = [w.strip() for w in m.group(2).split(";") if w.strip()]
+    return [out[k] for k in sorted(out, key=lambda c: int(c[1:]))]
