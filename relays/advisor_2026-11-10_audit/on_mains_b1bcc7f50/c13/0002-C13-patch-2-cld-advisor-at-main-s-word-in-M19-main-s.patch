+    for w in L["walls"]:
+        o.append("| %s, %s | %d | %s | %s |" % (w["code"], w["name"], w["arcs"], w["first"] or "—", " | ".join(str(x) for x in w["by_outcome"])))
+    for w in L["walls"]:
