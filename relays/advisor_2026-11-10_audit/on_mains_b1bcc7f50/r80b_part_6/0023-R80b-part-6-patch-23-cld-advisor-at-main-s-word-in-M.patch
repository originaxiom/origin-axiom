+          % (len(others), len([n for n in nodes if n["kind"] != "debt"]), len(lone_debts), len([n for n in nodes if n["kind"] == "debt"]), len(others)),
+          "", "| id | layer | kind | grade |", "|---|---|---|---|"]
+    for n in others:
+        L.append("| %s | %s | %s | %s |" % (n["id"], n["layer"], n["kind"], n["grade"]))
     return "\n".join(L) + "\n"
 
 
