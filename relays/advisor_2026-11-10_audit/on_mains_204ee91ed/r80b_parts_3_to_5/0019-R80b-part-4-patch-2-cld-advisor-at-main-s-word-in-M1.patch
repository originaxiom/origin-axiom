 scripts/seats/listen.py     | 16 ++++++++++++++--
 tests/test_seat_listener.py | 33 +++++++++++++++++++++++++++++++++
 2 files changed, 47 insertions(+), 2 deletions(-)

diff --git a/scripts/seats/listen.py b/scripts/seats/listen.py
