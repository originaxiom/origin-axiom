+def _the_scripts():
+    for p in sorted((ROOT / "frontier").rglob("*.py")):
+        rel = p.relative_to(ROOT).as_posix()
+        if rel.startswith(HISTORY) or any(h in rel for h in HISTORY):
+            continue
+        try:
+            yield rel, p.read_text(encoding="utf-8")
+        except Exception:
+            continue
