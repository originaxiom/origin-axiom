+    ("B1878", "the verdict file made invalid JSON", lambda: (arc("B1878") / "arc_verdict.json").write_text("{ this is not json\n", encoding="utf-8")),
+    # --- B1885 (row 31)
+    ("B1885", "nothing planted", None),
