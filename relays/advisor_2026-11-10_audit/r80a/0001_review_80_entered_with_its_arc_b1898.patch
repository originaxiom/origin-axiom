+say(44, "(b) the key of a test is the file and the function's name, with no class", 'f"{rel}::{fn.name}"' if 'f"{rel}::{fn.name}"' in src else "differs", 'f"{rel}::{fn.name}"' in src and "ClassDef" not in src)
