+"""The grade of a verdict is held to the evidence it names (the closure programme's WP-0.9, series 1; the audit's M1).
+
+A verdict file said PROVED, NEGATIVE, OPEN or RETRACTED, and nothing of what kind of support the word has: a theorem, an
+exact computation, a numerical estimate, sealed cells that held, or the record's own process.  The field `grade` says it,
+`grade_evidence` names the files it rests on, and the gate on the arcs' data holds the one to the other.
+
+Each test makes the situation in a small repository of its own, which holds this repository's gates and checkers and one or
+two arcs, and runs the gate there."""
+import importlib.util
+import json
+import pathlib
+import shutil
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+ARC = "B9_an_arc"
+HERE = "frontier/" + ARC + "/"
+LOCK = "def test_the_sum():\n    assert sum(range(10)) == 45\n"
+CANNOT_FAIL = "def test_the_sum():\n    assert 2 + 2 == 4\n"
+FILES = {        # what an arc may hold, by a short name
+    "findings": (HERE + "FINDINGS.md", "# FINDINGS\n\nAn arc.\n"),
+    "lock": (HERE + "verification/test_b9_an_arc.py", LOCK),
+    "a lock in tests/": ("tests/test_b9_an_arc.py", LOCK),
+    "a lock that cannot fail": (HERE + "verification/test_b9_cannot_fail.py", CANNOT_FAIL),
+    "script": (HERE + "verification/sum.py", "print(sum(range(10)))\n"),
+    "output": (HERE + "verification/sum_run.txt", "45\n"),
+    "seal": (HERE + "PREREGISTRATION.md", "# A seal\n\nThirteen cells.\n"),
+    "another arc's lock": ("frontier/B8_another_arc/verification/test_b8_another_arc.py", LOCK),
+}
+
+
+def _gates():
+    spec = importlib.util.spec_from_file_location("gates_for_the_grade_rule", ROOT / "scripts" / "gates" / "gates.py")
+    g = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(g)
+    return g
+
+
+def _git(repo, *a):
+    r = subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid", *a], capture_output=True, text=True)
+    assert r.returncode == 0, r.stderr
+    return r.stdout.strip()
+
+
+def _verdict(folder=ARC, **fields):
+    d = {"id": folder.split("_")[0], "verdict": "PROVED", "instrument": False, "claim_one_line": "an arc", "depends_on": []}
+    d.update(fields)
+    return json.dumps(d, indent=1) + "\n"
+
+
+def _repo(tmp_path, holds, edit_gates=None, **fields):
+    """a small repository: this repository's gates and checkers, and one arc that holds the named files and whose verdict
+    file carries `fields`"""
+    repo = tmp_path / "repo"
+    if repo.exists():
+        shutil.rmtree(repo)
+    skip = shutil.ignore_patterns("__pycache__", "*.pyc")
+    shutil.copytree(ROOT / "scripts" / "gates", repo / "scripts" / "gates", ignore=skip)
+    shutil.copytree(ROOT / "scripts" / "checks", repo / "scripts" / "checks", ignore=skip)
+    if edit_gates:
+        p = repo / "scripts" / "gates" / "gates.py"
+        p.write_text(edit_gates(p.read_text(encoding="utf-8")), encoding="utf-8")
+    files = dict(FILES[name] for name in holds)
+    files[HERE + "arc_verdict.json"] = _verdict(**fields)
+    files.setdefault(HERE + "FINDINGS.md", FILES["findings"][1])
+    if "another arc's lock" in holds:
+        files["frontier/B8_another_arc/arc_verdict.json"] = _verdict("B8_another_arc")
+        files["frontier/B8_another_arc/FINDINGS.md"] = "# FINDINGS\n\nAnother arc.\n"
+    for rel, text in files.items():
+        (repo / rel).parent.mkdir(parents=True, exist_ok=True)
+        (repo / rel).write_text(text, encoding="utf-8")
+    _git(repo, "init", "-q"); _git(repo, "add", "-A"); _git(repo, "commit", "-q", "-m", "a small repository")
+    return repo
+
+
+_RUN = ("import sys, json, importlib.util\nsys.dont_write_bytecode = True\n"
+        "s = importlib.util.spec_from_file_location('scratch_gates', 'scripts/gates/gates.py')\n"
+        "g = importlib.util.module_from_spec(s); s.loader.exec_module(g)\n"
+        "r = g.GATES['arc-data']()\nprint(json.dumps([bool(r[0]), r[1] if isinstance(r[1], str) else ' | '.join(map(str, r[1]))]))\n")
+
+
+def _gate(repo):
+    r = subprocess.run([sys.executable, "-B", "-c", _RUN], cwd=str(repo), capture_output=True, text=True)
+    assert r.returncode == 0, r.stderr[-800:]
+    return json.loads(r.stdout.strip().splitlines()[-1])
+
+
+def _paths(*names):
+    return [FILES[n][0] for n in names]
+
+
+def test_a_verdict_file_with_no_grade_passes_as_it_did(tmp_path):
+    """the control: this held before the series, and holds after it.  The field is asked of no arc that does not owe it"""
+    ok, detail = _gate(_repo(tmp_path, ["lock"]))
+    assert ok is True and "1 verdict files" in detail, detail
+
+
+def test_a_grade_that_is_not_one_of_the_five_words_is_refused(tmp_path):
+    ok, detail = _gate(_repo(tmp_path, ["lock"], grade="proved beyond doubt", grade_evidence=_paths("lock")))
+    assert ok is False, "a verdict file carries a grade that is not one of the programme's five words, and the gate reads: " + detail
+    assert ARC in detail and "one of" in detail
+    ok, detail = _gate(_repo(tmp_path, ["lock"], grade_evidence=_paths("lock")))
+    assert ok is False and "no grade" in detail, "evidence for a grade and no grade: " + detail
+
+
+def test_a_grade_whose_evidence_is_not_in_the_tree_is_refused(tmp_path):
+    ok, detail = _gate(_repo(tmp_path, ["script"], grade="exact computation", grade_evidence=_paths("script", "lock")))
+    assert ok is False, "a grade names a lock that is not in the tree, and the gate reads: " + detail
+    assert "test_b9_an_arc.py" in detail
+    for bad in ("../outside.py", "/etc/hostname"):
+        ok, detail = _gate(_repo(tmp_path, ["lock"], grade="theorem", grade_evidence=_paths("lock") + [bad]))
+        assert ok is False, (bad, detail)
+
+
+_MORE_THAN_ITS_EVIDENCE = {       # a grade that says more than what it names -> (the files the arc holds, the fields of its verdict file)
+    "a theorem that names its findings page": (["findings"], dict(grade="theorem", grade_evidence=_paths("findings"))),
+    "a theorem that names a lock in which no assert can fail": (["a lock that cannot fail"], dict(grade="theorem", grade_evidence=_paths("a lock that cannot fail"))),
+    "a theorem that names nothing": ([], dict(grade="theorem", grade_evidence=[])),
+    "a theorem that names another arc's lock": (["another arc's lock"], dict(grade="theorem", grade_evidence=_paths("another arc's lock"))),
+    "an exact computation that names a lock and no script": (["lock"], dict(grade="exact computation", grade_evidence=_paths("lock"))),
+    "an exact computation that names a script and no lock": (["script"], dict(grade="exact computation", grade_evidence=_paths("script"))),
+    "a numerical estimate that names a script and no output": (["script"], dict(grade="numerical estimate", grade_evidence=_paths("script"))),
+    "sealed cells held that names no sealed file": (["lock"], dict(grade="sealed cells held", grade_evidence=_paths("lock"), grade_cells=[7, 13])),
+    "sealed cells held with no count": (["seal"], dict(grade="sealed cells held", grade_evidence=_paths("seal"))),
+    "sealed cells held with more held than sealed": (["seal"], dict(grade="sealed cells held", grade_evidence=_paths("seal"), grade_cells=[14, 13])),
+    "sealed cells held with a count that is not a pair of whole numbers": (["seal"], dict(grade="sealed cells held", grade_evidence=_paths("seal"), grade_cells=["7", "13"])),
+}
+
+
+def test_each_word_asks_its_own_kind_of_evidence(tmp_path):
+    passed = []
+    for what, (holds, fields) in _MORE_THAN_ITS_EVIDENCE.items():
+        ok, detail = _gate(_repo(tmp_path, holds, **fields))
+        if ok or ARC not in detail:
+            passed.append(what)
+    assert not passed, "a grade says more than the evidence it names, and the gate passes for: " + "; ".join(passed)
+
+
+_HELD = {
+    "theorem": (["lock"], dict(grade="theorem", grade_evidence=_paths("lock"))),
+    "theorem, its lock in tests/": (["a lock in tests/"], dict(grade="theorem", grade_evidence=_paths("a lock in tests/"))),
+    "exact computation": (["lock", "script"], dict(grade="exact computation", grade_evidence=_paths("lock", "script"))),
+    "numerical estimate": (["script", "output"], dict(grade="numerical estimate", grade_evidence=_paths("script", "output"))),
+    "sealed cells held": (["seal"], dict(grade="sealed cells held", grade_evidence=_paths("seal"), grade_cells=[7, 13])),
+    "process": ([], dict(grade="process")),
+}
+
+
+def test_a_grade_with_its_evidence_passes_for_each_of_the_five_words(tmp_path):
+    """the other side"""
+    for what, (holds, fields) in _HELD.items():
+        ok, detail = _gate(_repo(tmp_path, holds, **fields))
+        assert ok is True, (what, detail)
+        assert "1 carry a grade, each held to the evidence it names (1 %s)" % fields["grade"] in detail, (what, detail)
+    g = _gates()
+    assert g.result_line("arc-data", ok, detail).startswith("  PASS  arc-data: ok (1 verdict files"), "the runner does not print the sentence"
+
+
+def _first_of_the_chain():
+    chain = getattr(_gates(), "GRADE_CHAIN", None)
+    assert chain, "the gates name no arc that owes a grade"
+    return chain[0]
+
+
+def test_an_arc_the_candidate_runs_on_owes_a_grade_and_is_held_by_name(tmp_path):
+    folder = _first_of_the_chain()
+    files = {"frontier/%s/arc_verdict.json" % folder: _verdict(folder), "frontier/%s/FINDINGS.md" % folder: "# FINDINGS\n"}
+
+    def with_the_arc(repo):
+        for rel, text in files.items():
+            (repo / rel).parent.mkdir(parents=True, exist_ok=True)
+            (repo / rel).write_text(text, encoding="utf-8")
+        _git(repo, "add", "-A"); _git(repo, "commit", "-q", "-m", "an arc the candidate runs on")
+        return repo
+    ok, detail = _gate(with_the_arc(_repo(tmp_path, ["lock"])))
+    assert ok is True and "1 of the 14 arcs the candidate runs on owe one, held by name as found" in detail, detail
+    # taken off the list of those that owe one, and still with no grade, it fails
+    repo = with_the_arc(_repo(tmp_path, ["lock"], edit_gates=lambda text: _only_from_owed(text, folder)))
+    ok, detail = _gate(repo)
+    assert ok is False and folder in detail, "an arc the candidate runs on has no grade and is on no list, and the gate reads: " + detail
+
+
+def _only_from_owed(text, folder):
+    """the gates' text with `folder` taken out of the list of the arcs that owe a grade, and left in the chain"""
+    head, tail = text.split("GRADE_OWED_AS_FOUND = frozenset((", 1)
+    assert ('"%s",' % folder) in tail.split("))", 1)[0]
+    body, rest = tail.split("))", 1)
+    return head + "GRADE_OWED_AS_FOUND = frozenset((" + body.replace('"%s",' % folder, "", 1) + "))" + rest
+
+
+def test_on_this_repository_the_chain_is_mains_fourteen_and_the_gate_passes():
+    g = _gates()
+    chain = getattr(g, "GRADE_CHAIN", None)
+    assert chain is not None, "the gates hold no list of the arcs the candidate runs on"
+    measured = json.loads(sorted((ROOT / "frontier").glob("B1888_*/verification/candidate_chain.json"))[0].read_text(encoding="utf-8"))["arcs"]
+    assert list(chain) == measured and len(chain) == 14          # typed in the gates' file, and held here to main's own measurement
+    assert set(g.GRADE_OWED_AS_FOUND) <= set(chain)
+    for folder in chain:
+        assert (ROOT / "frontier" / folder / "arc_verdict.json").is_file(), folder
+    ok, detail = g.gate_arc_data()
+    assert ok is True and "arcs the candidate runs on owe one, held by name as found" in detail, detail
