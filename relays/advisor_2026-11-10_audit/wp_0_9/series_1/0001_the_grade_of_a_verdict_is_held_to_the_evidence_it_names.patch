+# THE GRADE OF A VERDICT (the closure programme's WP-0.9, series 1; the advisor seat's audit, M1: "PROVED means at least five
+# things").  A verdict file says PROVED, NEGATIVE, OPEN or RETRACTED.  The field `grade` says what kind of support that word
+# has, in one of the programme's five words, and `grade_evidence` names the files of the arc it rests on.  The gate holds the
+# word to what it names.  It reads a form: that a theorem names a lock in which an assert can fail, not that the lock proves
+# the claim.  The five words are not the nine labels of how a result was checked (docs/seats/README.md, § 12): a grade says
+# what the support is, a label says who looked at it and how.
+GRADES = ("theorem", "exact computation", "numerical estimate", "sealed cells held", "process")
+GRADE_ASKS = {
+    "theorem": "a lock of its own in which an assert can fail",
+    "exact computation": "its script, and a lock of its own in which an assert can fail",
+    "numerical estimate": "its script and the committed output of it",
+    "sealed cells held": "its sealed file, and grade_cells as [held, sealed] with held no more than sealed",
+    "process": "nothing",
+}
+SEAL_PATTERNS = ("PREREG*", "*DESIGN*.md", "SEALED*.md", "DECLARATION.md")          # as scripts/seal_ledger.py names a sealed-style file
+
+
+def _vacuity():
+    sp = importlib.util.spec_from_file_location("check_test_vacuity_for_the_grades", os.path.join(os.path.dirname(os.path.abspath(__file__)), "check_test_vacuity.py"))
+    m = importlib.util.module_from_spec(sp); sp.loader.exec_module(m)
+    return m
+
+
+def _a_lock_that_can_fail(path, ctv):
+    """a file named test_*.py that holds at least one test in which an assert can fail"""
+    if not (os.path.basename(path).startswith("test_") and path.endswith(".py")):
+        return False
+    try:
+        tree = ast.parse(open(path, encoding="utf-8").read())
+    except Exception:
+        return False
+    for fn in ast.walk(tree):
+        if isinstance(fn, (ast.FunctionDef, ast.AsyncFunctionDef)) and fn.name.startswith("test"):
+            asserts = [n for n in ast.walk(fn) if isinstance(n, ast.Assert)]
+            calls = {getattr(getattr(n, "func", None), "attr", None) for n in ast.walk(fn) if isinstance(n, ast.Call)}
+            if (asserts or (ctv._OK_CALLS & calls)) and not ctv.cannot_fail(fn):
+                return True
+    return False
+
+
+def _its_own(folder, arc_id, path):
+    """is this path the arc's own: under its folder, or a lock in tests/ that carries its number?"""
+    if path.startswith("frontier/%s/" % folder):
+        return True
+    return bool(re.match(r"tests/test_%s_[^/]*\.py$" % re.escape(str(arc_id).lower()), path))
+
+
+def grade_problems(root=ROOT, chain=(), owed=()):
+    """The grades the verdict files carry, each held to the evidence it names.  `chain` is the arcs that must carry one (the
+    arcs the candidate runs on); `owed` the ones among them that are let off by name until they do.  Returns the classes G1
+    to G4, each a list of [folder, what is wrong]; under "grades" how many verdict files carry each word; under "owed" the
+    arcs of the chain that carry none and are named; under "paid" the named ones that carry one now."""
+    V, _folders, _bad = load(root)
+    ctv = _vacuity()
+    g1, g2, g3, g4 = [], [], [], []
+    count, still_owed, paid = collections.Counter(), [], []
+    for folder, d in sorted(V.items()):
+        if not isinstance(d, dict):
+            continue
+        grade = d.get("grade")
+        if grade is None:
+            if "grade_evidence" in d or "grade_cells" in d:
+                g1.append([folder, "evidence for a grade, and no grade"])
+            elif folder in chain:
+                (still_owed if folder in owed else g4).append(folder if folder in owed else [folder, "the candidate runs on it, it carries no grade, and it is not named among those that owe one"])
+            continue
+        if grade not in GRADES:
+            g1.append([folder, "%r is not one of: %s" % (grade, ", ".join(GRADES))])
+            continue
+        count[grade] += 1
+        if folder in owed:
+            paid.append(folder)
+        ev = d.get("grade_evidence", [])
+        if not isinstance(ev, list) or not all(isinstance(e, str) and e.strip() for e in ev):
+            g2.append([folder, "grade_evidence is a list of paths"])
+            continue
+        gone = [e for e in ev if os.path.isabs(e) or ".." in e.replace("\\", "/").split("/") or not os.path.isfile(os.path.join(root, e))]
+        if gone:
+            g2.append([folder, "not a file in the tree: " + ", ".join(gone[:3])])
+            continue
+        own = [e for e in ev if _its_own(folder, d.get("id"), e)]
+        locks = [e for e in own if _a_lock_that_can_fail(os.path.join(root, e), ctv)]
+        scripts = [e for e in own if e.endswith(".py") and not os.path.basename(e).startswith("test_")]
+        outputs = [e for e in own if not e.endswith(".py")]
+        seals = [e for e in own if e.count("/") == 2 and any(fnmatch.fnmatch(os.path.basename(e), pat) for pat in SEAL_PATTERNS)]
+        cells = d.get("grade_cells")
+        held = (isinstance(cells, list) and len(cells) == 2 and all(isinstance(c, int) and not isinstance(c, bool) for c in cells)
+                and 0 <= cells[0] <= cells[1] and cells[1] >= 1)
+        enough = {"theorem": bool(locks), "exact computation": bool(locks and scripts), "numerical estimate": bool(scripts and outputs),
+                  "sealed cells held": bool(seals and held), "process": True}[grade]
+        if not enough:
+            other = [e for e in ev if e not in own]
+            g3.append([folder, "%s asks %s%s" % (grade, GRADE_ASKS[grade], "; named and not the arc's own: " + ", ".join(other[:2]) if other else "")])
+    return {"G1 a grade that is not one of the five words": g1, "G2 a grade whose evidence is not in the tree": g2,
+            "G3 a grade that says more than the evidence it names": g3, "G4 an arc the candidate runs on with no grade": g4,
+            "grades": dict(count), "owed": still_owed, "paid": paid}
+
+
 def main():
     br = "--branches" in sys.argv; out = check(branches=br)
     if "--json" in sys.argv:
