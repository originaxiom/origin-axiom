+    a = _rerun(tmp_path / "a", _card(tmp_path / "a", n=n, d=d), prefix=prefix)
+    n, d = RR.decisive("DECISIVE: data = as committed\n")
+    b = _rerun(tmp_path / "b", _card(tmp_path / "b", n=n, d=d), prefix=prefix)
+    return a, b
