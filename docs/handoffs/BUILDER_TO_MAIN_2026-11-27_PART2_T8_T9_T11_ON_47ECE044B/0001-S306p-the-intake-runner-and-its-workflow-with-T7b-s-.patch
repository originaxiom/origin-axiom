+    return (["a file the round did not write: %s" % ", ".join(extra[:5])] if extra else []) + \
+           (["a file the round wrote is missing: %s" % ", ".join(lost[:5])] if lost else []) + \
+           (["a file is not as the round wrote it: %s" % ", ".join(changed[:5])] if changed else [])
