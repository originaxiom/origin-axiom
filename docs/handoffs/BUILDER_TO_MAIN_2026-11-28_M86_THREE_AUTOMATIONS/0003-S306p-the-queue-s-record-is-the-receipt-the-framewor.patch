+# ADDED 2026-11-28 (main's M86 point 3, the author's order that no chore waits on main): THE QUEUE'S RECORD IS THE
+# RECEIPT. A relay that delivers claim cards (it names one or more `relays/claims/CLAIM_*.md`) is answered when the queue's
+# branch holds a record for every card it delivers: the runner found and filed each, and its record says so. Main's hand
+# row stays for what the queue does not see (a seat's status, a question to main, a review). harvest_debt.py uses the same
+# reading for the relays on the seats' branches, and counts a card registered when the queue holds its record.
+QUEUE_REF = "origin/queue"
+CARD_PATH_RE = re.compile(r"relays/claims/CLAIM_[A-Za-z0-9_.\-]+\.md")
+
+
+def queue_places(ref: str = QUEUE_REF, root: pathlib.Path = ROOT) -> set:
+    """{(branch, card_path)}: every card the queue's branch holds a record of; empty when there is no queue's branch"""
+    import json
+    import subprocess
+    run = lambda *a: subprocess.run(["git", "-C", str(root), *a], capture_output=True, text=True, timeout=120)
+    r = run("ls-tree", "--name-only", "%s:queue/cards" % ref)
+    out = set()
+    for name in (r.stdout.split() if r.returncode == 0 else []):
+        s = run("show", "%s:queue/cards/%s" % (ref, name))
+        try:
+            rec = json.loads(s.stdout) if s.returncode == 0 else None
+        except ValueError:
+            rec = None
+        if isinstance(rec, dict) and rec.get("branch") and rec.get("card_path"):
+            out.add((rec["branch"], rec["card_path"]))
+    return out
+
+
+def delivered_cards(text: str, exists=None) -> set:
+    """the claim cards a relay delivers: the `relays/claims/CLAIM_*.md` paths it names (those that `exists` accepts, when
+    given: the cards on the relay's own branch)"""
+    named = set(CARD_PATH_RE.findall(text or ""))
+    return {p for p in named if exists is None or exists(p)}
+
+
+def answered_by_queue(text: str, places: set, branch: str = None, exists=None) -> bool:
+    """a card-delivery relay is answered when the queue holds a record for every card it delivers (on `branch`, when
+    given; on any branch otherwise); a relay that delivers no card is not answered by the queue"""
+    cards = delivered_cards(text, exists)
+    held = {p for b, p in places if branch is None or b == branch}
+    return bool(cards) and cards <= held
+
+
 def check() -> tuple[list[str], list[str], dict]:
     if not LEDGER.is_file():
         return ([f"{LEDGER.relative_to(ROOT)} is MISSING — the register is constitutive"], [], {})
