+"""2026-11-28 (main's M86 point 3, the author's order that no chore waits on main): the queue's record is the receipt.
+
+What could fail: a card the queue holds still asking main for a harvest row; a card-delivery relay whose cards the queue
+holds still asking for a relay row; or the other way, a card or a relay counted as answered when the queue does not hold
+every card, holds it on another branch, or the relay delivers no card at all (a seat's status, a question, a review)."""
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts" / "checks"))
+import harvest_debt as HD  # noqa: E402
+import relay_debt as RD  # noqa: E402
+
+A = "relays/claims/CLAIM_2026-11-28_a.md"
+B = "relays/claims/CLAIM_2026-11-28_b.md"
+RELAY = "Two cards: `%s` and %s, and the form in CLAIM_CARD.md." % (A, B)
+
+
+def test_a_relay_is_answered_only_when_the_queue_holds_every_card_it_delivers_on_its_branch():
+    both = {("s/x", A), ("s/x", B)}
+    assert RD.delivered_cards(RELAY) == {A, B}
+    assert RD.answered_by_queue(RELAY, both, "s/x")
+    assert not RD.answered_by_queue(RELAY, {("s/x", A)}, "s/x")                     # one card missing
+    assert not RD.answered_by_queue(RELAY, {("s/y", A), ("s/y", B)}, "s/x")         # held, but on another branch
+    assert RD.answered_by_queue(RELAY, {("s/y", A), ("s/y", B)})                    # main's tracked relays: any branch
+    assert not RD.answered_by_queue("my status: nothing to file. A question to main.", both, "s/x")   # no card: a row
+    assert RD.answered_by_queue(RELAY, {("s/x", A)}, "s/x", exists=lambda c: c == A)  # a card not on the branch is not one
+
+
+def test_relay_debt_lets_the_queue_answer_a_card_delivery_and_nothing_else(monkeypatch):
+    name = "SEAT_TO_MAIN_2026-11-28_two_cards.md"
+    monkeypatch.setattr(RD, "tracked_relays", lambda: {name})
+    monkeypatch.setattr(RD, "_read_tracked", lambda n: RELAY)
+    monkeypatch.setattr(RD, "queue_places", lambda: {("s/x", A)})
+    fails, _, counts = RD.check()
+    assert any(name in f and "INVISIBLE WORK" in f for f in fails) and counts["QUEUE"] == 0
+    monkeypatch.setattr(RD, "queue_places", lambda: {("s/x", A), ("s/x", B)})
+    fails, _, counts = RD.check()
+    assert not any(name in f for f in fails) and counts["QUEUE"] == 1
+    monkeypatch.setattr(RD, "_read_tracked", lambda n: "a status, no card")
+    assert any(name in f for f in RD.check()[0])
+
+
+def test_harvest_debt_counts_a_card_registered_by_the_queue_or_a_row_and_ages_the_rest():
+    cards = {A: 3, B: 30, "relays/claims/CLAIM_2026-11-28_c.md": 1}
+    rows = [{"text": "agy-002 | CLAIM_2026-11-28_c.md | a card read by main"}]
+    q, r, u = HD.card_receipts(cards, "s/x", {("s/x", A), ("s/y", B)}, rows)
+    assert q == [A] and r == ["relays/claims/CLAIM_2026-11-28_c.md"] and u == [B]
+    on_head = {A, B}
+    shown = {"r1.md": RELAY, "r2.md": "a status, no card", "r3.md": "one card: `%s`" % A}
+    got = HD.relays_answered(sorted(shown), shown.get, on_head, {("s/x", A)}, "s/x")
+    assert got == ["r3.md"]
+    assert HD.relays_answered(sorted(shown), shown.get, on_head, {("s/x", A), ("s/x", B)}, "s/x") == ["r1.md", "r3.md"]
+    assert HD.relay_debt.CARD_PATH_RE.fullmatch(A) and not HD.relay_debt.CARD_PATH_RE.fullmatch("relays/claims/peer/PEER_Q1.json")
+
+
+def test_the_live_run_reads_cards_and_relays_through_the_queue():
