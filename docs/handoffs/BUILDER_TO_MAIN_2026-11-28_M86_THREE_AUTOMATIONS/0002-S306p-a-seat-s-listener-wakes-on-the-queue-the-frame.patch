+QUEUE_BRANCH = "queue"
+RETURNED = ("RETURNED_AT_INTAKE", "RETURNED")
+
+
+def queue_asks(cards, log_entries, code, banking):
+    """{key: line}: what the queue asks of the seat whose code is `code` (main's M86 point 2). `cards` is {id: record} of the
+    queue's branch, `log_entries` its sighting log, `banking` queue/BANKING_SEATS.json. A key names one event, so that each
+    is shown once: an offer, a card at banking, both seals in, a status of one of the seat's own cards"""
+    asks = {}
+    roles = sorted(v for v, s in (banking or {}).items() if isinstance(s, dict) and s.get("code") == code)
+    for cid in sorted(cards):
+        rec = cards[cid]
+        hist = rec.get("history") or [{}]
+        last, status, n = hist[-1], rec.get("status"), len(hist)
+        note = str(last.get("note") or "")
+        if status == "OFFERED" and code in note:
+            asks["offered:%s:%d" % (cid, n)] = "%s OFFERED to you (%s): your peer note is asked; the card is %s on %s" % (
+                cid, note, rec.get("card_path"), rec.get("branch"))
+        if status == "AT_BANKING" and roles:
+            asks["banking:%s" % cid] = "%s AT_BANKING, you are %s: your expectation and seal are asked, before you read the card's " \
+                                       "decisive lines (K1)" % (cid, " and ".join(roles))
+            seal = "SEAL_%s.txt" % cid
+            branches = {s["branch"] for s in banking.values() if isinstance(s, dict) and s.get("branch")}
+            sealed = {e.get("branch") for e in log_entries if e.get("what") == "seal" and str(e.get("path", "")).endswith("/" + seal)}
+            if len(branches) == 2 and branches <= sealed:
+                asks["seals:%s" % cid] = "%s at banking: both banking seats' seals are sighted: your verdict may now be pushed " \
+                                         "(it is refused if it was sighted before both seals were in, K1)" % cid
+        if rec.get("seat_code") == code and n > 1:
+            word = "RETURNED, with its reasons" if status in RETURNED else "now %s" % status
+            asks["own:%s:%d" % (cid, n)] = "%s (your card %s) is %s: %s" % (cid, rec.get("card_path"), word, note)
+    return asks
+
+
+def look_queue(seat, cwd, remote, peek):
+    """(status, text, remember) for the queue's part: 0 and what is newly asked, 3 and nothing, 2 and why it could not look"""
+    rc, codes_text, _ = git("show", "%s/main:queue/SEAT_CODES.json" % remote, cwd=cwd)
+    try:
+        code = (json.loads(codes_text).get("seats") or {}).get(seat) if rc == 0 else None
+    except ValueError:
+        return 2, "main's queue/SEAT_CODES.json cannot be read", None
+    if not code:
+        return 3, "", None                              # a seat the table does not name hears its page alone
+    rc, _, err = git("fetch", "--quiet", remote, "+refs/heads/%s:refs/remotes/%s/%s" % (QUEUE_BRANCH, remote, QUEUE_BRANCH), cwd=cwd)
+    if rc != 0:
+        if "couldn't find remote ref" in err:
+            return 3, "", None                          # no queue's branch on this remote
+        return 2, "the fetch of the queue's branch failed" + (": " + err.splitlines()[-1] if err else ""), None
+    ref = "%s/%s" % (remote, QUEUE_BRANCH)
+    rc, names, err = git("ls-tree", "--name-only", "%s:queue/cards" % ref, cwd=cwd)
+    cards = {}
+    for name in (names.split() if rc == 0 else []):
+        if name.endswith(".json"):
+            rc2, text, _ = git("show", "%s:queue/cards/%s" % (ref, name), cwd=cwd)
+            try:
+                cards[name[:-5]] = json.loads(text) if rc2 == 0 else None
+            except ValueError:
+                cards[name[:-5]] = None
+            if cards[name[:-5]] is None:
+                return 2, "the queue's card %s cannot be read" % name, None
+    rc, log, _ = git("show", "%s:queue/SIGHTINGS.jsonl" % ref, cwd=cwd)
+    entries = []
+    for line in (log.splitlines() if rc == 0 else []):
+        try:
+            entries.append(json.loads(line))
+        except ValueError:
+            pass
+    rc, bk, _ = git("show", "%s/main:queue/BANKING_SEATS.json" % remote, cwd=cwd)
+    try:
+        banking = json.loads(bk) if rc == 0 else {}
+    except ValueError:
+        banking = {}
+    asks = queue_asks(cards, entries, code, banking)
+    mem = memory(cwd)
+    state_file = mem / ("%s.queue.json" % seat)
+    state, why = recall(state_file, {"shown": []})
+    if state is None:
+        return 2, why, None
+    shown = state.get("shown")
+    if not isinstance(shown, list):
+        return 2, "the listener's memory cannot be read (%s): what it holds as shown is not a list" % state_file, None
+    new = [k for k in sorted(asks) if k not in shown]
+    if not new:
+        return 3, "", None
+    rc, head, _ = git("rev-parse", "--short=9", ref, cwd=cwd)
+    text = "THE QUEUE ASKS SOMETHING OF YOU (%s, your code %s, the queue's branch at %s):\n" % (seat, code, head) + \
+        "\n".join("  " + asks[k] for k in new)
+    remembered = json.dumps({"shown": sorted(set(shown) | set(asks))})
+    return 0, text, (None if peek else (lambda: state_file.write_text(remembered, encoding="utf-8")))
+
+
+def look_seat_and_queue(seat, cwd, remote, peek):
+    """the page and the queue together: 0 when either has something new, with both texts and both memories"""
+    s1, t1, r1 = look_seat(seat, cwd, remote, peek)
+    if s1 == 2:
+        return s1, t1, r1
+    s2, t2, r2 = look_queue(seat, cwd, remote, peek)
+    if s2 == 2:
+        return s2, t2, None
+    if s1 == 3 and s2 == 3:
+        return 3, "", None
+    text = "\n\n".join(x for x in (t1 if s1 == 0 else "", t2 if s2 == 0 else "") if x)
+    both = [r for r in (r1 if s1 == 0 else None, r2 if s2 == 0 else None) if r]
+    return 0, text, ((lambda: [r() for r in both]) if both else None)
+
