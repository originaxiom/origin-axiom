+"""2026-11-28 (main's M86 point 2, the author's order that no chore waits on main): a seat's listener wakes on the queue.
+
+What could fail: a seat not told that a card is offered to it, that a card it banks is at banking, that both seals are in
+(its verdict may be pushed), or that one of its own cards moved or was returned; a seat told twice of the same thing, or
+of another seat's offer; a listener that forgets the page while it reads the queue; a --peek that remembers."""
+import importlib.util
+import json
+import pathlib
+import subprocess
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+LISTEN = ROOT / "scripts" / "seats" / "listen.py"
+spec = importlib.util.spec_from_file_location("listen_for_the_queue_tests", LISTEN)
+L = importlib.util.module_from_spec(spec)
+sys.dont_write_bytecode = True
+spec.loader.exec_module(L)
+
+ME, OTHER, V2 = "fam2-v1-unset-01", "fam3-v1-high-03", "fam1-v1-unset-05"
+BANKING = {"note": "", "V1": {"code": ME, "branch": "x/banking"}, "V2": {"code": V2, "branch": "y/banking"}}
+
+
+def _git(repo, *a):
+    r = subprocess.run(["git", "-C", str(repo), "-c", "user.name=t", "-c", "user.email=t@example.invalid", *a],
+                       capture_output=True, text=True)
+    assert r.returncode == 0, r.stderr
+    return r.stdout.strip()
+
+
+def _card(cid, status, code, notes):
+    hist = [{"at": "2026-11-28T12:00:00Z", "status": s, "by": "runner", "note": n} for s, n in notes]
+    return {"id": cid, "status": status, "seat_code": code, "branch": "s/a", "card_path": "relays/claims/CLAIM_%s.md" % cid,
+            "history": hist}
+
+
+def _write_queue(origin, cards, log=()):
+    _git(origin, "checkout", "-q", "queue")
+    (origin / "queue" / "cards").mkdir(parents=True, exist_ok=True)
+    for f in (origin / "queue" / "cards").glob("*.json"):
+        f.unlink()
+    for cid, rec in cards.items():
+        (origin / "queue" / "cards" / ("%s.json" % cid)).write_text(json.dumps(rec), encoding="utf-8")
+    (origin / "queue" / "SIGHTINGS.jsonl").write_text("".join(json.dumps(e) + "\n" for e in log), encoding="utf-8")
+    _git(origin, "add", "-A")
+    _git(origin, "commit", "-q", "--allow-empty", "-m", "a round")
+    _git(origin, "checkout", "-q", "main")
+
+
+def _setup(tmp_path, seats=None):
+    origin = tmp_path / "origin"
+    (origin / "docs" / "seats").mkdir(parents=True)
+    (origin / "queue").mkdir()
+    (origin / "docs" / "seats" / "x.md").write_text("# x\n\n## Messages from main\n\n### M1 — a day — hello\n\nthe text\n",
+                                                   encoding="utf-8")
+    (origin / "queue" / "SEAT_CODES.json").write_text(json.dumps(
+        {"_about": "", "codes": {"s/a": ME}, "seats": {"x": ME} if seats is None else seats}), encoding="utf-8")
+    (origin / "queue" / "BANKING_SEATS.json").write_text(json.dumps(BANKING), encoding="utf-8")
+    _git(origin, "init", "-q", "-b", "main")
+    _git(origin, "add", "-A")
+    _git(origin, "commit", "-q", "-m", "main")
+    _git(origin, "checkout", "-q", "--orphan", "queue")
+    _git(origin, "rm", "-q", "-r", "--cached", ".")
+    for p in ("docs", "queue"):
+        subprocess.run(["rm", "-r", str(origin / p)], check=True)
+    _git(origin, "commit", "-q", "--allow-empty", "-m", "the queue's branch")
+    _git(origin, "checkout", "-q", "-f", "main")
+    clone = tmp_path / "clone"
+    subprocess.run(["git", "clone", "-q", "file://" + str(origin), str(clone)], check=True, capture_output=True)
+    return origin, clone
+
+
+def _listen(clone, *args):
+    return subprocess.run([sys.executable, str(LISTEN), "--once", "--repo", str(clone), "--seat", "x", *args],
+                          capture_output=True, text=True, timeout=120)
+
+
+def test_an_offer_wakes_the_seat_once_and_another_seats_offer_does_not(tmp_path):
+    origin, clone = _setup(tmp_path)
+    assert _listen(clone).returncode == 0 and _listen(clone).returncode == 3          # the page, read once
+    _write_queue(origin, {"Q0001": _card("Q0001", "OFFERED", OTHER, [("FILED", ""), ("REPRODUCED", ""),
+                                         ("OFFERED", "offered to `%s` on audit/x (queue/OFFERS.json)" % ME)]),
+                          "Q0002": _card("Q0002", "OFFERED", OTHER, [("FILED", ""), ("REPRODUCED", ""),
+                                         ("OFFERED", "offered to `%s` on agy/x (queue/OFFERS.json)" % V2)])})
+    r = _listen(clone, "--peek")
+    assert r.returncode == 0 and "Q0001 OFFERED to you" in r.stdout and "your peer note is asked" in r.stdout
+    assert "Q0002" not in r.stdout and "YOUR PAGE" not in r.stdout                    # the page has not changed
+    assert _listen(clone).returncode == 0                                              # --peek remembered nothing
+    assert _listen(clone).returncode == 3 and _listen(clone).stdout == ""             # shown once
+
+
+def test_banking_asks_the_seal_then_the_verdict_once_both_seals_are_in(tmp_path):
+    origin, clone = _setup(tmp_path)
+    _listen(clone)
+    card = _card("Q0003", "AT_BANKING", OTHER, [("FILED", ""), ("PEERED", ""), ("AT_BANKING", "to banking after the peer's note")])
+    _write_queue(origin, {"Q0003": card})
+    r = _listen(clone)
+    assert r.returncode == 0 and "Q0003 AT_BANKING, you are V1: your expectation and seal are asked" in r.stdout
+    assert "verdict may now be pushed" not in r.stdout
+    seal = lambda b: {"at": "2026-11-28T13:00:00Z", "branch": b, "path": "relays/claims/banking/SEAL_Q0003.txt", "what": "seal"}
+    _write_queue(origin, {"Q0003": card}, [seal("x/banking")])                        # one seal: nothing new
+    assert _listen(clone).returncode == 3
+    _write_queue(origin, {"Q0003": card}, [seal("x/banking"), seal("y/banking")])
+    r = _listen(clone)
+    assert r.returncode == 0 and "Q0003 at banking: both banking seats' seals are sighted: your verdict may now be pushed" in r.stdout
+    assert "your expectation and seal are asked" not in r.stdout                       # not said twice
+    assert _listen(clone).returncode == 3
+
+
+def test_the_seats_own_card_moving_or_returned_wakes_it_with_the_reasons(tmp_path):
+    origin, clone = _setup(tmp_path)
+    _listen(clone)
