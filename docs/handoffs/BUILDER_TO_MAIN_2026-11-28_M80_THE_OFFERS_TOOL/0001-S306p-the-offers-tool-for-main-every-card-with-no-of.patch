@@ -0,0 +1,84 @@
+"""2026-11-28 (the framework's thin path; register row P-885; main's M80): the offers' tool, scripts/queue/offers.py.
+
+On a root and a queue folder built here: the REPRODUCED cards with no offer are listed, and each gets a draft offer by one
+rule, a fixed rotation over the seats that are neither main nor a banking seat and that the runner reads, skipping a peer
+of the card's own family. Cards offered already, or not REPRODUCED, are left out; a card with no peer of another family
+is listed with no draft. Every drafted offer passes the runner's own check, and the drafted file reads as offers."""
+import importlib.util
+import json
+import pathlib
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+spec = importlib.util.spec_from_file_location("offers_tool_under_test", ROOT / "scripts" / "queue" / "offers.py")
+O = importlib.util.module_from_spec(spec)
+sys.dont_write_bytecode = True
+spec.loader.exec_module(O)
+
+MAIN = O.QS.MAIN_CODE
+CODES = {"main": MAIN, "seat/bank1": "fam1-v1-unset-04", "seat/a": "fam2-v5-high-01", "seat/y": "fam2-v1-unset-01",
+         "seat/x": "fam3-v1-high-01", "seat/x2": "fam3-v1-high-01", "seat/w": "fam4-v1-high-01", "seat/z": "fam5-v1-high-01"}
+READ = {"main", "seat/bank1", "seat/a", "seat/y", "seat/x", "seat/x2", "seat/w"}        # seat/z: not in the Pins table
+
+
+def _rec(cid, status, code, branch, path):
+    return {"id": cid, "status": status, "seat_code": code, "branch": branch, "card_path": path, "history": []}
+
+
+def _cards():
+    return {"Q0001": _rec("Q0001", "REPRODUCED", "fam2-v5-high-01", "seat/a", "relays/claims/CLAIM_one.md"),
+            "Q0002": _rec("Q0002", "REPRODUCED", "fam3-v1-high-01", "seat/x", "relays/claims/CLAIM_two.md"),
+            "Q0003": _rec("Q0003", "OFFERED", "fam2-v5-high-01", "seat/a", "relays/claims/CLAIM_three.md"),
+            "Q0004": _rec("Q0004", "REPRODUCED", "fam2-v5-high-01", "seat/a", "relays/claims/CLAIM_four.md"),
+            "Q0005": _rec("Q0005", "FILED", "fam2-v5-high-01", "seat/a", "relays/claims/CLAIM_five.md")}
+
+
+def test_the_peers_are_the_seats_neither_main_nor_banking_that_the_runner_reads():
+    peers = O.peers(CODES, {"V1": {"code": "fam1-v1-unset-04", "branch": "seat/bank1"}}, READ)
+    assert peers == [("fam2-v1-unset-01", "seat/y"), ("fam2-v5-high-01", "seat/a"), ("fam3-v1-high-01", "seat/x"),
+                     ("fam4-v1-high-01", "seat/w")], peers                  # one a seat, on its first branch read
+
+
+def test_each_reproduced_card_with_no_offer_gets_a_draft_by_one_rule_m80():
+    peers = O.peers(CODES, {"V1": {"code": "fam1-v1-unset-04", "branch": "seat/bank1"}}, READ)
+    offered = {("seat/a", "relays/claims/CLAIM_four.md"): {"code": "fam3-v1-high-01", "branch": "seat/x"}}
+    unoffered, drafts, new = O.draft(_cards(), offered, peers, CODES)
+    assert [u["id"] for u in unoffered] == ["Q0001", "Q0002"]             # offered, OFFERED and FILED cards left out
+    # Q0001 starts at peer 1 mod 4 = seat/a, its own family: then seat/x. Q0002 starts at peer 2 = seat/x, its own: seat/w
+    assert [d["peer"] for d in drafts] == [{"code": "fam3-v1-high-01", "branch": "seat/x"},
+                                            {"code": "fam4-v1-high-01", "branch": "seat/w"}], drafts
+    for d in drafts:
+        assert not O.IN.offer_problems(_cards()[d["card"]], d["peer"], CODES)
+    assert len(new) == 2 and new[0] == {"branch": "seat/a", "path": "relays/claims/CLAIM_one.md",
+                                        "peer": {"code": "fam3-v1-high-01", "branch": "seat/x"}}
+    # the same cards give the same drafts: the rule, not a choice
+    assert O.draft(_cards(), offered, peers, CODES) == (unoffered, drafts, new)
+
+
+def test_a_card_with_no_peer_of_another_family_is_listed_with_no_draft():
+    unoffered, drafts, new = O.draft(_cards(), {}, [("fam2-v1-unset-01", "seat/y")], CODES)
+    assert drafts[0] == {"card": "Q0001", "peer": None, "why": "no peer of another family is read by the runner"}
+    assert drafts[1]["peer"] == {"code": "fam2-v1-unset-01", "branch": "seat/y"} and drafts[2]["peer"] is None
+    assert len(new) == 1 and new[0]["path"] == "relays/claims/CLAIM_two.md"
+
+
+def test_the_command_by_hand_prints_a_draft_the_runner_reads(tmp_path, capsys):
+    root = tmp_path / "root"
+    (root / "queue").mkdir(parents=True)
+    (root / "docs").mkdir()
+    (root / "queue" / "SEAT_CODES.json").write_text(json.dumps({"codes": CODES}))
+    (root / "queue" / "BANKING_SEATS.json").write_text(json.dumps({"V1": {"code": "fam1-v1-unset-04", "branch": "seat/bank1"}}))
+    (root / "queue" / "OFFERS.json").write_text(json.dumps({"note": "n", "offers": []}))
+    (root / "docs" / "HARVEST_LEDGER.md").write_text("# H\n\n## Pins\n\n| seat | branch | pin |\n|---|---|---|\n" + "".join(
+        "| s%d | `origin/%s` | `abcdef%d` |\n" % (i, b, i) for i, b in enumerate(sorted(READ - {"main"}))))
+    q = tmp_path / "q"
+    (q / "cards").mkdir(parents=True)
+    for cid, rec in _cards().items():
+        (q / "cards" / ("%s.json" % cid)).write_text(json.dumps(rec))
+    assert O.main(["--queue-dir", str(q)], root=root) == 0
+    out = capsys.readouterr().out
+    assert "3 REPRODUCED card(s) with no offer:" in out and "Q0001  fam2-v5-high-01  seat/a" in out, out
+    d = json.loads(out.split("the draft of queue/OFFERS.json:\n", 1)[1])
+    (tmp_path / "draft.json").write_text(json.dumps(d))
+    offers, bad = O.IN.read_offers(tmp_path / "draft.json")
+    assert bad == [] and len(offers) == 3
