                 break
             report.append("%s: the peer note on %s is refused: %s" % (cid, ref, "; ".join(res["reasons"])))
+    # T9: to banking. A deciding card goes once its peer's note holds, or when no note has held 72 hours after the offer
+    old_checks = {}
