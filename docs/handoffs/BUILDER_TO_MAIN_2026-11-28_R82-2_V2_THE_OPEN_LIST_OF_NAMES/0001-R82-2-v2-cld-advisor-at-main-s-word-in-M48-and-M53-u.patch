+"""R82-2 (Review 82's item; register row P-881; main's rule of M41 and M48): from B1814 on, a verdict line names no seat
+other than main. The gate `claim-names-no-session`; each planted line stands with its twin. CHANGED 2026-11-28 (main's M53):
+the list of names is open, in scripts/gates/SEAT_NAMES.json; the gate is probed with synonyms, with a name added to the list
+alone, and with the list gone."""
+import json, os, sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts" / "gates"))
+import gates
+
+
+def _reader(lines):
+    """the gate reads only the planted verdict files"""
+    mapping = {"frontier/B%d_planted/arc_verdict.json" % n: json.dumps({"id": "B%d" % n, "verdict": "PROVED", "claim_one_line": c})
+               for n, c in lines.items()}
+    return mapping, (lambda rel: mapping[rel.replace(os.sep, "/")])
+
+
+def _run(monkeypatch, lines):
+    mapping, rd = _reader(lines)
+    monkeypatch.setattr(gates.glob, "glob", lambda pat: [os.path.join(gates.ROOT, k) for k in mapping])
+    return gates.gate_claim_names_no_session(reader=rd)
+
+
+def test_a_line_that_names_a_seat_fails_and_its_twin_passes(monkeypatch):
+    """the control: a verdict line that credits the web seat by name; its twin says a seat, the credit in cites_seat"""
+    ok, msg = _run(monkeypatch, {99990: "THE RESULT (the web seat's sealed card, verified on main). 0 of 19."})
+    assert not ok and "B99990" in msg and "the web seat" in msg
+    assert _run(monkeypatch, {99990: "THE RESULT (a seat's sealed card, verified on main). 0 of 19."})[0]
+
+
+def test_each_kind_of_name_is_read_and_what_is_not_a_name_is_left(monkeypatch):
+    for line in ("proved by agy-exp", "agy-002's reduction", "THE AGY LANES DIGESTED", "the SM seat's finding", "the advisor seat's audit",
+                 "BUILT BY THE ADVISOR SEAT", "the building session's patch", "codex's run", "the audit lane's report",
+                 "eleven go to the builder of the gates"):
+        assert not _run(monkeypatch, {99991: line})[0], line
+    for line in ("main's own code; sm:B1516 and W29 cited", "the owner's 'verify all the work from agy' was read", "on branch agy/audit-2026-11-02",
+                 "a weave result resting on a thread refused by the builder; the map's builder refuses it",
+                 "main's check of a seat's card in harvest row 1755"):
+        assert _run(monkeypatch, {99992: line})[0], line
+
+
+def test_the_lanes_a_closed_list_missed_and_their_synonyms_are_read_m53(monkeypatch):
+    """main's M53: the physical lane, the explore seat and the independent audit lane, missed by the closed list, and the
+    synonyms of each name; each with its twin, which names a seat or a lane"""
+    for line in ("the physical lane's E8 algebra", "THE PHYSICAL LANE'S TWO SEALED PACKETS", "the physical seat's packets",
+                 "the physical-bridge lane's source review", "the physical lanes", "the explore seat's two relays",
+                 "counterexamples of the explore seat", "the explore lane's test", "the explorer seat's test",
+                 "the independent audit lane's recomputation", "the independent lane typed", "the independent audit seat",
+                 "the audit lane's report", "the audit seat", "the web lane", "the agy family's work", "the agy branches",
+                 "the SM-derivation seat", "the advisor lane", "11 with the gates' builder", "the gates's builder",
+                 "the builder of the gates", "the builder of the enforcement package", "the enforcement package's builder",
+                 "the enforcement package's files to its builder."):
+        assert not _run(monkeypatch, {99993: line})[0], line
+    for line in ("another lane's E8 algebra", "A LANE'S TWO SEALED PACKETS", "a seat's two relays", "11 with a seat.",
+                 "an independent computation (harvest row 1754)", "read in full by an independent reader",
+                 "a physical level-5 Weil space", "whether that odd character is physical", "the audit's E3",
+                 "the programme's builder refuses it", "now enforced by its builder", "a seat not being independent"):
+        assert _run(monkeypatch, {99994: line})[0], line
+
+
+def test_the_list_is_open_a_new_seat_is_one_line_of_it_m53(monkeypatch, tmp_path):
+    """a seat added to SEAT_NAMES.json is read without an edit of the gate; with the list gone the gate fails, closed"""
+    line = {99995: "the lighthouse seat's card, verified on main"}
+    assert _run(monkeypatch, line)[0]
+    names = json.load(open(gates.SEAT_NAMES, encoding="utf-8"))
+    more = tmp_path / "SEAT_NAMES.json"
+    more.write_text(json.dumps(dict(names, seat_words=names["seat_words"] + ["lighthouse"])), encoding="utf-8")
+    monkeypatch.setattr(gates, "SEAT_NAMES", str(more))
+    ok, msg = _run(monkeypatch, line)
+    assert not ok and "the lighthouse seat" in msg
+    more.write_text(json.dumps(dict(names, names=names["names"] + ["lighthouse-\\d+"])), encoding="utf-8")
+    assert not _run(monkeypatch, {99996: "lighthouse-7's card"})[0]
+    monkeypatch.setattr(gates, "SEAT_NAMES", str(tmp_path / "gone.json"))
+    ok, msg = _run(monkeypatch, {99997: "a seat's card"})
+    assert not ok and "cannot be read" in msg
+
+
+def test_the_rule_binds_from_b1814(monkeypatch):
+    assert _run(monkeypatch, {1813: "the web seat's result"})[0]
+    assert not _run(monkeypatch, {1814: "the web seat's result"})[0]
+
+
+def test_on_the_record_the_gate_passes_and_is_registered():
+    ok, msg = gates.gate_claim_names_no_session()
+    assert ok, msg
+    reg = json.load(open(ROOT / "tests" / "GATE_CONTROLS.json", encoding="utf-8"))
+    assert reg["claim-names-no-session"].endswith("::test_a_line_that_names_a_seat_fails_and_its_twin_passes")
