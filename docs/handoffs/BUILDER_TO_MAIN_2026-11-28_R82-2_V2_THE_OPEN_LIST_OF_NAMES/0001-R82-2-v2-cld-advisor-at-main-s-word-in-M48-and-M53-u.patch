+# on; the 71 lines that broke it were re-worded on 2026-11-26, each with a dated note naming the commit that holds it.
+CLAIM_NAMES_NO_SESSION_FROM = 1814
+# CHANGED 2026-11-28 (main's M53): the list of names is open. It stands in SEAT_NAMES.json beside this file, and every word
+# of a lane's name is read with lane, seat, family and branches, so a synonym is read too (the physical lane and the
+# explore seat were missed by a closed list, and "the gates' builder" passed for "the builder of the gates").
+SEAT_NAMES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "SEAT_NAMES.json")
+
+
+def claim_name_pattern(names=None):
+    """the pattern of every name of a seat other than main, from SEAT_NAMES.json (or the given dict)"""
+    if names is None:
+        with open(SEAT_NAMES, encoding="utf-8") as fh:
+            names = json.load(fh)
+    words = sorted(names.get("seat_words", []), key=len, reverse=True)
+    lanes = r"the (?:%s) (?:lanes?|seats?|famil(?:y|ies)|branch(?:es)?)" % "|".join(re.escape(w) for w in words)
+    alts = list(names.get("names", [])) + ([lanes] if words else []) + list(names.get("builder", []))
+    return re.compile(r"(?<![\w:/-])(" + "|".join(alts) + r")('s)?(?![\w/-])", re.I)
+
+
+_CN_SCRIPT = re.compile(r"(map|programme|plan|lock|table|page|gate|script)'s builder|by its builder|its builder (refuses|writes|reports)", re.I)
+_CN_QUOTED = re.compile(r"(?<![\w])'[^'\n]{2,240}?'(?![\w])|\u201c[^\u201d]{2,240}\u201d|\"[^\"]{2,240}\"")
+
+
+def claim_session_names(claim, pattern=None):
+    """the seats other than main that a verdict line names (main's rule of M41)"""
+    quotes = [(q.start(), q.end()) for q in _CN_QUOTED.finditer(claim)]
+    out = []
+    for m in (pattern or claim_name_pattern()).finditer(claim):
+        if any(a < m.start() < b for a, b in quotes):
+            continue
+        if m.group(1).lower() == "its builder":
+            ctx = claim[max(0, m.start() - 40):m.end() + 25]
+            if _CN_SCRIPT.search(ctx) or not re.search(r"gates|enforcement package", ctx):
+                continue
+        out.append(m.group(0))
+    return out
+
+
+def gate_claim_names_no_session(reader=None):
+    """R82-2: from B1814 on, a verdict line names no seat other than main; the credit stands in cites_seat"""
+    reader = reader or (lambda rel: _read(rel))
+    try:
+        pattern = claim_name_pattern()
+    except Exception as exc:                              # FAIL-CLOSED: no list of names, no pass
+        return False, "the list of names %s cannot be read: %s" % (os.path.relpath(SEAT_NAMES, ROOT), exc)
+    bad = []
+    for p in sorted(glob.glob(os.path.join(ROOT, "frontier", "B*", "arc_verdict.json"))):
+        try:
+            d = json.loads(reader(os.path.relpath(p, ROOT)))
+        except Exception:
+            continue
+        n = int(re.sub(r"\D", "", str(d.get("id") or "")) or 0)
+        if n < CLAIM_NAMES_NO_SESSION_FROM:
+            continue
+        found = claim_session_names(str(d.get("claim_one_line") or ""), pattern)
+        if found:
+            bad.append("%s names %s" % (d.get("id"), ", ".join(sorted(set(found)))[:80]))
+    if bad:
+        return False, "%d verdict line(s) from B%d on name a seat other than main (move the credit to cites_seat): " % (
+            len(bad), CLAIM_NAMES_NO_SESSION_FROM) + "; ".join(bad[:5])
+    return True, "ok (no verdict line from B%d on names a seat other than main)" % CLAIM_NAMES_NO_SESSION_FROM
 
 
