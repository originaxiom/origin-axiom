           +1*q^2 +2*q^3 +3*q^4 +3*q^5 -8*q^7 -21*q^8 -37*q^9 -54*q^10 -63*q^11 -54*q^12 -18*q^13 +58*q^14 +184*q^15
           attained on m003 at [(-2, 1), (-1, -1), (1, 1), (2, -1)]
      e.g. m003(-4, 3) (leading x^6; only 39 classes of m004 can compete, all checked):
           -1*q^3 -1*q^4 -1*q^5 -1*q^6 +1*q^7 +3*q^8 +7*q^9 +13*q^10 +20*q^11 +27*q^12 +34*q^13 +37*q^14 +32*q^15
           attained on m003 at [(-4, 3), (-1, -3), (1, 3), (4, -3)]
