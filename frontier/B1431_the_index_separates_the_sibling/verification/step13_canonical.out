--- A in saturated coordinates: (c,d)_m003 -> (a,b)_m004 = (-c-d, -d)
    m003 class (c,d) means (c/2)mu3 + d lam3 ;  m004 class (a,b) means a mu4 + (b/2) lam4
    m004's homological longitude lam4 = (a,b)=(0,2)  <-- m003's (c,d)=(2, -2)  = 1*mu3 + -2*lam3
    m003's homological longitude lam3 = (c,d)=(0,1)  --> m004's (a,b)=(-1, -1)  = -1*mu4 + -1/2*lam4

--- THE CANONICALLY MARKED COMPARISON: the index on the homological longitude ---
  I_m004(lambda_hom) = +1*q^3 +2*q^4 +5*q^5 +2*q^6 -3*q^7 -16*q^8 -32*q^9 -52*q^10 -67*q^11 -64*q^12 -39*q^13 +32*q^14 +145*q^15 +322*q^16 +531*q^17 +782*q^18 +997*q^19 +1154*q^20
